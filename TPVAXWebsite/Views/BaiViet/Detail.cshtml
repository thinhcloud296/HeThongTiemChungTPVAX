                    class="text-muted article-meta-small"
                    style="font-size: 11px"
                    >[Người lớn]</span
                  >
                </a>
              </div>
            </section>
          </div>
        </div>
      </div>

      <hr class="my-5 d-lg-none" />
      <section class="related-articles d-lg-none">
        <h3 class="mb-4 text-primary fw-bold">Bài viết liên quan</h3>
        <div class="row g-4">
          <div class="col-md-4">
