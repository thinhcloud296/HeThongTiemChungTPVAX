@{
    ViewBag.Title = "Xác nhận liên kết hồ sơ tiêm chủng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Phát hiện hồ sơ tiêm chủng có sẵn
                    </h5>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        </div>
                    }
                    
                    <div class="alert alert-info">
                        <p class="mb-2">
                            <strong>Hệ thống đã tìm thấy hồ sơ tiêm chủng với CCCD của bạn:</strong>
                        </p>
                        <ul class="mb-0">
                            <li><strong>Họ tên:</strong> @ViewBag.HoTen</li>
                            <li><strong>Ngày sinh:</strong> @ViewBag.NgaySinh</li>
                        </ul>
                    </div>

                    <div class="alert alert-secondary">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Hồ sơ này có thể đã được người thân của bạn tạo trước đó.</strong>
                        <p class="mb-0 mt-2 small">
                            Nếu đây là hồ sơ của bạn, hãy xác nhận để liên kết với tài khoản mới. 
                            Bạn cần bổ sung thêm số điện thoại và email để hoàn tất đăng ký.
                        </p>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-success btn-lg w-100" data-bs-toggle="modal" data-bs-target="#modalNhapThongTin">
                            <i class="bi bi-check-circle me-2"></i>Xác nhận - Tạo tài khoản và liên kết hồ sơ này
                        </button>
                        
                        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-2"></i>Không phải hồ sơ của tôi - Quay lại
                        </a>
                    </div>

                    <p class="text-muted small mt-3 text-center">
                        <i class="bi bi-shield-check me-1"></i>
                        Sau khi xác nhận, bạn có thể đăng nhập bằng số điện thoại/email và mật khẩu đã đăng ký.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal nhập thông tin bổ sung -->
<div class="modal fade" id="modalNhapThongTin" tabindex="-1" aria-labelledby="modalNhapThongTinLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalNhapThongTinLabel">
                    <i class="bi bi-person-plus me-2"></i>Bổ sung thông tin liên hệ
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("HoanTatDangKyVoiLienKet", "Account")" id="formBoSungThongTin">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info py-2">
                        <small>
                            <i class="bi bi-info-circle me-1"></i>
                            Vui lòng nhập số điện thoại và email để hoàn tất đăng ký tài khoản.
                        </small>
                    </div>
                    
                    <div class="mb-3">
                        <label for="SoDT" class="form-label">
                            <i class="bi bi-telephone me-1"></i>Số điện thoại <span class="text-danger">*</span>
                        </label>
                        <input type="tel" class="form-control" id="SoDT" name="SoDT" 
                               placeholder="Nhập số điện thoại (VD: 0912345678)" 
                               pattern="0[0-9]{9}" maxlength="10" required>
                        <div class="invalid-feedback">Số điện thoại không hợp lệ (10 số, bắt đầu bằng 0)</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Email" class="form-label">
                            <i class="bi bi-envelope me-1"></i>Email
                        </label>
                        <input type="email" class="form-control" id="Email" name="Email" 
                               placeholder="Nhập địa chỉ email (không bắt buộc)">
                        <div class="invalid-feedback">Email không hợp lệ</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Hoàn tất đăng ký
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('formBoSungThongTin').addEventListener('submit', function(e) {
            var soDT = document.getElementById('SoDT');
            var email = document.getElementById('Email');
            var isValid = true;
            
            // Validate SĐT
            var phonePattern = /^0[0-9]{9}$/;
            if (!phonePattern.test(soDT.value)) {
                soDT.classList.add('is-invalid');
                isValid = false;
            } else {
                soDT.classList.remove('is-invalid');
                soDT.classList.add('is-valid');
            }
            
            // Validate Email (nếu có nhập)
            if (email.value.trim() !== '') {
                var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailPattern.test(email.value)) {
                    email.classList.add('is-invalid');
                    isValid = false;
                } else {
                    email.classList.remove('is-invalid');
                    email.classList.add('is-valid');
                }
            }
            
            if (!isValid) {
                e.preventDefault();
            }
        });
        
        // Real-time validation
        document.getElementById('SoDT').addEventListener('input', function() {
            var phonePattern = /^0[0-9]{9}$/;
            if (phonePattern.test(this.value)) {
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
            } else {
                this.classList.remove('is-valid');
            }
        });
        
        document.getElementById('Email').addEventListener('input', function() {
            if (this.value.trim() === '') {
                this.classList.remove('is-invalid', 'is-valid');
                return;
            }
            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (emailPattern.test(this.value)) {
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
            } else {
                this.classList.remove('is-valid');
            }
        });
    </script>
}
