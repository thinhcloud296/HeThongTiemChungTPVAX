@{
    ViewBag.Title = "Bảng điều khiển";
    var totalVaccines = ViewBag.TotalVaccines ?? 0;
    var appointmentsToday = ViewBag.AppointmentsToday ?? 0;
    var totalCustomers = ViewBag.TotalCustomers ?? 0;
    var monthlyRevenue = ViewBag.MonthlyRevenue ?? 0M;
    var lowStockVaccines = ViewBag.LowStockVaccines ?? new List<dynamic>();
    var upcomingAppointments = ViewBag.UpcomingAppointments ?? new List<dynamic>();
    var revenueByMonth = ViewBag.RevenueByMonth ?? new List<dynamic>();
    
    // Format doanh thu
    string revenueDisplay = monthlyRevenue >= 1000000000 
        ? string.Format("{0:0.##}B", monthlyRevenue / 1000000000)
        : monthlyRevenue >= 1000000
            ? string.Format("{0:0.##}M", monthlyRevenue / 1000000)
            : string.Format("{0:0.##}K", monthlyRevenue / 1000);
}


        <div class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1 class="m-0">Bảng điều khiển</h1>
              </div>
            </div>
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Lỗi:</strong> @ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
          </div>
        </div>
        <div class="content">
          <div class="container-fluid">
            <div class="row">
              <div class="col-12 col-sm-6 col-md-3">
                <div class="small-box bg-primary">
                  <div class="inner">
                    <h3>@totalVaccines</h3>
                    <p>Loại Vắc xin</p>
                  </div>
                  <div class="icon"><i class="fas fa-pills"></i></div>
                  <a href="@Url.Action("Vaccines", "Admin")" class="small-box-footer"
                    >Xem chi tiết <i class="fas fa-arrow-circle-right"></i
                  ></a>
                </div>
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <div class="small-box bg-success">
                  <div class="inner">
                    <h3>@appointmentsToday</h3>
                    <p>Lịch tiêm hôm nay</p>
                  </div>
                  <div class="icon"><i class="fas fa-calendar-check"></i></div>
                  <a href="@Url.Action("Appointments", "Admin")" class="small-box-footer"
                    >Xem chi tiết <i class="fas fa-arrow-circle-right"></i
                  ></a>
                </div>
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <div class="small-box bg-warning">
                  <div class="inner">
                    <h3>@totalCustomers</h3>
                    <p>Khách hàng</p>
                  </div>
                  <div class="icon"><i class="fas fa-user-plus"></i></div>
                  <a href="@Url.Action("Customers", "Admin")" class="small-box-footer"
                    >Xem chi tiết <i class="fas fa-arrow-circle-right"></i
                  ></a>
                </div>
              </div>
              <div class="col-12 col-sm-6 col-md-3">
                <div class="small-box bg-info">
                  <div class="inner">
                    <h3>@revenueDisplay</h3>
                    <p>Doanh thu tháng</p>
                  </div>
                  <div class="icon"><i class="fas fa-dollar-sign"></i></div>
                  <a href="@Url.Action("Reports", "Admin")" class="small-box-footer"
                    >Xem chi tiết <i class="fas fa-arrow-circle-right"></i
                  ></a>
                </div>
              </div>
            </div>
            <div class="row">
              <section class="col-lg-7 connectedSortable">
                <div class="card card-primary card-outline">
                  <div class="card-header">
                    <h3 class="card-title">
                      <i class="fas fa-chart-line me-1"></i>Báo cáo Doanh thu 6
                      tháng gần nhất
                    </h3>
                  </div>
                  <div class="card-body">
                    <canvas
                      id="revenueChart"
                      style="
                        min-height: 250px;
                        height: 250px;
                        max-height: 250px;
                        max-width: 100%;
                      "
                    ></canvas>
                  </div>
                </div>
              </section>
              <section class="col-lg-5 connectedSortable">
                <div class="card card-warning card-outline">
                  <div class="card-header">
                    <h3 class="card-title">
                      <i class="fas fa-exclamation-triangle mr-1"></i>Vắc xin
                      sắp hết hàng
                    </h3>
                  </div>
                  <div class="card-body p-0">
                    @if (lowStockVaccines != null && ((IEnumerable<TPVAXWebsite.Models.Domain.Vaccine>)lowStockVaccines).Any())
                    {
                        <ul class="products-list product-list-in-card ps-2 pe-2">
                            @foreach (TPVAXWebsite.Models.Domain.Vaccine vaccine in lowStockVaccines)
                            {
                                var badgeClass = vaccine.SoLuong == 0 ? "bg-danger" : vaccine.SoLuong < 50 ? "bg-danger" : "bg-warning";
                                var statusText = vaccine.SoLuong == 0 ? "Hết hàng" : "Còn " + vaccine.SoLuong;
                                <li class="item">
                                    <div class="product-info ml-2">
                                        @vaccine.TenVC<span class="badge @badgeClass float-right">@statusText</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted">
                            <i class="fas fa-check-circle fa-2x mb-2"></i>
                            <p>Tất cả vaccine đều đủ hàng</p>
                        </div>
                    }
                  </div>
                  <div class="card-footer text-center">
                    <a href="@Url.Action("Vaccines", "Admin")" class="uppercase">Xem tất cả vaccine</a>
                  </div>
                </div>
                <div class="card card-info card-outline">
                  <div class="card-header">
                    <h3 class="card-title">
                      <i class="far fa-calendar-alt me-1"></i>Lịch tiêm gần đây
                    </h3>
                  </div>
                  <div class="card-body p-0">
                    @if (upcomingAppointments != null && ((IEnumerable<TPVAXWebsite.Models.Domain.LichTiem>)upcomingAppointments).Any())
                    {
                        <ul class="products-list product-list-in-card ps-2 pe-2">
                            @foreach (TPVAXWebsite.Models.Domain.LichTiem appointment in upcomingAppointments)
                            {
                                var appointmentDate = appointment.NgayHenTiem;
                                var isToday = appointmentDate.Date == DateTime.Today;
                                var timeDisplay = isToday 
                                    ? appointmentDate.ToString("HH:mm") + " - Hôm nay"
                                    : appointmentDate.ToString("dd/MM/yyyy HH:mm");
                                var tenNguoiTiem = appointment.HoSoTiemChung?.HoTen ?? "N/A";
                                
                                <li class="item">
                                    <div class="product-info ms-2">
                                        @tenNguoiTiem<span class="badge bg-info float-right">@timeDisplay</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted">
                            <i class="far fa-calendar-times fa-2x mb-2"></i>
                            <p>Chưa có lịch tiêm sắp tới</p>
                        </div>
                    }
                  </div>
                  <div class="card-footer text-center">
                    <a href="@Url.Action("Appointments", "Admin")">Xem tất cả lịch tiêm</a>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>

@section scripts {
    <script>
        console.log('Dashboard loaded');
        console.log('Total Vaccines:', @totalVaccines);
        console.log('Total Customers:', @totalCustomers);
        console.log('Appointments Today:', @appointmentsToday);
        console.log('Monthly Revenue:', @monthlyRevenue);
        
        // Dữ liệu doanh thu 6 tháng
        var revenueData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RevenueByMonth ?? new List<object>()));
        console.log('Revenue Data:', revenueData);
        
        // Tạo nhãn và dữ liệu cho biểu đồ
        var labels = [];
        var data = [];
        
        // Tạo mảng 6 tháng gần nhất
        var currentDate = new Date();
        var months = [];
        for (var i = 5; i >= 0; i--) {
            var d = new Date(currentDate.getFullYear(), currentDate.getMonth() - i, 1);
            months.push({
                year: d.getFullYear(),
                month: d.getMonth() + 1,
                label: 'Tháng ' + (d.getMonth() + 1) + '/' + d.getFullYear()
            });
        }
        
        // Map dữ liệu từ server với 6 tháng
        months.forEach(function(m) {
            labels.push(m.label);
            var found = revenueData.find(function(r) {
                return r.Year === m.year && r.Month === m.month;
            });
            data.push(found ? found.TotalRevenue / 1000000 : 0); // Chuyển sang triệu
        });
        
        // Vẽ biểu đồ
        var ctx = document.getElementById('revenueChart').getContext('2d');
        var revenueChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (Triệu VNĐ)',
                    data: data,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                var label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                label += new Intl.NumberFormat('vi-VN').format(context.parsed.y) + ' triệu VNĐ';
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('vi-VN').format(value) + 'M';
                            }
                        }
                    }
                }
            }
        });
    </script>
}
