                    <i class="fas fa-plus"></i> Thêm nhà cung cấp
                  </button>
                </div>
              </div>
              <div class="card-body">
                <table
                  id="nhaCungCapTable"
                  class="table table-bordered table-striped"
                >
                  <thead>
                    <tr>
                      <th>Mã NCC</th>
                      <th>Tên công ty</th>
                      <th>Người liên hệ</th>
                      <th>Số điện thoại</th>
                      <th>Email</th>
                      <th>Địa chỉ</th>
