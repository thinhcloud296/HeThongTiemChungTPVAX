@model List<AdminNhaCungCapViewModel>

@{
    ViewBag.Title = "Quản lý Nhà cung cấp";
}

<section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1><i class="fas fa-truck mr-2"></i>Quản lý Nhà cung cấp</h1>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                  </li>
                  <li class="breadcrumb-item active">Nhà cung cấp</li>
                </ol>
              </div>
            </div>
          </div>
        </section>

        <section class="content">
          <div class="container-fluid">
            <!-- Statistics Cards -->
            <div class="row mb-4">
              <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                  <div class="inner">
                    <h3>12</h3>
                    <p>Tổng nhà cung cấp</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-building"></i>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                  <div class="inner">
                    <h3>9</h3>
                    <p>Đang hoạt động</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-check-circle"></i>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                  <div class="inner">
                    <h3>2</h3>
                    <p>Tạm ngưng</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-pause-circle"></i>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-6">
                <div class="small-box bg-primary">
                  <div class="inner">
                    <h3>456</h3>
                    <p>Tổng đơn nhập</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-shopping-cart"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- Main Content -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">
                  <i class="fas fa-list mr-2"></i>Danh sách Nhà cung cấp
                </h3>
                <div class="card-tools">
                  <button
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#nhaCungCapModal"
                    onclick="resetForm()"
                  >
                    <i class="fas fa-plus"></i> Thêm nhà cung cấp
                  </button>
                </div>
              </div>
              <div class="card-body">
                <table
                  id="nhaCungCapTable"
                  class="table table-bordered table-striped"
                >
                  <thead>
                    <tr>
                      <th>Mã NCC</th>
                      <th>Tên công ty</th>
                      <th>Người liên hệ</th>
                      <th>Số điện thoại</th>
                      <th>Email</th>
                      <th>Địa chỉ</th>
                      <th>Trạng thái</th>
                      <th style="width: 100px">Hành động</th>
                    </tr>
                  </thead>
                  <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var supplier in Model)
                        {
                            <tr>
                                <td>@supplier.MaNCC</td>
                                <td><strong>@supplier.TenNCC</strong></td>
                                <td>@supplier.TenNganHang</td>
                                <td>@supplier.SoDT</td>
                                <td>@supplier.Email</td>
                                <td>@supplier.DiaChi</td>
                                <td><span class="badge bg-success">Hoạt động</span></td>
                                <td>
                                    <button class="btn btn-primary btn-sm btn-edit" data-supplier-id="@supplier.MaNCC" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm btn-delete" data-supplier-id="@supplier.MaNCC" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">Không có dữ liệu nhà cung cấp</td>
                        </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>

      
    </div>

    <!-- Modal Thêm/Sửa Nhà cung cấp -->
    <div class="modal fade" id="nhaCungCapModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header bg-primary">
            <h5 class="modal-title" id="modalTitle">Thêm Nhà Cung Cấp Mới</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="nhaCungCapForm" class="needs-validation" novalidate>
              <input type="hidden" id="nccId" />
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label"
                    >Mã nhà cung cấp <span class="text-danger">*</span></label
                  >
                  <input
                    type="text"
                    id="maNCC"
                    class="form-control"
                    placeholder="VD: NCC001"
                    required
                  />
                  <div class="invalid-feedback">
                    Vui lòng nhập mã nhà cung cấp.
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label"
                    >Tên công ty <span class="text-danger">*</span></label
                  >
                  <input
                    type="text"
                    id="tenCongTy"
                    class="form-control"
                    placeholder="VD: Pfizer Vietnam"
                    required
                  />
                  <div class="invalid-feedback">Vui lòng nhập tên công ty.</div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label"
                    >Người liên hệ <span class="text-danger">*</span></label
                  >
                  <input
                    type="text"
                    id="nguoiLienHe"
                    class="form-control"
                    placeholder="VD: Mr. John Smith"
                    required
                  />
                  <div class="invalid-feedback">
                    Vui lòng nhập người liên hệ.
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label"
                    >Số điện thoại <span class="text-danger">*</span></label
                  >
                  <input
                    type="tel"
                    id="soDienThoai"
                    class="form-control"
                    placeholder="VD: (028) 3827 8900"
                    required
                  />
                  <div class="invalid-feedback">
                    Vui lòng nhập số điện thoại.
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label"
                    >Email <span class="text-danger">*</span></label
                  >
                  <input
                    type="email"
                    id="email"
                    class="form-control"
                    placeholder="contact@company.com"
                    required
                  />
                  <div class="invalid-feedback">
                    Vui lòng nhập email hợp lệ.
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Website</label>
                  <input
                    type="url"
                    id="website"
                    class="form-control"
                    placeholder="https://www.company.com"
                  />
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label"
                  >Địa chỉ <span class="text-danger">*</span></label
                >
                <textarea
                  id="diaChi"
                  class="form-control"
                  rows="2"
                  placeholder="Nhập địa chỉ đầy đủ..."
                  required
                ></textarea>
                <div class="invalid-feedback">Vui lòng nhập địa chỉ.</div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Mã số thuế</label>
                  <input
                    type="text"
                    id="maSoThue"
                    class="form-control"
                    placeholder="VD: 0123456789"
                  />
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Trạng thái</label>
                  <select id="trangThai" class="form-select">
                    <option value="active">Hoạt động</option>
                    <option value="inactive">Tạm ngưng</option>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Ghi chú</label>
                <textarea
                  id="ghiChu"
                  class="form-control"
                  rows="3"
                  placeholder="Ghi chú về nhà cung cấp..."
                ></textarea>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Đóng
            </button>
            <button type="submit" form="nhaCungCapForm" class="btn btn-primary">
              Lưu thông tin
            </button>
          </div>
        </div>
      </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="assets/js/app.js"></script>

@section scripts {
<script>
      $(document).ready(function () {
        $("#nhaCungCapTable").DataTable({
          language: {
            url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json",
          },
        });

        // Form validation
        $("#nhaCungCapForm").on("submit", function (e) {
          e.preventDefault();
          if (this.checkValidity()) {
            Swal.fire({
              title: "Thành công!",
              text: "Đã lưu thông tin nhà cung cấp.",
              icon: "success",
              timer: 2000,
            });
            $("#nhaCungCapModal").modal("hide");
          }
          this.classList.add("was-validated");
        });

        // Delete handler
        $(document).on("click", ".btn-delete", function () {
          Swal.fire({
            title: "Xác nhận xóa?",
            text: "Bạn có chắc muốn xóa nhà cung cấp này?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Xóa",
            cancelButtonText: "Hủy",
          }).then((result) => {
            if (result.isConfirmed) {
              Swal.fire("Đã xóa!", "Nhà cung cấp đã được xóa.", "success");
            }
          });
        });
      });

      function resetForm() {
        document.getElementById("nhaCungCapForm").reset();
        document
          .getElementById("nhaCungCapForm")
          .classList.remove("was-validated");
        document.getElementById("modalTitle").innerText =
          "Thêm Nhà Cung Cấp Mới";
      }
    </script>
}