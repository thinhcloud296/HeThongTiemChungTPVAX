              </div>
            </div>
          </div>
        </section>
      </div>

      
    </div>

    <!-- Modal Thêm/Sửa Nhà cung cấp -->
    <div class="modal fade" id="nhaCungCapModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header bg-primary">
            <h5 class="modal-title" id="modalTitle">Thêm Nhà Cung Cấp Mới</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="nhaCungCapForm" class="needs-validation" novalidate>
              <input type="hidden" id="nccId" />
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label"
                    >Mã nhà cung cấp <span class="text-danger">*</span></label
                  >
                  <input
                    type="text"
                    id="maNCC"
                    class="form-control"
                    placeholder="VD: NCC001"
                    required
                  />
