@{
    ViewBag.Title = "Quản lý Nhà cung cấp";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-truck mr-2"></i>Quản lý Nhà cung cấp</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Admin")">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Nhà cung cấp</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <!-- Main Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Danh sách Nhà cung cấp</h3>
                <div class="card-tools">
                    <button class="btn btn-primary btn-sm" id="btnAddNCC">
                        <i class="fas fa-plus"></i> Thêm nhà cung cấp
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table id="nccTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10%">Mã NCC</th>
                            <th style="width: 20%">Tên công ty</th>
                            <th style="width: 20%">Địa chỉ</th>
                            <th style="width: 15%">Email</th>
                            <th style="width: 10%">Số điện thoại</th>
                            <th style="width: 15%">Ngân hàng</th>
                            <th style="width: 10%">Hành động</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Modal Thêm/Sửa Nhà cung cấp -->
<div class="modal fade" id="nccModal" tabindex="-1" role="dialog" aria-labelledby="nccModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="nccModalTitle">Thêm Nhà cung cấp Mới</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span class="text-white" aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="nccForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="nccId" name="MaNCC" />

                    <!-- Tên công ty -->
                    <div class="form-group">
                        <label for="tenNCC">Tên công ty <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="tenNCC" name="TenNCC" 
                            placeholder="VD: Pfizer Vietnam" required />
                        <small class="form-text text-muted">Tối đa 255 ký tự</small>
                    </div>

                    <!-- Địa chỉ -->
                    <div class="form-group">
                        <label for="diaChi">Địa chỉ</label>
                        <textarea class="form-control" id="diaChi" name="DiaChi" rows="2"
                            placeholder="VD: 123 Đường Nguyễn Văn Linh, Quận 1, TP.HCM"></textarea>
                        <small class="form-text text-muted">Tối đa 500 ký tự</small>
                    </div>

                    <!-- Row: Email và Số điện thoại -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" class="form-control" id="email" name="Email" 
                                    placeholder="VD: contact@pfizer.com" />
                                <small class="form-text text-muted">Tối đa 100 ký tự</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="soDT">Số điện thoại</label>
                                <input type="text" class="form-control" id="soDT" name="SoDT" 
                                    placeholder="VD: 0912345678" pattern="\d{10}" maxlength="10" />
                                <small class="form-text text-muted">10 chữ số</small>
                            </div>
                        </div>
                    </div>

                    <!-- Row: Tên ngân hàng và Số tài khoản -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="tenNganHang">Tên ngân hàng</label>
                                <input type="text" class="form-control" id="tenNganHang" name="TenNganHang" 
                                    placeholder="VD: Vietcombank" />
                                <small class="form-text text-muted">Tối đa 100 ký tự</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="soTK">Số tài khoản</label>
                                <input type="text" class="form-control" id="soTK" name="SoTK" 
                                    placeholder="VD: 0123456789" maxlength="30" />
                                <small class="form-text text-muted">Tối đa 30 ký tự</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-2"></i>Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        overflow-x: auto;
    }

    .modal-header {
        color: white;
    }

    .modal-header .close {
        color: white;
    }

    #nccTable thead th {
        background-color: #f8f9fa;
        font-weight: 600;
        text-align: left;
        padding: 12px 8px;
        border-bottom: 2px solid #dee2e6;
    }

    #nccTable tbody td {
        padding: 10px 8px;
        vertical-align: middle;
    }

    #nccTable tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-group-sm .btn {
        padding: 4px 8px;
        font-size: 0.875rem;
    }

    .form-group label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .form-group small {
        display: block;
        margin-top: 0.25rem;
        color: #6c757d;
    }

    .text-danger {
        color: #dc3545;
        font-weight: bold;
    }
</style>

@section Scripts {
<script>
    const BASE_URL = '@Url.Content("~")';
    let dataTable;

    $(document).ready(function () {
        console.log('NhaCungCap page loaded');

        // Initialize DataTable
        if ($.fn.dataTable.isDataTable('#nccTable')) {
            $('#nccTable').DataTable().destroy();
        }

        dataTable = $('#nccTable').DataTable({
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
            },
            columnDefs: [
                { targets: [0, 4, 6], className: 'text-center' }
            ],
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            pageLength: 10,
            order: [[1, 'asc']] // Sắp xếp theo tên công ty
        });

        // Load data
        loadNhaCungCapList();

        // Event handlers
        $('#btnAddNCC').on('click', onAddNCC);
        $(document).on('click', '.btn-edit', onEditNCC);
        $(document).on('click', '.btn-delete', onDeleteNCC);
        $('#nccForm').on('submit', onFormSubmit);
    });

    function loadNhaCungCapList() {
        console.log('Loading NhaCungCap list from: ' + BASE_URL + 'Admin/GetNhaCungCapList');

        $.ajax({
            url: BASE_URL + 'Admin/GetNhaCungCapList',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                console.log('✓ Response received:', response);

                if (response.success && response.data) {
                    dataTable.clear();
                    response.data.forEach(function (ncc) {
                        const bankInfo = ncc.TenNganHang && ncc.SoTK 
                            ? ncc.TenNganHang + '<br><small class="text-muted">' + ncc.SoTK + '</small>'
                            : (ncc.TenNganHang || ncc.SoTK || '-');

                        dataTable.row.add([
                            ncc.MaNCC,
                            ncc.TenNCC,
                            ncc.DiaChi || '-',
                            ncc.Email || '-',
                            ncc.SoDT || '-',
                            bankInfo,
                            `<div class="btn-group btn-group-sm">
                                <button class="btn btn-info btn-edit" title="Sửa" data-id="${ncc.MaNCC}">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-danger btn-delete" title="Xóa" data-id="${ncc.MaNCC}">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>`
                        ]).draw(false);
                    });
                    console.log('✓ Table populated with ' + response.data.length + ' items');
                } else {
                    console.warn('⚠ Response success is false or data is empty');
                    Swal.fire('Thông báo', 'Không có dữ liệu nhà cung cấp', 'info');
                }
            },
            error: function (xhr, status, error) {
                console.error('✗ AJAX Error:', status, error);
                console.error('Response:', xhr.responseText);
                Swal.fire('Lỗi', 'Không thể tải danh sách nhà cung cấp. Vui lòng thử lại!', 'error');
            }
        });
    }

    function onAddNCC(e) {
        e.preventDefault();
        console.log('Add NhaCungCap clicked');
        $('#nccModalTitle').text('Thêm Nhà cung cấp Mới');
        $('#nccId').val('');
        $('#nccForm')[0].reset();
        $('#nccModal').modal('show');
    }

    function onEditNCC(e) {
        e.preventDefault();
        e.stopPropagation();
        const id = $(this).data('id');
        console.log('Edit NhaCungCap clicked, ID:', id);

        $.ajax({
            url: BASE_URL + 'Admin/GetNhaCungCap',
            type: 'GET',
            data: { id: id },
            dataType: 'json',
            success: function (response) {
                console.log('✓ Edit data received:', response);
                if (response.success) {
                    $('#nccModalTitle').text('Sửa Nhà cung cấp');
                    const data = response.data;
                    $('#nccId').val(data.MaNCC);
                    $('#tenNCC').val(data.TenNCC);
                    $('#diaChi').val(data.DiaChi || '');
                    $('#email').val(data.Email || '');
                    $('#soDT').val(data.SoDT || '');
                    $('#tenNganHang').val(data.TenNganHang || '');
                    $('#soTK').val(data.SoTK || '');
                    $('#nccModal').modal('show');
                } else {
                    Swal.fire('Lỗi', response.message || 'Không thể tải dữ liệu', 'error');
                }
            },
            error: function (xhr, status, error) {
                console.error('✗ Edit AJAX Error:', status, error);
                Swal.fire('Lỗi', 'Không thể tải dữ liệu nhà cung cấp', 'error');
            }
        });
    }

    function onDeleteNCC(e) {
        e.preventDefault();
        e.stopPropagation();
        const id = $(this).data('id');
        console.log('Delete NhaCungCap clicked, ID:', id);

        Swal.fire({
            title: 'Xác nhận xóa',
            text: 'Bạn chắc chắn muốn xóa nhà cung cấp này?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                const token = $('input[name="__RequestVerificationToken"]').val();
                
                $.ajax({
                    url: BASE_URL + 'Admin/DeleteNhaCungCap',
                    type: 'POST',
                    data: { 
                        id: id,
                        __RequestVerificationToken: token
                    },
                    dataType: 'json',
                    success: function (response) {
                        console.log('✓ Delete response:', response);
                        if (response.success) {
                            Swal.fire('Thành công', response.message, 'success').then(() => {
                                loadNhaCungCapList();
                            });
                        } else {
                            Swal.fire('Lỗi', response.message, 'error');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('✗ Delete AJAX Error:', status, error);
                        Swal.fire('Lỗi', 'Lỗi hệ thống khi xóa', 'error');
                    }
                });
            }
        });
    }

    function onFormSubmit(e) {
        e.preventDefault();
        console.log('Form submitted');

        // Validate form
        const tenNCC = $('#tenNCC').val().trim();
        if (!tenNCC) {
            Swal.fire('Lỗi', 'Vui lòng nhập tên công ty', 'error');
            return;
        }

        const nccId = $('#nccId').val();
        const url = nccId
            ? BASE_URL + 'Admin/EditNhaCungCap'
            : BASE_URL + 'Admin/CreateNhaCungCap';

        const formData = new FormData(this);
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        if (csrfToken) {
            formData.append('__RequestVerificationToken', csrfToken);
        }

        console.log('Submitting to:', url);
        console.log('MaNCC:', nccId);
        console.log('TenNCC:', tenNCC);

        $.ajax({
            url: url,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log('✓ Submit response:', response);
                if (response.success) {
                    Swal.fire('Thành công', response.message, 'success').then(() => {
                        $('#nccModal').modal('hide');
                        loadNhaCungCapList();
                    });
                } else {
                    let errorMessage = response.message || 'Có lỗi xảy ra';
                    if (response.errors) {
                        errorMessage += '<br><ul>';
                        for (let key in response.errors) {
                            errorMessage += '<li>' + response.errors[key] + '</li>';
                        }
                        errorMessage += '</ul>';
                    }
                    Swal.fire({
                        title: 'Lỗi',
                        html: errorMessage,
                        icon: 'error'
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error('✗ Submit AJAX Error:', status, error);
                console.error('Response:', xhr.responseText);
                Swal.fire('Lỗi', 'Lỗi hệ thống: ' + error, 'error');
            }
        });
    }
</script>
}
