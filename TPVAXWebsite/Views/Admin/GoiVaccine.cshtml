@model List<AdminGoiVaccineViewModel>

@{
    ViewBag.Title = "Quản lý Gói Vắc xin";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-box-open mr-2"></i>Quản lý Gói Vắc xin</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                    </li>
                    <li class="breadcrumb-item active">Gói Vắc xin</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>15</h3>
                        <p>Tổng gói vắc xin</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>8</h3>
                        <p>Gói trẻ em</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-baby"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>5</h3>
                        <p>Gói người lớn</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>256</h3>
                        <p>Gói đã bán</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-list mr-2"></i>Danh sách Gói Vắc xin
                </h3>
                <div class="card-tools">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#goiVaccineModal" onclick="resetForm()">
                        <i class="fas fa-plus"></i> Tạo gói mới
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var package in Model)
                        {
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 shadow-sm package-card">
                                    <div class="card-header bg-gradient-primary text-white">
                                        <h5 class="mb-0">
                                            <i class="fas fa-box-open mr-2"></i>@package.TenGoi
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <span class="badge bg-info">@package.MaGoi</span>
                                            <span class="badge @(package.TrangThai == "1" ? "bg-success" : "bg-warning") float-end">
                                                @(package.TrangThai == "1" ? "Đang bán" : "Tạm dừng")
                                            </span>
                                        </div>
                                        <p class="text-muted mb-3">@package.MoTa</p>

                                        <h6>
                                            <i class="fas fa-syringe mr-2 text-primary"></i>Đối tượng áp dụng:
                                        </h6>
                                        <p class="mb-3">@package.DoiTuongApDung</p>

                                        <div class="price-box bg-light p-3 rounded mb-3">
                                            <div class="d-flex justify-content-between">
                                                <span><strong>Giá:</strong></span>
                                                <span class="text-danger"><strong>@package.GiaGoi.ToString("N0") VNĐ</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer">
                                        <button class="btn btn-primary btn-sm btn-edit" data-package-id="@package.MaGoi">
                                            <i class="fas fa-edit"></i> Sửa
                                        </button>
                                        <button class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </button>
                                        <button class="btn btn-danger btn-sm btn-delete float-end" data-package-id="@package.MaGoi">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-info text-center">Không có gói vắc xin nào</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Tạo/Sửa Gói Vắc xin -->
<div class="modal fade" id="goiVaccineModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Tạo Gói Vắc xin Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="goiVaccineForm" class="needs-validation" novalidate>
                    <input type="hidden" id="goiId" />

                    <h5 class="mb-3">
                        <i class="fas fa-info-circle mr-2"></i>Thông tin gói
                    </h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Mã gói <span class="text-danger">*</span></label>
                            <input type="text" id="maGoi" class="form-control" placeholder="VD: GOI001" required />
                            <div class="invalid-feedback">Vui lòng nhập mã gói.</div>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Tên gói <span class="text-danger">*</span></label>
                            <input type="text" id="tenGoi" class="form-control" placeholder="VD: Gói Tiêm Chủng Trẻ Em Cơ Bản" required />
                            <div class="invalid-feedback">Vui lòng nhập tên gói.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả <span class="text-danger">*</span></label>
                        <textarea id="moTa" class="form-control" rows="2" placeholder="Mô tả chi tiết về gói vắc xin..." required></textarea>
                        <div class="invalid-feedback">Vui lòng nhập mô tả.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Đối tượng áp dụng</label>
                            <select id="doiTuong" class="form-select">
                                <option value="Trẻ em">Trẻ em</option>
                                <option value="Người lớn">Người lớn</option>
                                <option value="Gia đình">Gia đình</option>
                                <option value="Tất cả">Tất cả</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Độ tuổi áp dụng</label>
                            <input type="text" id="doTuoi" class="form-control" placeholder="VD: 0-12 tháng" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Thời gian thực hiện</label>
                            <input type="text" id="thoiGian" class="form-control" placeholder="VD: 12 tháng" />
                        </div>
                    </div>

                    <h5 class="mt-4 mb-3">
                        <i class="fas fa-syringe mr-2"></i>Vắc xin trong gói
                    </h5>
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Tên vắc xin</th>
                                <th>Số mũi tiêm</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th>
                                    <button type="button" class="btn btn-success btn-sm" id="addVaccineRow">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="vaccineTableBody">
                            <tr>
                                <td>
                                    <select class="form-select vaccine-select" required>
                                        <option value="">Chọn vắc xin</option>
                                        <option value="1">Vắc xin 6 trong 1</option>
                                        <option value="2">Vắc xin Cúm Tứ Giá</option>
                                        <option value="3">Prevenar 13</option>
                                        <option value="4">Rotavirus</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" class="form-control quantity" min="1" value="1" required />
                                </td>
                                <td>
                                    <input type="number" class="form-control price" min="0" value="850000" required />
                                </td>
                                <td>
                                    <input type="text" class="form-control total" value="850,000" readonly />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm remove-row">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="3" class="text-end"><strong>Tổng giá gốc:</strong></td>
                                <td colspan="2"><strong id="tongGiaGoc">850,000 VNĐ</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    <h5 class="mt-4 mb-3">
                        <i class="fas fa-dollar-sign mr-2"></i>Giá bán
                    </h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Giá gốc (VNĐ)</label>
                            <input type="number" id="giaGoc" class="form-control" value="850000" readonly />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Giảm giá (%)</label>
                            <input type="number" id="giamGia" class="form-control" min="0" max="100" value="15" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Giá bán (VNĐ)</label>
                            <input type="number" id="giaBan" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Trạng thái</label>
                            <select id="trangThai" class="form-select">
                                <option value="active">Đang bán</option>
                                <option value="inactive">Ngừng bán</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Màu hiển thị</label>
                            <select id="mauHienThi" class="form-select">
                                <option value="primary">Xanh dương</option>
                                <option value="success">Xanh lá</option>
                                <option value="warning">Vàng cam</option>
                                <option value="info">Xanh nhạt</option>
                                <option value="danger">Đỏ</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" form="goiVaccineForm" class="btn btn-primary">Lưu gói vắc xin</button>
            </div>
        </div>
    </div>
</div>

@section styles {
<style>
    .package-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .package-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 119, 182, 0.2) !important;
    }
    .price-box {
        border-left: 4px solid var(--tpvax-primary, #0077b6);
    }
</style>
}

@section scripts {
<script>
    // Add vaccine row
    document.getElementById('addVaccineRow').addEventListener('click', function() {
        const tbody = document.getElementById('vaccineTableBody');
        const newRow = tbody.rows[0].cloneNode(true);
        tbody.appendChild(newRow);
    });

    // Remove vaccine row
    document.addEventListener('click', function(e) {
        if (e.target.closest('.remove-row')) {
            const tbody = document.getElementById('vaccineTableBody');
            if (tbody.rows.length > 1) {
                e.target.closest('tr').remove();
            } else {
                Swal.fire('Lỗi', 'Phải có ít nhất một vắc xin trong gói!', 'error');
            }
        }
    });

    // Calculate discount price
    document.getElementById('giamGia').addEventListener('input', function() {
        const giaGoc = parseFloat(document.getElementById('giaGoc').value) || 0;
        const giamGia = parseFloat(this.value) || 0;
        const giaBan = giaGoc - (giaGoc * giamGia / 100);
        document.getElementById('giaBan').value = Math.round(giaBan);
    });

    // Form validation
    document.getElementById('goiVaccineForm').addEventListener('submit', function(e) {
        e.preventDefault();
        if (this.checkValidity()) {
            Swal.fire({
                title: 'Thành công!',
                text: 'Đã lưu thông tin gói vắc xin.',
                icon: 'success',
                timer: 2000
            });
            bootstrap.Modal.getInstance(document.getElementById('goiVaccineModal')).hide();
        }
        this.classList.add('was-validated');
    });

    // Delete handler
    $(document).on('click', '.btn-delete', function() {
        Swal.fire({
            title: 'Xác nhận xóa?',
            text: 'Bạn có chắc muốn xóa gói vắc xin này?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire('Đã xóa!', 'Gói vắc xin đã được xóa.', 'success');
            }
        });
    });

    function resetForm() {
        document.getElementById('goiVaccineForm').reset();
        document.getElementById('goiVaccineForm').classList.remove('was-validated');
        document.getElementById('modalTitle').innerText = 'Tạo Gói Vắc xin Mới';
    }

    // Initialize
    $(document).ready(function() {
        // Calculate initial discount price
        $('#giamGia').trigger('input');
    });
</script>
}
