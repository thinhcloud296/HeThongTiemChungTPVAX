@model List<AdminAppointmentViewModel>

@{
    ViewBag.Title = "Quản lý Lịch tiêm";
}


        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Quản lý Lịch tiêm</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                  </li>
                  <li class="breadcrumb-item active">Quản lý Lịch tiêm</li>
                </ol>
              </div>
            </div>
          </div>
        </section>

        <section class="content">
          <div class="container-fluid">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Danh sách lịch tiêm</h3>
              </div>
              <div class="card-body">
                <table
                  id="appointmentsTable"
                  class="table table-bordered table-striped"
                >
                  <thead>
                    <tr>
                      <th>Mã lịch hẹn</th>
                      <th>Tên khách hàng</th>
                      <th>Ngày tiêm</th>
                      <th>Giờ tiêm</th>
                      <th>Loại vắc xin</th>
                      <th>Trạng thái</th>
                      <th>Hành động</th>
                    </tr>
                  </thead>
                  <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var appointment in Model)
                        {
                            <tr>
                              <td>@appointment.MaLT</td>
                              <td>@appointment.TenNguoiTiem</td>
                              <td>@appointment.NgayHenTiem.ToString("dd/MM/yyyy")</td>
                              <td>@appointment.NgayHenTiem.ToString("HH:mm")</td>
                              <td>@appointment.TenVaccine</td>
                              <td>
                                @{
                                    var badgeClass = "bg-info";
                                    var statusText = appointment.TrangThai ?? "Chưa xác định";

if (appointment.TrangThai == "Đã tiêm")
{
    badgeClass = "bg-success";
}
else if (appointment.TrangThai == "Đã hủy")
{
    badgeClass = "bg-danger";
}
else if (appointment.TrangThai == "Sắp tới")
{
    badgeClass = "bg-warning";
}
                                }
                                <span class="badge @badgeClass">@statusText</span>
                              </td>
                              <td>
                                <button class="btn btn-primary btn-sm">Chi tiết</button>
                              </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                          <td colspan="7" class="text-center text-muted">Không có dữ liệu lịch tiêm</td>
                        </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>

      
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="assets/js/app.js"></script>
  