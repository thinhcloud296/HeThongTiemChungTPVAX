@model List<TPVAXWebsite.Models.ViewModels.AdminAppointmentViewModel>

@{
    ViewBag.Title = "Quản lý Lịch tiêm";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : 0;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 10;
    string search = ViewBag.Search != null ? ViewBag.Search.ToString() : "";
    string status = ViewBag.Status != null ? ViewBag.Status.ToString() : "";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>Quản lý Lịch tiêm</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                    </li>
                    <li class="breadcrumb-item active">Quản lý Lịch tiêm</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Danh sách lịch tiêm</h3>
            </div>
            <div class="card-body">
                <!-- Bộ lọc và tìm kiếm -->
                <form method="get" action="@Url.Action("Appointments", "Admin")" class="mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="input-group">
                                <input type="text" name="search" class="form-control" placeholder="Tìm theo tên, mã lịch, vaccine..." value="@search" />
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Tìm
                                </button>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="status" class="form-control" onchange="this.form.submit()">
                                <option value="">-- Tất cả trạng thái --</option>
                                <option value="Đã đặt" @(status.Equals("Đã đặt") ? "selected" : "")>Đã đặt</option>
                                <option value="Chưa tiêm" @(status.Equals("Chưa tiêm") ? "selected" : "")>Chưa tiêm</option>
                                <option value="Đã tiêm" @(status.Equals("Đã tiêm") ? "selected" : "")>Đã tiêm</option>
                                <option value="Đã hủy" @(status.Equals("Đã hủy") ? "selected" : "")>Đã hủy</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="pageSize" class="form-control" onchange="this.form.submit()">
                                <option value="10" @(pageSize.Equals(10) ? "selected" : "")>10 / trang</option>
                                <option value="20" @(pageSize.Equals(20) ? "selected" : "")>20 / trang</option>
                                <option value="50" @(pageSize.Equals(50) ? "selected" : "")>50 / trang</option>
                            </select>
                        </div>
                        <div class="col-md-3 text-right">
                            <span class="text-muted">Tổng: <strong>@totalItems</strong> lịch tiêm</span>
                        </div>
                    </div>
                </form>

                <table id="appointmentsTable" class="table table-bordered table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>Mã lịch hẹn</th>
                            <th>Tên khách hàng</th>
                            <th>Ngày tiêm</th>
                            <th>Giờ tiêm</th>
                            <th>Loại vắc xin</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var appointment in Model)
                            {
                                <tr>
                                    <td>@appointment.MaLT</td>
                                    <td>@appointment.TenNguoiTiem</td>
                                    <td>@appointment.NgayHenTiem.ToString("dd/MM/yyyy")</td>
                                    <td>@appointment.NgayHenTiem.ToString("HH:mm")</td>
                                    <td>@appointment.TenVaccine</td>
                                    <td>
                                        @{
                                            var badgeClass = "bg-info";
                                            var statusText = appointment.TrangThai ?? "Chưa xác định";

                                            if (appointment.TrangThai == "Đã tiêm")
                                            {
                                                badgeClass = "bg-success";
                                            }
                                            else if (appointment.TrangThai == "Đã hủy")
                                            {
                                                badgeClass = "bg-danger";
                                            }
                                            else if (appointment.TrangThai == "Chưa tiêm" || appointment.TrangThai == "Đã đặt")
                                            {
                                                badgeClass = "bg-warning";
                                            }
                                        }
                                        <span class="badge @badgeClass">@statusText</span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-info btn-sm" onclick="showDetails('@appointment.MaLT')">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">Không có dữ liệu lịch tiêm</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Phân trang -->
                @if (totalPages > 1)
                {
                    var prevPage = currentPage - 1;
                    var nextPage = currentPage + 1;
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);
                    
                    <nav aria-label="Page navigation" class="mt-3">
                        <ul class="pagination justify-content-center">
                            @* Nút Previous *@
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Appointments", "Admin", new { page = prevPage, pageSize = pageSize, search = search, status = status })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            @* Các số trang *@
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Appointments", "Admin", new { page = 1, pageSize = pageSize, search = search, status = status })">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Appointments", "Admin", new { page = i, pageSize = pageSize, search = search, status = status })">@i</a>
                                </li>
                            }

                            @if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Appointments", "Admin", new { page = totalPages, pageSize = pageSize, search = search, status = status })">@totalPages</a>
                                </li>
                            }

                            @* Nút Next *@
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Appointments", "Admin", new { page = nextPage, pageSize = pageSize, search = search, status = status })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-center text-muted">
                        Trang @currentPage / @totalPages
                    </div>
                }
            </div>
        </div>
    </div>
</section>


<!-- Modal Chi tiết lịch tiêm -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="detailsModalLabel">
                    <i class="fas fa-calendar-check"></i> Chi tiết lịch tiêm
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="detailsContent">
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                        <p class="mt-2">Đang tải...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var appointmentDetailsUrl = '@Url.Action("AppointmentDetails", "Admin")';
    
    function showDetails(maLT) {
        // Hiển thị modal
        var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
        modal.show();

        // Reset content
        document.getElementById('detailsContent').innerHTML = `
            <div class="text-center py-4">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
                <p class="mt-2">Đang tải...</p>
            </div>
        `;

        // Gọi API lấy chi tiết
        var url = appointmentDetailsUrl + '?id=' + encodeURIComponent(maLT);
        console.log('Fetching URL:', url);
        fetch(url)
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    throw new Error('HTTP error! status: ' + response.status);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    var d = data.data;
                    var statusClass = 'bg-info';
                    if (d.TrangThai === 'Đã tiêm') statusClass = 'bg-success';
                    else if (d.TrangThai === 'Đã hủy') statusClass = 'bg-danger';
                    else if (d.TrangThai === 'Chưa tiêm' || d.TrangThai === 'Đã đặt') statusClass = 'bg-warning';

                    document.getElementById('detailsContent').innerHTML = `
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Thông tin lịch tiêm</h6>
                                <table class="table table-sm table-borderless">
                                    <tr><td class="text-muted" width="40%">Mã lịch tiêm:</td><td><strong>${d.MaLT}</strong></td></tr>
                                    <tr><td class="text-muted">Ngày hẹn tiêm:</td><td>${d.NgayHenTiem}</td></tr>
                                    <tr><td class="text-muted">Ngày tiêm thực tế:</td><td>${d.NgayTiemThucTe}</td></tr>
                                    <tr><td class="text-muted">Số mũi:</td><td>${d.SoMui}</td></tr>
                                    <tr><td class="text-muted">Trạng thái:</td><td><span class="badge ${statusClass}">${d.TrangThai}</span></td></tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-primary"><i class="fas fa-user"></i> Thông tin người tiêm</h6>
                                <table class="table table-sm table-borderless">
                                    <tr><td class="text-muted" width="40%">Mã hồ sơ:</td><td>${d.MaHSTC}</td></tr>
                                    <tr><td class="text-muted">Họ tên:</td><td><strong>${d.TenNguoiTiem}</strong></td></tr>
                                    <tr><td class="text-muted">Ngày sinh:</td><td>${d.NgaySinh}</td></tr>
                                    <tr><td class="text-muted">Giới tính:</td><td>${d.GioiTinh}</td></tr>
                                </table>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-primary"><i class="fas fa-syringe"></i> Thông tin vaccine</h6>
                                <table class="table table-sm table-borderless">
                                    <tr><td class="text-muted" width="40%">Mã vaccine:</td><td>${d.MaVC}</td></tr>
                                    <tr><td class="text-muted">Tên vaccine:</td><td><strong>${d.TenVaccine}</strong></td></tr>
                                    <tr><td class="text-muted">Giá:</td><td>${new Intl.NumberFormat('vi-VN').format(d.GiaVaccine)}đ</td></tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-primary"><i class="fas fa-user-md"></i> Nhân viên phụ trách</h6>
                                <table class="table table-sm table-borderless">
                                    <tr><td class="text-muted" width="40%">Mã NV:</td><td>${d.MaNV || 'N/A'}</td></tr>
                                    <tr><td class="text-muted">Họ tên:</td><td>${d.TenNhanVien}</td></tr>
                                </table>
                            </div>
                        </div>
                        ${d.GhiChu ? `
                        <hr>
                        <div class="row">
                            <div class="col-12">
                                <h6 class="text-primary"><i class="fas fa-sticky-note"></i> Ghi chú</h6>
                                <p class="bg-light p-2 rounded">${d.GhiChu}</p>
                            </div>
                        </div>
                        ` : ''}
                    `;
                } else {
                    document.getElementById('detailsContent').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> ${data.message}
                        </div>
                    `;
                }
            })
            .catch(error => {
                document.getElementById('detailsContent').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i> Lỗi khi tải dữ liệu: ${error.message}
                    </div>
                `;
            });
    }
</script>
}
