@using TPVAXWebsite.Models.ViewModels
@model List<AdminVaccineViewModel>

@{
    ViewBag.Title = "Quản lý Vắc xin";
}


        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Quản lý Vắc xin</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                  </li>
                  <li class="breadcrumb-item active">Quản lý Vắc xin</li>
                </ol>
              </div>
            </div>
          </div>
        </section>

        <section class="content">
          <div class="container-fluid">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Danh sách Vắc xin</h3>
              </div>
              <div class="card-body">
                    <div class="d-flex justify-content-end mb-3">
                      <button
                        class="btn btn-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#vaccineModal"
                      >
                        <i class="fas fa-plus"></i> Thêm Vắc xin
                      </button>
                    </div>
                    <table
                      id="vaccineTable"
                      class="table table-bordered table-striped"
                    >
                      <thead>
                        <tr>
                          <th>ID</th>
                          <th>Tên Vắc xin</th>
                          <th>Phòng bệnh</th>
                          <th>Tồn kho</th>
                          <th>Giá (VNĐ)</th>
                          <th>Trạng thái</th>
                          <th style="width: 100px">Hành động</th>
                        </tr>
                      </thead>
                      <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var vaccine in Model)
                            {
                                <tr>
                                    <td>@vaccine.MaVC</td>
                                    <td>@vaccine.TenVC</td>
                                    <td>@vaccine.TenLoai</td>
                                    <td>@vaccine.SoLuongTon</td>
                                    <td>@vaccine.GiaBan.ToString("N0")</td>
                                    <td>
                                        @if (vaccine.SoLuongTon > 50)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else if (vaccine.SoLuongTon > 0)
                                        {
                                            <span class="badge bg-warning">Sắp hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-info btn-sm btn-edit" data-vaccine-id="@vaccine.MaVC">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm btn-delete" data-vaccine-id="@vaccine.MaVC">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">Không có dữ liệu vaccine</td>
                            </tr>
                        }
                      </tbody>
                    </table>
                  </div>
            </div>
          </div>
        </section>
      </div>
      
    </div>
    <div class="modal fade" id="vaccineModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header bg-primary">
            <h5 class="modal-title" id="modalTitle">Thêm Vắc Xin Mới</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="vaccineForm">
              <input type="hidden" id="vaccineId" />
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Tên Vắc xin</label
                  ><input
                    type="text"
                    id="vaccineName"
                    class="form-control"
                    required
                  />
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Nhà sản xuất</label
                  ><input
                    type="text"
                    id="vaccineManufacturer"
                    class="form-control"
                  />
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Phòng bệnh</label
                ><textarea
                  id="vaccineDisease"
                  class="form-control"
                  rows="2"
                ></textarea>
              </div>
              <div class="row">
                <div class="col-md-4 mb-3">
                  <label class="form-label">Số lượng</label
                  ><input
                    type="number"
                    id="vaccineQuantity"
                    class="form-control"
                    required
                  />
                </div>
                <div class="col-md-4 mb-3">
                  <label class="form-label">Giá bán (VNĐ)</label
                  ><input
                    type="number"
                    id="vaccinePrice"
                    class="form-control"
                    required
                  />
                </div>
                <div class="col-md-4 mb-3">
                  <label class="form-label">Trạng thái</label
                  ><select id="vaccineStatus" class="form-select">
                    <option value="1" selected>Đang hoạt động</option>
                    <option value="2">Sắp hết hàng</option>
                    <option value="0">Hết hàng</option>
                  </select>
                </div>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Đóng
            </button>
            <button type="submit" form="vaccineForm" class="btn btn-primary">
              Lưu thay đổi
            </button>
          </div>
        </div>
      </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="assets/js/app.js"></script>
  