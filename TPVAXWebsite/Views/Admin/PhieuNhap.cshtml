@model IEnumerable<TPVAXWebsite.Models.Domain.PhieuNhapVaccine>
@{
    ViewBag.Title = "Quản Lý Phiếu Nhập";
}

<section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1>
                  <i class="fas fa-file-import mr-2"></i>Quản lý Phiếu nhập
                </h1>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                  </li>
                  <li class="breadcrumb-item active">Phiếu nhập</li>
                </ol>
              </div>
            </div>
          </div>
        </section>

        <section class="content">
          <div class="container-fluid">
            <!-- Statistics Cards -->
            <div class="row mb-4">
              <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                  <div class="inner">
                    <h3>45</h3>
                    <p>Tổng phiếu nhập</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-file-alt"></i>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                  <div class="inner">
                    <h3>38</h3>
                    <p>Đã duyệt</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-check-circle"></i>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                  <div class="inner">
                    <h3>5</h3>
                    <p>Chờ duyệt</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-clock"></i>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-6">
                <div class="small-box bg-primary">
                  <div class="inner">
                    <h3>2.4 tỷ</h3>
                    <p>Tổng giá trị nhập</p>
                  </div>
                  <div class="icon">
                    <i class="fas fa-dollar-sign"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- Main Content -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">
                  <i class="fas fa-list mr-2"></i>Danh sách Phiếu nhập
                </h3>
                <div class="card-tools">
                  <button
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#phieuNhapModal"
                  >
                    <i class="fas fa-plus"></i> Tạo phiếu nhập
                  </button>
                </div>
              </div>
              <div class="card-body">
                <table
                  id="phieuNhapTable"
                  class="table table-bordered table-striped"
                >
                  <thead>
                    <tr>
                      <th>Mã phiếu</th>
                      <th>Ngày nhập</th>
                      <th>Nhà cung cấp</th>
                      <th>Tổng tiền</th>
                      <th>Người tạo</th>
                      <th>Trạng thái</th>
                      <th style="width: 120px">Hành động</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><a href="invoice-details.html">PN-2025-001</a></td>
                      <td>15/11/2025</td>
                      <td>Pfizer Vietnam</td>
                      <td>125,500,000 VNĐ</td>
                      <td>Nguyễn Văn An</td>
                      <td><span class="badge bg-success">Đã duyệt</span></td>
                      <td>
                        <button
                          class="btn btn-info btn-sm btn-view"
                          title="Xem chi tiết"
                        >
                          <i class="fas fa-eye"></i>
                        </button>
                        <button
                          class="btn btn-primary btn-sm btn-edit"
                          title="Sửa"
                        >
                          <i class="fas fa-edit"></i>
                        </button>
                        <button
                          class="btn btn-danger btn-sm btn-delete"
                          title="Xóa"
                        >
                          <i class="fas fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                    <tr>
                      <td><a href="invoice-details.html">PN-2025-002</a></td>
                      <td>16/11/2025</td>
                      <td>AstraZeneca Vietnam</td>
                      <td>85,300,000 VNĐ</td>
                      <td>Trần Thị Bình</td>
                      <td><span class="badge bg-warning">Chờ duyệt</span></td>
                      <td>
                        <button
                          class="btn btn-info btn-sm btn-view"
                          title="Xem chi tiết"
                        >
                          <i class="fas fa-eye"></i>
                        </button>
                        <button
                          class="btn btn-success btn-sm btn-approve"
                          title="Duyệt"
                        >
                          <i class="fas fa-check"></i>
                        </button>
                        <button
                          class="btn btn-danger btn-sm btn-reject"
                          title="Từ chối"
                        >
                          <i class="fas fa-times"></i>
                        </button>
                      </td>
                    </tr>
                    <tr>
                      <td><a href="invoice-details.html">PN-2025-003</a></td>
                      <td>17/11/2025</td>
                      <td>Moderna Inc.</td>
                      <td>245,000,000 VNĐ</td>
                      <td>Lê Văn Cường</td>
                      <td><span class="badge bg-success">Đã duyệt</span></td>
                      <td>
                        <button
                          class="btn btn-info btn-sm btn-view"
                          title="Xem chi tiết"
                        >
                          <i class="fas fa-eye"></i>
                        </button>
                        <button
                          class="btn btn-primary btn-sm btn-edit"
                          title="Sửa"
                        >
                          <i class="fas fa-edit"></i>
                        </button>
                        <button
                          class="btn btn-danger btn-sm btn-delete"
                          title="Xóa"
                        >
                          <i class="fas fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>
