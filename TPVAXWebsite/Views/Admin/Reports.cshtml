@{
    ViewBag.Title = "Báo cáo & Thống kê";
    var vaccineRevenue = ViewBag.VaccineRevenue ?? new List<dynamic>();
    var appointmentTrends = ViewBag.AppointmentTrends ?? new List<dynamic>();
}


        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Báo cáo & Thống kê</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Admin")">Trang chủ</a>
                  </li>
                  <li class="breadcrumb-item active">Báo cáo</li>
                </ol>
              </div>
            </div>
          </div>
        </section>

        <section class="content">
          <div class="container-fluid">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">
                  <i class="fas fa-filter mr-1"></i> Bộ lọc báo cáo
                </h3>
              </div>
              <div class="card-body">
                <div class="row align-items-end">
                  <div class="col-md-5">
                    <div class="form-group">
                      <label>Khoảng thời gian:</label>
                      <div class="input-group">
                        <button
                          type="button"
                          class="btn btn-default float-right"
                          id="daterange-btn"
                        >
                          <i class="far fa-calendar-alt"></i>
                          <span>Chọn ngày</span>
                          <i class="fas fa-caret-down"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-5">
                    <div class="form-group">
                      <label>Loại báo cáo:</label>
                      <select class="form-control">
                        <option>Báo cáo doanh thu</option>
                        <option>Báo cáo tồn kho</option>
                        <option>Báo cáo lượt tiêm</option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100">
                      Xem báo cáo
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Xu hướng tiêm chủng theo thời gian</h3>
              </div>
              <div class="card-body">
                <canvas
                  id="trendsChart"
                  style="
                    min-height: 250px;
                    height: 300px;
                    max-height: 350px;
                    width: 100%;
                  "
                ></canvas>
              </div>
            </div>

            <div class="card">
              <div class="card-header">
                <h3 class="card-title">
                  Báo cáo doanh thu chi tiết theo vắc xin
                </h3>
                <div class="card-tools">
                  <button id="exportExcelBtn" class="btn btn-success btn-sm">
                    <i class="fas fa-file-excel"></i> Export to Excel
                  </button>
                </div>
              </div>
              <div class="card-body">
                <table
                  id="reportsTable"
                  class="table table-bordered table-striped"
                >
                  <thead>
                    <tr>
                      <th>Mã Vắc xin</th>
                      <th>Tên Vắc xin</th>
                      <th>Số lượt tiêm</th>
                      <th>Tổng doanh thu (VNĐ)</th>
                    </tr>
                  </thead>
                  <tbody>
                    @if (vaccineRevenue != null && ((IEnumerable<dynamic>)vaccineRevenue).Any())
                    {
                        foreach (var item in vaccineRevenue)
                        {
                            <tr>
                                <td>@item.MaVC</td>
                                <td>@item.TenVC</td>
                                <td>@item.SoLuotTiem</td>
                                <td>@string.Format("{0:N0}", item.TongDoanhThu)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="no-data">
                            <td></td>
                            <td class="text-center">Chưa có dữ liệu doanh thu</td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                  </tbody>
                  <tfoot>
                    <tr>
                      <th></th>
                      <th></th>
                      <th class="text-right">Tổng cộng:</th>
                      <th>@string.Format("{0:N0}", vaccineRevenue != null && ((IEnumerable<dynamic>)vaccineRevenue).Any() ? ((IEnumerable<dynamic>)vaccineRevenue).Sum(x => (decimal)x.TongDoanhThu) : 0)</th>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>


@section scripts {
    <script>
        // Dữ liệu xu hướng tiêm chủng
        var trendsData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AppointmentTrends ?? new List<object>()));
        console.log('Trends Data:', trendsData);

        // Tạo nhãn và dữ liệu cho biểu đồ xu hướng
        var labels = [];
        var data = [];
        
        // Tạo mảng 6 tháng gần nhất
        var currentDate = new Date();
        var months = [];
        for (var i = 5; i >= 0; i--) {
            var d = new Date(currentDate.getFullYear(), currentDate.getMonth() - i, 1);
            months.push({
                year: d.getFullYear(),
                month: d.getMonth() + 1,
                label: 'Tháng ' + (d.getMonth() + 1) + '/' + d.getFullYear()
            });
        }
        
        // Map dữ liệu từ server với 6 tháng
        months.forEach(function(m) {
            labels.push(m.label);
            var found = trendsData.find(function(r) {
                return r.Year === m.year && r.Month === m.month;
            });
            data.push(found ? found.SoLuotTiem : 0);
        });
        
        // Vẽ biểu đồ xu hướng
        var ctx = document.getElementById('trendsChart');
        if (ctx) {
            var trendsChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Số lượt tiêm',
                        data: data,
                        borderColor: 'rgb(54, 162, 235)',
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Số lượt tiêm: ' + context.parsed.y;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        }

        // DataTable
        $(document).ready(function() {
            $('#reportsTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "language": {
                    "decimal": "",
                    "emptyTable": "Chưa có dữ liệu",
                    "info": "Hiển thị _START_ đến _END_ trong tổng số _TOTAL_ mục",
                    "infoEmpty": "Hiển thị 0 đến 0 trong tổng số 0 mục",
                    "infoFiltered": "(lọc từ _MAX_ mục)",
                    "infoPostFix": "",
                    "thousands": ",",
                    "lengthMenu": "Hiển thị _MENU_ mục",
                    "loadingRecords": "Đang tải...",
                    "processing": "Đang xử lý...",
                    "search": "Tìm kiếm:",
                    "zeroRecords": "Không tìm thấy kết quả",
                    "paginate": {
                        "first": "Đầu",
                        "last": "Cuối",
                        "next": "Sau",
                        "previous": "Trước"
                    },
                    "aria": {
                        "sortAscending": ": sắp xếp tăng dần",
                        "sortDescending": ": sắp xếp giảm dần"
                    }
                }
            });

            // Export Excel
            $('#exportExcelBtn').click(function() {
                // Simple CSV export
                var csv = [];
                var rows = document.querySelectorAll('#reportsTable tr');
                
                for (var i = 0; i < rows.length; i++) {
                    var row = [], cols = rows[i].querySelectorAll('td, th');
                    for (var j = 0; j < cols.length; j++) {
                        row.push(cols[j].innerText);
                    }
                    csv.push(row.join(','));
                }
                
                var csvString = csv.join('\n');
                var link = document.createElement('a');
                link.href = 'data:text/csv;charset=utf-8,%EF%BB%BF' + encodeURIComponent(csvString);
                link.download = 'BaoCaoDoanhThu_' + new Date().toISOString().split('T')[0] + '.csv';
                link.click();
            });
        });
    </script>
}
