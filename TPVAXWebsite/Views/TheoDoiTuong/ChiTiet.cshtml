@model TPVAXWebsite.Models.ViewModels.BaiVietViewModel

@{
    ViewBag.Title = Model.TieuDe;
}

<nav aria-label="breadcrumb" class="bg-light py-3">
    <div class="container">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">🏠 Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index","TheoDoiTuong")">💉 Theo Đối Tượng</a></li>
            <li class="breadcrumb-item active">@Model.TieuDe</li>
        </ol>
    </div>
</nav>

<section class="container my-5">
    <div class="row">
        <!-- Nội dung chính -->
        <div class="col-lg-8">
            <h1 class="fw-bold display-5 text-primary mb-4 border-bottom pb-2">@Model.TieuDe</h1>

 

            <div class="d-flex align-items-center gap-3 text-muted mb-4">
                <span>📅 @Model.NgayDang.ToString("dd/MM/yyyy")</span>
                <span>🏷️ <strong>@Model.DanhMuc</strong></span>
            </div>

            <div class="article-content lh-lg fs-5 text-dark">
                @Html.Raw(Model.NoiDung)
            </div>

            @if (!string.IsNullOrEmpty(Model.Tag))
            {
                var tags = Model.Tag.Split(',').Select(t => t.Trim()).ToList();
                <div class="article-tags mt-4">
                    <strong class="me-2">🔖 Từ khóa:</strong>
                    @foreach (var tag in tags)
                    {
                        <span class="tag-badge">@tag</span>
                    }
                </div>
            }

            <div class="mt-5">
                <h5>🔗 Chia sẻ bài viết:</h5>
                <div class="d-flex gap-3 mt-2">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@Url.Action("ChiTiet", "TheoDoiTuong", new { id = Model.Id }, Request.Url.Scheme)"
                       target="_blank" class="btn btn-sm btn-primary">📘 Facebook</a>
                    <a href="https://zalo.me/share?url=@Url.Action("ChiTiet", "TheoDoiTuong", new { id = Model.Id }, Request.Url.Scheme)"
                       target="_blank" class="btn btn-sm btn-success">💬 Zalo</a>
                    <button class="btn btn-sm btn-secondary" onclick="copyLink()">🔗 Copy link</button>
                </div>
            </div>
        </div>

        <!-- Bài viết liên quan -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-bold">📑 Bài viết trong Theo Đối Tượng</div>
                    <div class="card-body">
                        @if (ViewBag.LienQuan != null)
                        {
                            var ds = ViewBag.LienQuan as List<TPVAXWebsite.Models.ViewModels.BaiVietViewModel>;
                            <ul class="list-unstyled">
                                @foreach (var item in ds)
                                {
                                    <li class="mb-3">
                                        <a href="@Url.Action("ChiTiet", "TheoDoiTuong", new { id = item.Id })" class="text-decoration-none fw-semibold">
                                            💉 @item.TieuDe
                                        </a>
                                        <small class="text-muted d-block">📅 @item.NgayDang.ToString("dd/MM/yyyy")</small>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">Không có bài viết nào.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function copyLink() {
            const link = window.location.href;
            navigator.clipboard.writeText(link).then(() => {
                alert("📋 Link bài viết đã được copy!");
            });
        }
    </script>
}

