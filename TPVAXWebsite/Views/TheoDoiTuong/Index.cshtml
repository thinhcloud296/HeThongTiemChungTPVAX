    box-shadow: 0 12px 22px rgba(0,0,0,0.12);
}

/* ===============================
   ẢNH CARD TỶ LỆ VUÔNG 1:1
   =============================== */
.article-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;  /* TỶ LỆ VUÔNG */
    overflow: hidden;
    background: #f2f2f2;
    border-bottom: 1px solid #eee;
}

.article-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Phủ kín ô vuông */
    display: block;
}
/* ================================= */

.article-content {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.article-content .badge {
    width: fit-content;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    padding: 6px 10px;
    border-radius: 8px;
}

.article-content h5 {
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
    color: #222;
    flex: 1;
    line-height: 1.45;
}

.article-content p {
    font-size: 0.9rem;
    color: #555;
    margin-bottom: 1rem;
}

.article-content .btn {
    align-self: flex-start;
}

/* Nút lọc danh mục */
.category-btn {
    display: block;
    padding: 10px 20px;
    border: 2px solid #ddd;
    border-radius: 25px;
    text-align: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
    font-weight: 500;
}

.category-btn:hover,
.category-btn.active {
    background-color: #007bff;
    color: white;
    border-color: #007bff;
}

/* Phân trang */
.pagination .page-link {
    cursor: pointer;
}

.pagination .page-item.active .page-link {
    background-color: #007bff;
    border-color: #007bff;
}
</style>

<script>
    const cardsPerPage = 6;
    let currentCategory = 'all';
    let currentPage = 1;

    const categoryBtns = document.querySelectorAll('.category-btn');
    const allCards = document.querySelectorAll('#articleGrid > div');
    const paginationLinks = document.querySelectorAll('.pagination .page-link');

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            categoryBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentCategory = btn.dataset.category;
            currentPage = 1;
            updateDisplay();
        });
    });

    paginationLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            currentPage = parseInt(link.dataset.page);
            updateDisplay();
        });
    });

    function updateDisplay() {
        const filteredCards = Array.from(allCards).filter(card => {
            return currentCategory === 'all' || card.dataset.category === currentCategory;
        });

        const totalPages = Math.ceil(filteredCards.length / cardsPerPage);

        // Hide all cards
        allCards.forEach(card => card.style.display = 'none');

        // Show current page cards
        const start = (currentPage - 1) * cardsPerPage;
        const end = start + cardsPerPage;
        filteredCards.slice(start, end).forEach(card => card.style.display = 'block');

        // Update pagination
        updatePagination(totalPages);
    }

    function updatePagination(totalPages) {
        const pagination = document.getElementById('pagination');
        pagination.innerHTML = '';

        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement('li');
            li.className = 'page-item' + (i === currentPage ? ' active' : '');
            li.innerHTML = `<a class="page-link" href="#" data-page="${i}">${i}</a>`;
            pagination.appendChild(li);

            li.querySelector('a').addEventListener('click', (e) => {
                e.preventDefault();
                currentPage = i;
                updateDisplay();
            });
        }
    }

    // Initial display
    updateDisplay();
</script>
