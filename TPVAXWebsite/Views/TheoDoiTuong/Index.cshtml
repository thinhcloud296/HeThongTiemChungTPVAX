@model dynamic
@{
    ViewBag.Title = "Thông Tin Vắc Xin Theo Đối Tượng";
}

<!-- Page Header -->
      <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-primary mb-3">
          📋 THÔNG TIN VẮC XIN THEO ĐỐI TƯỢNG
        </h2>
        <p class="lead text-muted">
          Tìm hiểu thông tin vắc xin phù hợp với từng lứa tuổi và đối tượng.
          Hướng dẫn chi tiết, khoa học và cập nhật từ chuyên gia TPVAX.
        </p>
      </div>

      <!-- Category Cards - Modern Design -->
      <section class="mb-5">
        <div class="row g-4">
          <div class="col-6 col-md-4 col-lg">
            <a
              href="#nhi"
              class="category-card-modern active"
              data-target="nhi"
            >
              <div class="category-card-icon-wrapper">
                <img src="@Url.Content("~/Content/Assets/Icons/baby-boy.png")" alt="Nhi" loading="lazy" />
              </div>
              <h3 class="category-card-title">Nhi</h3>
              <p class="category-card-desc">Trẻ em & Sơ sinh</p>
            </a>
          </div>

          <div class="col-6 col-md-4 col-lg">
            <a
              href="#thanh-thieu-nien"
              class="category-card-modern"
              data-target="thanh-thieu-nien"
            >
              <div class="category-card-icon-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Icons/teener.png")"
                  alt="Thanh thiếu niên"
                  loading="lazy"
                />
              </div>
              <h3 class="category-card-title">Thanh thiếu niên</h3>
              <p class="category-card-desc">9-18 tuổi</p>
            </a>
          </div>

          <div class="col-6 col-md-4 col-lg">
            <a
              href="#du-lich"
              class="category-card-modern"
              data-target="du-lich"
            >
              <div class="category-card-icon-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Icons/travel.png")"
                  alt="Du lịch"
                  loading="lazy"
                />
              </div>
              <h3 class="category-card-title">Du lịch</h3>
              <p class="category-card-desc">Đi nước ngoài</p>
            </a>
          </div>

          <div class="col-6 col-md-4 col-lg">
            <a
              href="#tien-hon-nhan"
              class="category-card-modern"
              data-target="tien-hon-nhan"
            >
              <div class="category-card-icon-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Icons/marriage.png")"
                  alt="Tiền hôn nhân"
                  loading="lazy"
                />
              </div>
              <h3 class="category-card-title">Tiền hôn nhân</h3>
              <p class="category-card-desc">Chuẩn bị kết hôn</p>
            </a>
          </div>

          <div class="col-6 col-md-4 col-lg">
            <a
              href="#nguoi-truong-thanh"
              class="category-card-modern"
              data-target="nguoi-truong-thanh"
            >
              <div class="category-card-icon-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Icons/adults.png")"
                  alt="Người trưởng thành"
                  loading="lazy"
                />
              </div>
              <h3 class="category-card-title">Người trưởng thành</h3>
              <p class="category-card-desc">18+ tuổi</p>
            </a>
          </div>
        </div>
      </section>

      <!-- Search Section -->
      <section class="mb-5">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="search-box-modern position-relative">
              <input
                type="text"
                class="form-control form-control-lg rounded-pill"
                placeholder="🔍 Tìm kiếm bài viết (VD: HPV, Cúm, Viêm gan B, Rotavirus...)"
                id="articleSearchInput"
                autocomplete="off"
              />
              <div
                id="searchSuggestions"
                class="search-suggestions-modern"
                style="display: none"
              ></div>
            </div>
            <div
              id="searchResultCount"
              class="text-center mt-3"
              style="font-size: 14px; color: #6c757d; display: none"
            ></div>
          </div>
        </div>
      </section>

      <!-- No Results Message -->
      <section id="noResultsMessage" style="display: none">
        <div
          class="alert alert-warning text-center py-5 mx-auto"
          style="max-width: 600px"
        >
          <h3 class="mb-3">🔍 Không tìm thấy bài viết nào</h3>
          <p class="mb-3">
            Vui lòng thử tìm kiếm với từ khóa khác hoặc chọn danh mục khác.
          </p>
          <button
            class="btn btn-primary"
            onclick="document.getElementById('articleSearchInput').value=''; document.getElementById('articleSearchInput').focus();"
          >
            Xóa tìm kiếm
          </button>
        </div>
      </section>

      <!-- Content for "Nhi" Category -->
      <section class="category-content" id="nhi">
