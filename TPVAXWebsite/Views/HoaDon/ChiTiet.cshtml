@model TPVAXWebsite.Models.ViewModels.HoaDonViewModel

@{
    ViewBag.Title = "Chi Tiết Hóa Đơn - TPVAX";
}

@section styles {
    <style>
        body { background: #f0f4f8; }

        .print-wrapper {
            max-width: 700px;
            margin: 30px auto;
            padding: 0 15px;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: white;
            border: 2px solid #0077b6;
            color: #0077b6;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
            margin-bottom: 20px;
        }

        .btn-back:hover {
            background: #0077b6;
            color: white;
        }

        .invoice-paper {
            background: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            padding: 30px;
        }

        /* Logo Header */
        .invoice-logo {
            text-align: center;
            padding-bottom: 15px;
            border-bottom: 2px solid #0077b6;
            margin-bottom: 20px;
        }

        .logo-wrapper {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #0077b6 0%, #023e8a 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
        }

        .logo-text {
            font-size: 1.8rem;
            font-weight: 800;
            color: #0077b6;
            letter-spacing: 2px;
        }

        /* Invoice Title */
        .invoice-title {
            text-align: center;
            margin-bottom: 20px;
        }

        .invoice-title h2 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0 0 5px 0;
        }

        .invoice-id {
            font-size: 0.9rem;
            color: #64748b;
        }

        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .info-item {
            display: flex;
            gap: 8px;
        }

        .info-label {
            color: #64748b;
            min-width: 90px;
        }

        .info-value {
            font-weight: 600;
            color: #1e293b;
        }

        .status-paid {
            color: #16a34a;
        }

        .status-pending {
            color: #d97706;
        }

        /* Product Table */
        .product-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 0.85rem;
        }

        .product-table th {
            background: #f1f5f9;
            padding: 10px 12px;
            text-align: left;
            font-weight: 600;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
        }

        .product-table th:nth-child(2),
        .product-table th:nth-child(3),
        .product-table th:nth-child(4) {
            text-align: right;
        }

        .product-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .product-table td:nth-child(2),
        .product-table td:nth-child(3),
        .product-table td:nth-child(4) {
            text-align: right;
        }

        .product-name {
            font-weight: 600;
            color: #1e293b;
        }

        .product-type {
            font-size: 0.75rem;
            color: #64748b;
        }

        /* Total Section */
        .total-section {
            border-top: 2px solid #0077b6;
            padding-top: 15px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 0.9rem;
        }

        .total-row.grand-total {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0077b6;
            padding-top: 10px;
            margin-top: 5px;
            border-top: 1px dashed #cbd5e1;
        }

        .total-row.grand-total .total-value {
            color: #dc2626;
        }

        /* Footer Note */
        .footer-note {
            text-align: center;
            font-size: 0.8rem;
            color: #64748b;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #e2e8f0;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 25px;
        }

        .btn-print {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 30px;
            background: linear-gradient(135deg, #0077b6 0%, #023e8a 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-print:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 119, 182, 0.4);
        }

        .btn-home {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 30px;
            background: white;
            color: #475569;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
        }

        .btn-home:hover {
            border-color: #0077b6;
            color: #0077b6;
        }

        /* Print Styles */
        @@media print {
            /* Ẩn header, footer và các phần tử không cần thiết */
            header, footer, .site-footer, .toolbar-section, .navbar-section,
            .floating-contact, .scroll-to-top-btn, #scrollToTopBtn,
            .btn-back, .action-buttons { 
                display: none !important; 
            }

            body { 
                background: white !important; 
                margin: 0 !important;
                padding: 0 !important;
            }

            .main { padding: 0 !important; margin: 0 !important; }
            .print-wrapper { margin: 0; padding: 10px; max-width: 100%; }
            .invoice-paper { box-shadow: none; padding: 15px; }
            .logo-icon { 
                background: #0077b6 !important; 
                -webkit-print-color-adjust: exact !important; 
                print-color-adjust: exact !important; 
            }

            /* Đảm bảo in vừa 1 trang */
            .invoice-paper { page-break-inside: avoid; }
        }

        @@media (max-width: 600px) {
            .info-grid { grid-template-columns: 1fr; }
            .product-table { font-size: 0.8rem; }
            .action-buttons { flex-direction: column; }
        }
    </style>
}

<div class="print-wrapper">
    <a href="@Url.Action("Dashboard", "Account")" class="btn-back">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>

    <div class="invoice-paper">
        <!-- Logo -->
        <div class="invoice-logo">
            <div class="logo-wrapper">
                <div class="logo-icon"><i class="fas fa-syringe"></i></div>
                <span class="logo-text">TPVAX</span>
            </div>
        </div>

        <!-- Title -->
        <div class="invoice-title">
            <h2>HÓA ĐƠN TIÊM CHỦNG</h2>
            <p class="invoice-id">Mã: #@Model.MaHD</p>
        </div>

        <!-- Info -->
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label"><i class="fas fa-user"></i> Khách hàng:</span>
                <span class="info-value">@Model.TenKH</span>
            </div>
            <div class="info-item">
                <span class="info-label"><i class="fas fa-calendar"></i> Ngày lập:</span>
                <span class="info-value">@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="info-item">
                <span class="info-label"><i class="fas fa-info-circle"></i> Trạng thái:</span>
                <span class="info-value @(Model.TrangThai == "Đã thanh toán" ? "status-paid" : "status-pending")">
                    <i class="fas @(Model.TrangThai == "Đã thanh toán" ? "fa-check-circle" : "fa-clock")"></i>
                    @Model.TrangThai
                </span>
            </div>
            @if (!string.IsNullOrEmpty(Model.MaKM))
            {
                <div class="info-item">
                    <span class="info-label"><i class="fas fa-gift"></i> Khuyến mãi:</span>
                    <span class="info-value" style="color: #d97706;">@Model.TenKM</span>
                </div>
            }
        </div>

        <!-- Products -->
        @if (Model.ChiTietHoaDon != null && Model.ChiTietHoaDon.Any())
        {
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>SL</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ChiTietHoaDon)
                    {
                        <tr>
                            <td>
                                <div class="product-name">@item.TenSanPham</div>
                                <div class="product-type">@(item.LoaiSanPham == "VACCINE" ? "Vaccine" : "Gói vaccine")</div>
                            </td>
                            <td>@string.Format("{0:N0}₫", item.DonGia)</td>
                            <td>@item.SoLuong</td>
                            <td><strong>@string.Format("{0:N0}₫", item.DonGia * item.SoLuong)</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Total -->
        <div class="total-section">
            <div class="total-row">
                <span>Tổng số lượng:</span>
                <span>@Model.ChiTietHoaDon.Sum(ct => ct.SoLuong) sản phẩm</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.MaKM))
            {
                <div class="total-row">
                    <span>Tạm tính:</span>
                    <span>@string.Format("{0:N0}₫", Model.ChiTietHoaDon.Sum(ct => ct.DonGia * ct.SoLuong))</span>
                </div>
                <div class="total-row" style="color: #16a34a;">
                    <span>Giảm giá:</span>
                    <span>-@string.Format("{0:N0}₫", Model.ChiTietHoaDon.Sum(ct => ct.DonGia * ct.SoLuong) - Model.TongTien)</span>
                </div>
            }
            <div class="total-row grand-total">
                <span>TỔNG THANH TOÁN:</span>
                <span class="total-value">@string.Format("{0:N0}₫", Model.TongTien)</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-note">
            Cảm ơn quý khách đã sử dụng dịch vụ của TPVAX!
        </div>
    </div>

    <!-- Buttons -->
    <div class="action-buttons">
        <button class="btn-print" onclick="window.print()">
            <i class="fas fa-print"></i> In hóa đơn
        </button>
        <a href="@Url.Action("Dashboard", "Account")" class="btn-home">
            <i class="fas fa-home"></i> Về trang chủ
        </a>
    </div>
</div>
