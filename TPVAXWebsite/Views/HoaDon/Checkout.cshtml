@model TPVAXWebsite.Models.ViewModels.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
<style>
    /* Checkout Page - Professional Payment Flow */
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
    }

    .checkout-container {
        background: transparent;
        min-height: 100vh;
        padding: 30px 0;
    }

    .progress-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        position: relative;
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .progress-steps::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 60px;
        right: 60px;
        height: 4px;
        background: #e1e8ed;
        transform: translateY(-50%);
        z-index: 0;
    }

    .progress-line {
        position: absolute;
        top: 50%;
        left: 60px;
        height: 3px;
        background: #0077b6;
        transform: translateY(-50%);
        transition: width 0.5s ease;
        z-index: 1;
    }

    .step {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: white;
        padding: 10px;
        border-radius: 10px;
    }

    .step-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #e1e8ed;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 24px;
        margin-bottom: 12px;
        transition: all 0.4s;
        border: 4px solid transparent;
    }

    .step.active .step-circle {
        background: linear-gradient(135deg, #0077b6, #00b4d8);
        color: white;
        box-shadow: 0 0 0 8px rgba(0, 119, 182, 0.15);
        border-color: white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 8px rgba(0, 119, 182, 0.15);
        }
        50% {
            box-shadow: 0 0 0 12px rgba(0, 119, 182, 0.25);
        }
    }

    .step.completed .step-circle {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border-color: white;
    }

    .step-label {
        font-size: 14px;
        font-weight: 600;
        color: #6c757d;
        text-align: center;
    }

    .step.active .step-label {
        color: #0077b6;
    }

    .checkout-content {
        background: white;
        border-radius: 15px;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        padding: 40px;
        border: 1px solid #e9ecef;
    }

    .checkout-content h4 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 3px solid #0077b6;
    }

    .step-content {
        display: none;
    }

    .step-content.active {
        display: block;
        animation: fadeIn 0.5s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .info-card {
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .info-card.selected {
        border-color: #0077b6;
        background: #e7f3ff;
    }

    .payment-method {
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 15px;
        cursor: pointer;
        transition: all 0.3s;
        background: #fafbfc;
        position: relative;
    }

    .payment-method:hover {
        border-color: #0077b6;
        background: white;
        transform: translateX(5px);
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.15);
    }

    .payment-method.selected {
        border-color: #0077b6;
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        box-shadow: 0 4px 20px rgba(0, 119, 182, 0.2);
    }

    .payment-method.selected::after {
        content: "✓";
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        background: #0077b6;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
    }

    .payment-method input[type="radio"] {
        width: 20px;
        height: 20px;
    }

    .order-summary {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 15px;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        padding: 30px;
        position: sticky;
        top: 20px;
        border: 2px solid #e9ecef;
    }

    .order-summary h5 {
        color: #0077b6;
        font-weight: 700;
        border-bottom: 3px solid #0077b6;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e1e8ed;
    }

    .summary-item:last-child {
        border-bottom: none;
    }

    .summary-total {
        font-size: 24px;
        font-weight: 700;
        color: #0077b6;
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        padding: 15px;
        border-radius: 10px;
        margin-top: 10px;
    }

    .success-icon {
        font-size: 80px;
        color: #28a745;
        animation: scaleIn 0.5s;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
        }
        to {
            transform: scale(1);
        }
    }
</style>
}

<!-- Back Button -->
<div class="container mt-3">
    <a href="@Url.Action("Index", "GioHang")" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-2"></i>Quay lai gio hang
    </a>
</div>

<!-- Checkout Container -->
<div class="checkout-container">
    <div class="container">
        <!-- Progress Steps -->
        <div class="progress-steps">
            <div class="progress-line" id="progressLine" style="width: 0%"></div>

            <div class="step active" data-step="1">
                <div class="step-circle">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div class="step-label">Xac nhan<br />thong tin</div>
            </div>

            <div class="step" data-step="2">
                <div class="step-circle">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div class="step-label">Phuong thuc<br />thanh toan</div>
            </div>

            <div class="step" data-step="3">
                <div class="step-circle">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="step-label">Xac nhan<br />don hang</div>
            </div>

            <div class="step" data-step="4">
                <div class="step-circle">
                    <i class="fas fa-smile"></i>
                </div>
                <div class="step-label">Hoan tat</div>
            </div>
        </div>

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="checkout-content">
                    <!-- Step 1: Confirm Information -->
                    <div class="step-content active" id="step-1">
                        <h4 class="mb-4">
                            <i class="fas fa-clipboard-check me-2 text-primary"></i>Xac nhan thong tin
                        </h4>

                        <!-- Customer Info -->
                        @if (Model != null && Model.KhachHang != null)
                        {
                            <div class="info-card selected">
                                <h6 class="mb-3">
                                    <i class="fas fa-user me-2"></i>Thong tin nguoi dat
                                </h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong>Ho ten:</strong> @Model.KhachHang.HoTen
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>SDT:</strong> @Model.KhachHang.SoDT
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Email:</strong> @Model.KhachHang.Email
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Ngay sinh:</strong> @(Model.KhachHang.NgaySinh?.ToString("dd/MM/yyyy") ?? "--")
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Lich hen tiem -->
                        <div class="info-card">
                            <h6 class="mb-3">
                                <i class="fas fa-calendar-check me-2"></i>Chon lich hen tiem
                            </h6>
                            <div class="mb-3">
                                <label class="form-label"><strong>Ngay hen tiem <span class="text-danger">*</span></strong></label>
                                <input type="date" class="form-control" id="ngayHenTiem" required />
                                <small class="text-muted">Chon ngay ban muon den trung tam tiem chung</small>
                            </div>
                            <div>
                                <label class="form-label"><strong>Gio hen tiem <span class="text-danger">*</span></strong></label>
                                <select class="form-select" id="gioHenTiem" required>
                                    <option value="">-- Chon khung gio --</option>
                                    <option value="08:00">08:00 - 09:00</option>
                                    <option value="09:00">09:00 - 10:00</option>
                                    <option value="10:00">10:00 - 11:00</option>
                                    <option value="13:00">13:00 - 14:00</option>
                                    <option value="14:00">14:00 - 15:00</option>
                                    <option value="15:00">15:00 - 16:00</option>
                                    <option value="16:00">16:00 - 17:00</option>
                                </select>
                                <small class="text-muted">Vui long den dung gio de tranh cho doi</small>
                            </div>
                        </div>

                        <button class="btn btn-primary btn-lg w-100" onclick="nextStep()">
                            <i class="fas fa-arrow-right me-2"></i>Tiep tuc
                        </button>
                    </div>

                    <!-- Step 2: Payment Method -->
                    <div class="step-content" id="step-2">
                        <h4 class="mb-4">
                            <i class="fas fa-credit-card me-2 text-primary"></i>Chon phuong thuc thanh toan
                        </h4>

                        <!-- Bank Transfer -->
                        <div class="payment-method" onclick="selectPayment('transfer')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-transfer" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-university me-2 text-primary"></i>
                                        Chuyen khoan ngan hang
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Chuyen khoan truoc, xac nhan sau
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Credit Card -->
                        <div class="payment-method" onclick="selectPayment('card')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-card" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-credit-card me-2 text-info"></i>
                                        Thanh toan bang the
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Visa, Mastercard, JCB, Amex
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- MoMo -->
                        <div class="payment-method" onclick="selectPayment('momo')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-momo" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fab fa-bity me-2" style="color: #d82d8b"></i>
                                        Vi MoMo
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Thanh toan qua vi dien tu MoMo
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- ZaloPay -->
                        <div class="payment-method" onclick="selectPayment('zalopay')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-zalopay" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-wallet me-2" style="color: #008fe5"></i>
                                        ZaloPay
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Thanh toan qua vi dien tu ZaloPay
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- VNPay -->
                        <div class="payment-method" onclick="selectPayment('vnpay')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-vnpay" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-qrcode me-2 text-danger"></i>
                                        VNPay QR
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Quet ma QR de thanh toan
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button class="btn btn-outline-secondary btn-lg" onclick="prevStep()">
                                <i class="fas fa-arrow-left me-2"></i>Quay lai
                            </button>
                            <button class="btn btn-primary btn-lg flex-grow-1" onclick="nextStep()">
                                <i class="fas fa-arrow-right me-2"></i>Tiep tuc
                            </button>
                        </div>
                    </div>

                    <!-- Step 3: Confirm Order -->
                    <div class="step-content" id="step-3">
                        <h4 class="mb-4">
                            <i class="fas fa-check-circle me-2 text-primary"></i>Xac nhan don hang
                        </h4>

                        <!-- Order Summary -->
                        <div class="info-card">
                            <h6 class="mb-3">Chi tiet don hang</h6>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>San pham</th>
                                            <th>So luong</th>
                                            <th>Don gia</th>
                                            <th>Thanh tien</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.GioHang != null)
                                        {
                                            foreach (var item in Model.GioHang)
                                            {
                                                <tr>
                                                    <td>@item.TenSanPham</td>
                                                    <td>@item.SoLuong</td>
                                                    <td>@string.Format("{0:N0}d", item.DonGia)</td>
                                                    <td><strong>@string.Format("{0:N0}d", item.ThanhTien)</strong></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Lich hen tiem -->
                        <div class="info-card">
                            <h6 class="mb-3">Thong tin lich hen</h6>
                            <p class="mb-2">
                                <strong>Ngay hen:</strong>
                                <span id="confirmNgayHen">--</span>
                            </p>
                            <p class="mb-0">
                                <strong>Gio hen:</strong>
                                <span id="confirmGioHen">--</span>
                            </p>
                        </div>

                        <!-- Payment Info -->
                        <div class="info-card">
                            <h6 class="mb-3">Phuong thuc thanh toan</h6>
                            <p class="mb-0" id="confirmPayment">--</p>
                        </div>

                        <!-- Terms -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                            <label class="form-check-label" for="agreeTerms">
                                Toi da doc va dong y voi
                                <a href="#" class="text-primary">dieu khoan dich vu</a> va
                                <a href="#" class="text-primary">chinh sach bao mat</a> cua
                                TPVAX
                            </label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg" onclick="prevStep()">
                                <i class="fas fa-arrow-left me-2"></i>Quay lai
                            </button>
                            <button class="btn btn-success btn-lg flex-grow-1" onclick="confirmOrder()">
                                <i class="fas fa-check-circle me-2"></i>Xac nhan thanh toan
                            </button>
                        </div>
                    </div>

                    <!-- Step 4: Success -->
                    <div class="step-content" id="step-4">
                        <div class="text-center py-5">
                            <div class="success-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <h2 class="mt-4 mb-3 text-success">Dat hang thanh cong!</h2>
                            <p class="lead mb-4">
                                Ma don hang cua ban:
                                <strong class="text-primary" id="orderCode">--</strong>
                            </p>

                            @if (Model != null && Model.KhachHang != null && !string.IsNullOrEmpty(Model.KhachHang.Email))
                            {
                                <div class="alert alert-info mb-4">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Thong tin chi tiet da duoc gui den email
                                    <strong>@Model.KhachHang.Email</strong>
                                </div>
                            }

                            <div class="d-flex flex-column gap-3 mx-auto" style="max-width: 400px">
                                <a href="@Url.Action("Index", "HoaDon")" class="btn btn-primary btn-lg">
                                    <i class="fas fa-receipt me-2"></i>Xem don hang cua toi
                                </a>
                                <a href="@Url.Action("Index", "VaccinePhongBenh")" class="btn btn-outline-primary btn-lg">
                                    <i class="fas fa-shopping-cart me-2"></i>Tiep tuc mua sam
                                </a>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-home me-2"></i>Ve trang chu
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="order-summary">
                    <h5 class="mb-4">
                        <i class="fas fa-receipt me-2"></i>Tom tat don hang
                    </h5>

                    @if (Model != null && Model.GioHang != null)
                    {
                        foreach (var item in Model.GioHang)
                        {
                            <div class="summary-item">
                                <span>@item.TenSanPham</span>
                                <strong>@string.Format("{0:N0}d", item.DonGia)</strong>
                            </div>
                        }

                        <div class="summary-item">
                            <span>Tam tinh</span>
                            <strong>@string.Format("{0:N0}d", Model.TongTienTruocGiam)</strong>
                        </div>
                        if (Model.TienGiam > 0)
                        {
                            <div class="summary-item">
                                <span class="text-success">Giam gia</span>
                                <strong class="text-success">-@string.Format("{0:N0}d", Model.TienGiam)</strong>
                            </div>
                        }

                        <hr class="my-3" />

                        <div class="summary-item summary-total">
                            <span>Tong cong</span>
                            <span>@string.Format("{0:N0}d", Model.TongTienSauGiam)</span>
                        </div>
                    }


                    <div class="mt-4">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Nhap ma giam gia" id="couponInput" />
                            <button class="btn btn-outline-primary" type="button" onclick="applyCoupon()">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    </div>



                    <div class="mt-4 text-center">
                        <p class="small text-muted mb-0">
                            Thanh toan an toan & bao mat
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    let currentStep = 1;
    const totalSteps = 4;

    function updateProgress() {
        // Update progress line
        const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
        document.getElementById("progressLine").style.width = progress + "%";

        // Update step indicators
        document.querySelectorAll(".step").forEach((step, index) => {
            const stepNum = index + 1;
            if (stepNum < currentStep) {
                step.classList.add("completed");
                step.classList.remove("active");
            } else if (stepNum === currentStep) {
                step.classList.add("active");
                step.classList.remove("completed");
            } else {
                step.classList.remove("active", "completed");
            }
        });

        // Show/hide step content
        document.querySelectorAll(".step-content").forEach((content, index) => {
            if (index + 1 === currentStep) {
                content.classList.add("active");
            } else {
                content.classList.remove("active");
            }
        });

        // Scroll to top
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function nextStep() {
        // Validation for each step
        if (currentStep === 1) {
            const ngayHen = document.getElementById("ngayHenTiem").value;
            const gioHen = document.getElementById("gioHenTiem").value;

            if (!ngayHen || !gioHen) {
                alert("Vui long chon ngay va gio hen tiem!");
                return;
            }

            // Kiem tra ngay hen phai tu ngay mai tro di
            const selectedDate = new Date(ngayHen);
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(0, 0, 0, 0);

            if (selectedDate < tomorrow) {
                alert("Ngay hen tiem phai tu ngay mai tro di!");
                return;
            }

            // Luu thong tin de xac nhan sau
            document.getElementById("confirmNgayHen").textContent = 
                new Date(ngayHen).toLocaleDateString("vi-VN");
            document.getElementById("confirmGioHen").textContent = gioHen;
        }

        if (currentStep === 2) {
            const selectedPayment = document.querySelector('input[name="payment"]:checked');
            if (!selectedPayment) {
                alert("Vui long chon phuong thuc thanh toan!");
                return;
            }

            const paymentMethod = selectedPayment.closest(".payment-method");
            const paymentText = paymentMethod.querySelector("h6").textContent;
            document.getElementById("confirmPayment").textContent = paymentText;
        }

        if (currentStep < totalSteps) {
            currentStep++;
            updateProgress();
        }
    }

    function prevStep() {
        if (currentStep > 1) {
            currentStep--;
            updateProgress();
        }
    }

    function selectPayment(method) {
        document.querySelectorAll(".payment-method").forEach((pm) => {
            pm.classList.remove("selected");
        });

        const radioBtn = document.getElementById(`payment-${method}`);
        const selectedMethod = radioBtn.closest(".payment-method");
        selectedMethod.classList.add("selected");
        radioBtn.checked = true;
    }

    function confirmOrder() {
        const agreeTerms = document.getElementById("agreeTerms").checked;
        if (!agreeTerms) {
            alert("Vui long dong y voi dieu khoan dich vu!");
            return;
        }

        const selectedPayment = document.querySelector('input[name="payment"]:checked');
        if (!selectedPayment) {
            alert("Vui long chon phuong thuc thanh toan!");
            return;
        }

        // Call payment API
        const btn = event.target;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Dang xu ly...';

        const ngayHen = document.getElementById("ngayHenTiem").value;
        const gioHen = document.getElementById("gioHenTiem").value;

        $.ajax({
            url: '@Url.Action("XacNhanThanhToan", "HoaDon")',
            type: 'POST',
            data: {
                MaKM: '@(Model?.MaKMApDung ?? "")',
                NgayHenTiem: ngayHen,
                GioHenTiem: gioHen
            },
            success: function (response) {
                if (response.success) {
                    // Show order code
                    document.getElementById('orderCode').textContent = response.maHD;
                    
                    // Move to success step
                    currentStep = 4;
                    updateProgress();
                } else {
                    alert(response.message || 'Co loi xay ra!');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Xac nhan thanh toan';
                }
            },
            error: function () {
                alert('Co loi xay ra khi thanh toan!');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Xac nhan thanh toan';
            }
        });
    }

    function applyCoupon() {
        const code = document.getElementById("couponInput").value;
        if (code) {
            alert("Chuc nang dang phat trien!");
        }
    }

    // Initialize
    updateProgress();

    // Set ngay hen tiem toi thieu la ngay mai
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowStr = tomorrow.toISOString().split('T')[0];
    document.getElementById("ngayHenTiem").setAttribute("min", tomorrowStr);

    console.log("Checkout page loaded successfully");
</script>
}
