                                <i class="fas fa-arrow-right me-2"></i>Tiep tuc
                            </button>
                        </div>
                    </div>

                    <!-- Step 3: Confirm Order -->
                    <div class="step-content" id="step-3">
                        <h4 class="mb-4">
                            <i class="fas fa-check-circle me-2 text-primary"></i>Xac nhan don hang
                        </h4>

                        <!-- Order Summary -->
                        <div class="info-card">
                            <h6 class="mb-3">Chi tiet don hang</h6>
