@model TPVAXWebsite.Models.ViewModels.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
<style>
    /* Checkout Page - Professional Payment Flow */
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
    }

    .checkout-container {
        background: transparent;
        min-height: 100vh;
        padding: 30px 0;
    }

    .progress-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        position: relative;
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .progress-steps::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 60px;
        right: 60px;
        height: 4px;
        background: #e1e8ed;
        transform: translateY(-50%);
        z-index: 0;
    }

    .progress-line {
        position: absolute;
        top: 50%;
        left: 60px;
        height: 3px;
        background: #0077b6;
        transform: translateY(-50%);
        transition: width 0.5s ease;
        z-index: 1;
    }

    .step {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: white;
        padding: 10px;
        border-radius: 10px;
    }

    .step-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #e1e8ed;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 24px;
        margin-bottom: 12px;
        transition: all 0.4s;
        border: 4px solid transparent;
    }

    .step.active .step-circle {
        background: linear-gradient(135deg, #0077b6, #00b4d8);
        color: white;
        box-shadow: 0 0 0 8px rgba(0, 119, 182, 0.15);
        border-color: white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 8px rgba(0, 119, 182, 0.15);
        }
        50% {
            box-shadow: 0 0 0 12px rgba(0, 119, 182, 0.25);
        }
    }

    .step.completed .step-circle {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border-color: white;
    }

    .step-label {
        font-size: 14px;
        font-weight: 600;
        color: #6c757d;
        text-align: center;
    }

    .step.active .step-label {
        color: #0077b6;
    }

    .checkout-content {
        background: white;
        border-radius: 15px;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        padding: 40px;
        border: 1px solid #e9ecef;
    }

    .checkout-content h4 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 3px solid #0077b6;
    }

    .step-content {
        display: none;
    }

    .step-content.active {
        display: block;
        animation: fadeIn 0.5s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .info-card {
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .info-card.selected {
        border-color: #0077b6;
        background: #e7f3ff;
    }

    .payment-method {
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 15px;
        cursor: pointer;
        transition: all 0.3s;
        background: #fafbfc;
        position: relative;
    }

    .payment-method:hover {
        border-color: #0077b6;
        background: white;
        transform: translateX(5px);
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.15);
    }

    .payment-method.selected {
        border-color: #0077b6;
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        box-shadow: 0 4px 20px rgba(0, 119, 182, 0.2);
    }

    .payment-method.selected::after {
        content: "✓";
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        background: #0077b6;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
    }

    .payment-method input[type="radio"] {
        width: 20px;
        height: 20px;
    }

    .order-summary {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 15px;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        padding: 30px;
        position: sticky;
        top: 20px;
        border: 2px solid #e9ecef;
    }

    .order-summary h5 {
        color: #0077b6;
        font-weight: 700;
        border-bottom: 3px solid #0077b6;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e1e8ed;
    }

    .summary-item:last-child {
        border-bottom: none;
    }

    .summary-total {
        font-size: 24px;
        font-weight: 700;
        color: #0077b6;
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        padding: 15px;
        border-radius: 10px;
        margin-top: 10px;
    }

    .success-icon {
        font-size: 80px;
        color: #28a745;
        animation: scaleIn 0.5s;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
        }
        to {
            transform: scale(1);
        }
    }
</style>
}

<!-- Back Button -->
<div class="container mt-3">
    <a href="@Url.Action("Index", "GioHang")" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-2"></i>Quay lại giỏ hàng
    </a>
</div>

<!-- Checkout Container -->
<div class="checkout-container">
    <div class="container">
        <!-- Progress Steps -->
        <div class="progress-steps">
            <div class="progress-line" id="progressLine" style="width: 0%"></div>

            <div class="step active" data-step="1">
                <div class="step-circle">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div class="step-label">Xác nhận<br />thông tin</div>
            </div>

            <div class="step" data-step="2">
                <div class="step-circle">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div class="step-label">Phương thức<br />thanh toán</div>
            </div>

            <div class="step" data-step="3">
                <div class="step-circle">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="step-label">Xác nhận<br />đơn hàng</div>
            </div>

            <div class="step" data-step="4">
                <div class="step-circle">
                    <i class="fas fa-smile"></i>
                </div>
                <div class="step-label">Hoàn tất</div>
            </div>
        </div>

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="checkout-content">
                    <!-- Step 1: Confirm Information -->
                    <div class="step-content active" id="step-1">
                        <h4 class="mb-4">
                            <i class="fas fa-clipboard-check me-2 text-primary"></i>Xác nhận thông tin
                        </h4>

                        <!-- Customer Info -->
                        @if (Model != null && Model.KhachHang != null)
                        {
                            <div class="info-card selected">
                                <h6 class="mb-3">
                                    <i class="fas fa-user me-2"></i>Thông tin người đặt
                                </h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong>Họ tên:</strong> @Model.KhachHang.HoTen
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>SĐT:</strong> @Model.KhachHang.SoDT
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Email:</strong> @Model.KhachHang.Email
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Ngày sinh:</strong> @(Model.KhachHang.NgaySinh?.ToString("dd/MM/yyyy") ?? "--")
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Chọn người tiêm và lịch hẹn cho từng sản phẩm -->
                        <div class="info-card">
                            <h6 class="mb-3">
                                <i class="fas fa-users me-2"></i>Chọn người tiêm và lịch hẹn
                            </h6>
                            <p class="text-muted small mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Chọn người tiêm và ngày hẹn cho từng liều vaccine. Các mũi tiếp theo sẽ được tự động lên lịch theo phác đồ.
                            </p>
                            @if (Model != null && Model.GioHang != null && Model.GioHang.Any())
                            {
                                foreach (var item in Model.GioHang)
                                {
                                    <div class="border rounded p-3 mb-3 bg-light product-item" data-magh="@item.MaGH">
                                        <div class="mb-3 pb-2 border-bottom">
                                            <strong class="text-primary product-name">@item.TenSanPham</strong>
                                            <span class="badge bg-secondary ms-2">x@(item.SoLuong)</span>
                                            <br />
                                            <small class="text-muted">@(item.LoaiSanPham == "GOIVACCINE" ? "Gói vaccine" : "Vaccine lẻ")</small>
                                        </div>
                                        @for (int i = 0; i < item.SoLuong; i++)
                                        {
                                            <div class="border rounded p-2 mb-2 bg-white">
                                                <div class="fw-bold text-secondary mb-2">
                                                    <i class="fas fa-user me-1"></i>Liều #@(i + 1)
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-md-12 mb-2">
                                                        <label class="form-label small mb-1">Người tiêm:</label>
                                                        @if (Model.DanhSachHoSo != null && Model.DanhSachHoSo.Any())
                                                        {
                                                            <select class="form-select form-select-sm nguoi-tiem-select" 
                                                                    data-magh="@item.MaGH" 
                                                                    data-masanpham="@item.MaSanPham" 
                                                                    data-loaisanpham="@item.LoaiSanPham"
                                                                    data-index="@i">
                                                                @foreach (var hoSo in Model.DanhSachHoSo)
                                                                {
                                                                    <option value="@hoSo.MaHSTC">@hoSo.DisplayText</option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <input type="hidden" class="nguoi-tiem-select" 
                                                                   data-magh="@item.MaGH" 
                                                                   data-masanpham="@item.MaSanPham" 
                                                                   data-loaisanpham="@item.LoaiSanPham"
                                                                   data-index="@i"
                                                                   value="" />
                                                            <span class="text-muted small"><i class="fas fa-info-circle me-1"></i>Hệ thống sẽ tự động tạo hồ sơ</span>
                                                        }
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small mb-1">Ngày hẹn: <span class="text-danger">*</span></label>
                                                        <input type="date" class="form-control form-control-sm ngay-hen-input" 
                                                               data-magh="@item.MaGH" 
                                                               data-index="@i" required />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small mb-1">Giờ hẹn: <span class="text-danger">*</span></label>
                                                        <select class="form-select form-select-sm gio-hen-select" 
                                                                data-magh="@item.MaGH" 
                                                                data-index="@i" required>
                                                            <option value="">-- Chọn giờ --</option>
                                                            <option value="08:00">08:00</option>
                                                            <option value="09:00">09:00</option>
                                                            <option value="10:00">10:00</option>
                                                            <option value="13:00">13:00</option>
                                                            <option value="14:00">14:00</option>
                                                            <option value="15:00">15:00</option>
                                                            <option value="16:00">16:00</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Giỏ hàng trống. Vui lòng thêm sản phẩm trước khi thanh toán.
                                </div>
                            }
                        </div>

                        <button class="btn btn-primary btn-lg w-100" onclick="nextStep()">
                            <i class="fas fa-arrow-right me-2"></i>Tiếp tục
                        </button>
                    </div>

                    <!-- Step 2: Payment Method -->
                    <div class="step-content" id="step-2">
                        <h4 class="mb-4">
                            <i class="fas fa-credit-card me-2 text-primary"></i>Chọn phương thức thanh toán
                        </h4>

                        <!-- Bank Transfer -->
                        <div class="payment-method" onclick="selectPayment('transfer')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-transfer" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-university me-2 text-primary"></i>
                                        Chuyển khoản ngân hàng
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Chuyển khoản trước, xác nhận sau
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Credit Card -->
                        <div class="payment-method" onclick="selectPayment('card')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-card" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-credit-card me-2 text-info"></i>
                                        Thanh toán bằng thẻ
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Visa, Mastercard, JCB, Amex
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- MoMo -->
                        <div class="payment-method" onclick="selectPayment('momo')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-momo" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fab fa-bity me-2" style="color: #d82d8b"></i>
                                        Ví MoMo
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Thanh toán qua ví điện tử MoMo
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- ZaloPay -->
                        <div class="payment-method" onclick="selectPayment('zalopay')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-zalopay" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-wallet me-2" style="color: #008fe5"></i>
                                        ZaloPay
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Thanh toán qua ví điện tử ZaloPay
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- VNPay -->
                        <div class="payment-method" onclick="selectPayment('vnpay')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-vnpay" class="me-3" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="fas fa-qrcode me-2 text-danger"></i>
                                        VNPay QR
                                    </h6>
                                    <p class="mb-0 text-muted small">
                                        Quét mã QR để thanh toán
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button class="btn btn-outline-secondary btn-lg" onclick="prevStep()">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </button>
                            <button class="btn btn-primary btn-lg flex-grow-1" onclick="nextStep()">
                                <i class="fas fa-arrow-right me-2"></i>Tiếp tục
                            </button>
                        </div>
                    </div>

                    <!-- Step 3: Confirm Order -->
                    <div class="step-content" id="step-3">
                        <h4 class="mb-4">
                            <i class="fas fa-check-circle me-2 text-primary"></i>Xác nhận đơn hàng
                        </h4>

                        <!-- Order Summary -->
                        <div class="info-card">
                            <h6 class="mb-3">Chi tiết đơn hàng</h6>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Số lượng</th>
                                            <th>Đơn giá</th>
                                            <th>Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.GioHang != null)
                                        {
                                            foreach (var item in Model.GioHang)
                                            {
                                                <tr>
                                                    <td>@item.TenSanPham</td>
                                                    <td>@item.SoLuong</td>
                                                    <td>@string.Format("{0:N0}d", item.DonGia)</td>
                                                    <td><strong>@string.Format("{0:N0}d", item.ThanhTien)</strong></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Lịch hẹn tiêm -->
                        <div class="info-card">
                            <h6 class="mb-3">Thông tin lịch hẹn</h6>
                            <p class="mb-2">
                                <strong>Ngày hẹn mũi đầu:</strong>
                                <span id="confirmNgayHen">--</span>
                            </p>
                            <p class="mb-2">
                                <strong>Giờ hẹn:</strong>
                                <span id="confirmGioHen">--</span>
                            </p>
                            <p class="mb-0 text-info small">
                                <i class="fas fa-info-circle me-1"></i>
                                Các mũi tiếp theo sẽ được tự động lên lịch theo phác đồ của từng vaccine
                            </p>
                        </div>

                        <!-- Người tiêm -->
                        <div class="info-card">
                            <h6 class="mb-3">Người tiêm</h6>
                            <div id="confirmNguoiTiem">
                                <!-- Sẽ được điền bằng JavaScript -->
                            </div>
                        </div>

                        <!-- Payment Info -->
                        <div class="info-card">
                            <h6 class="mb-3">Phương thức thanh toán</h6>
                            <p class="mb-0" id="confirmPayment">--</p>
                        </div>

                        <!-- Terms -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                            <label class="form-check-label" for="agreeTerms">
                                Tôi đã đọc và đồng ý với
                                <a href="#" class="text-primary">điều khoản dịch vụ</a> và
                                <a href="#" class="text-primary">chính sách bảo mật</a> của
                                TPVAX
                            </label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg" onclick="prevStep()">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </button>
                            <button class="btn btn-success btn-lg flex-grow-1" onclick="confirmOrder()">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận thanh toán
                            </button>
                        </div>
                    </div>

                    <!-- Step 4: Success -->
                    <div class="step-content" id="step-4">
                        <div class="text-center py-5">
                            <div class="success-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <h2 class="mt-4 mb-3 text-success">Đặt hàng thành công!</h2>
                            <p class="lead mb-4">
                                Mã đơn hàng của bạn:
                                <strong class="text-primary" id="orderCode">--</strong>
                            </p>

                            @if (Model != null && Model.KhachHang != null && !string.IsNullOrEmpty(Model.KhachHang.Email))
                            {
                                <div class="alert alert-info mb-4">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Thông tin chi tiết đã được gửi đến email
                                    <strong>@Model.KhachHang.Email</strong>
                                </div>
                            }

                            <div class="d-flex flex-column gap-3 mx-auto" style="max-width: 400px">
                                <a href="@Url.Action("Index", "HoaDon")" class="btn btn-primary btn-lg">
                                    <i class="fas fa-receipt me-2"></i>Xem đơn hàng của tôi
                                </a>
                                <a href="@Url.Action("Index", "VaccinePhongBenh")" class="btn btn-outline-primary btn-lg">
                                    <i class="fas fa-shopping-cart me-2"></i>Tiếp tục mua sắm
                                </a>
                                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-home me-2"></i>Về trang chủ
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="order-summary">
                    <h5 class="mb-4">
                        <i class="fas fa-receipt me-2"></i>Tóm tắt đơn hàng
                    </h5>

                    @if (Model != null && Model.GioHang != null)
                    {
                        foreach (var item in Model.GioHang)
                        {
                            <div class="summary-item">
                                <span>@item.TenSanPham <small class="text-muted">x@(item.SoLuong)</small></span>
                                <strong>@string.Format("{0:N0}đ", item.ThanhTien)</strong>
                            </div>
                        }

                        <div class="summary-item">
                            <span>Tạm tính</span>
                            <strong>@string.Format("{0:N0}đ", Model.TongTienTruocGiam)</strong>
                        </div>
                        if (Model.TienGiam > 0)
                        {
                            <div class="summary-item">
                                <span class="text-success">Giảm giá</span>
                                <strong class="text-success">-@string.Format("{0:N0}đ", Model.TienGiam)</strong>
                            </div>
                        }

                        <hr class="my-3" />

                        <div class="summary-item summary-total">
                            <span>Tổng cộng</span>
                            <span>@string.Format("{0:N0}đ", Model.TongTienSauGiam)</span>
                        </div>
                    }


                    <div class="mt-4">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Nhap ma giam gia" id="couponInput" />
                            <button class="btn btn-outline-primary" type="button" onclick="applyCoupon()">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    </div>



                    <div class="mt-4 text-center">
                        <p class="small text-muted mb-0">
                            Thanh toan an toan & bao mat
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    let currentStep = 1;
    const totalSteps = 4;

    function updateProgress() {
        // Update progress line
        const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
        document.getElementById("progressLine").style.width = progress + "%";

        // Update step indicators
        document.querySelectorAll(".step").forEach((step, index) => {
            const stepNum = index + 1;
            if (stepNum < currentStep) {
                step.classList.add("completed");
                step.classList.remove("active");
            } else if (stepNum === currentStep) {
                step.classList.add("active");
                step.classList.remove("completed");
            } else {
                step.classList.remove("active", "completed");
            }
        });

        // Show/hide step content
        document.querySelectorAll(".step-content").forEach((content, index) => {
            if (index + 1 === currentStep) {
                content.classList.add("active");
            } else {
                content.classList.remove("active");
            }
        });

        // Scroll to top
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function nextStep() {
        // Validation for each step
        if (currentStep === 1) {
            // Validate tất cả các lịch hẹn
            var allValid = true;
            var errorMsg = '';
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(0, 0, 0, 0);

            document.querySelectorAll('.ngay-hen-input').forEach(function(input) {
                if (!input.value) {
                    allValid = false;
                    errorMsg = 'Vui lòng chọn ngày hẹn tiêm cho tất cả người tiêm!';
                } else {
                    const selectedDate = new Date(input.value);
                    if (selectedDate < tomorrow) {
                        allValid = false;
                        errorMsg = 'Ngày hẹn tiêm phải từ ngày mai trở đi!';
                    }
                }
            });

            document.querySelectorAll('.gio-hen-select').forEach(function(select) {
                if (!select.value) {
                    allValid = false;
                    errorMsg = 'Vui lòng chọn giờ hẹn tiêm cho tất cả người tiêm!';
                }
            });

            if (!allValid) {
                alert(errorMsg);
                return;
            }

            // Hiển thị thông tin xác nhận
            var firstNgayHen = document.querySelector('.ngay-hen-input');
            var firstGioHen = document.querySelector('.gio-hen-select');
            if (firstNgayHen && firstNgayHen.value) {
                document.getElementById("confirmNgayHen").textContent = 
                    new Date(firstNgayHen.value).toLocaleDateString("vi-VN") + ' (và các ngày khác)';
            }
            if (firstGioHen && firstGioHen.value) {
                document.getElementById("confirmGioHen").textContent = firstGioHen.value + ' (và các giờ khác)';
            }

            // Hiển thị thông tin người tiêm (nhóm theo sản phẩm)
            var nguoiTiemHtml = '';
            var currentProduct = '';
            document.querySelectorAll('.nguoi-tiem-select').forEach(function(el) {
                var productContainer = el.closest('.product-item');
                if (!productContainer) return;
                var tenSanPhamEl = productContainer.querySelector('.product-name');
                if (!tenSanPhamEl) return;
                var tenSanPham = tenSanPhamEl.textContent;
                
                // Xử lý cả select và hidden input
                var tenNguoiTiem = '';
                if (el.tagName === 'SELECT') {
                    tenNguoiTiem = el.options[el.selectedIndex].text;
                } else {
                    tenNguoiTiem = 'Tự động tạo hồ sơ';
                }
                
                var index = parseInt(el.getAttribute('data-index') || '0') + 1;
                var maGH = el.getAttribute('data-magh');
                
                // Lấy ngày giờ hẹn tương ứng
                var ngayHenInput = document.querySelector('.ngay-hen-input[data-magh="' + maGH + '"][data-index="' + (index-1) + '"]');
                var gioHenSelect = document.querySelector('.gio-hen-select[data-magh="' + maGH + '"][data-index="' + (index-1) + '"]');
                var ngayHenStr = ngayHenInput && ngayHenInput.value ? new Date(ngayHenInput.value).toLocaleDateString("vi-VN") : '--';
                var gioHenStr = gioHenSelect ? gioHenSelect.value : '--';
                
                if (currentProduct !== tenSanPham) {
                    currentProduct = tenSanPham;
                    nguoiTiemHtml += '<div class="mb-2 mt-2"><strong class="text-primary">' + tenSanPham + ':</strong></div>';
                }
                nguoiTiemHtml += '<p class="mb-1 ms-3"><small>Liều #' + index + ':</small> ' + tenNguoiTiem + ' - <em>' + ngayHenStr + ' ' + gioHenStr + '</em></p>';
            });
            if (nguoiTiemHtml) {
                document.getElementById("confirmNguoiTiem").innerHTML = nguoiTiemHtml;
            } else {
                document.getElementById("confirmNguoiTiem").innerHTML = '<p class="text-muted">Hệ thống sẽ tự động tạo hồ sơ cho bạn</p>';
            }
        }

        if (currentStep === 2) {
            const selectedPayment = document.querySelector('input[name="payment"]:checked');
            if (!selectedPayment) {
                alert("Vui lòng chọn phương thức thanh toán!");
                return;
            }

            const paymentMethod = selectedPayment.closest(".payment-method");
            const paymentText = paymentMethod.querySelector("h6").textContent;
            document.getElementById("confirmPayment").textContent = paymentText;
        }

        if (currentStep < totalSteps) {
            currentStep++;
            updateProgress();
        }
    }

    function prevStep() {
        if (currentStep > 1) {
            currentStep--;
            updateProgress();
        }
    }

    function selectPayment(method) {
        document.querySelectorAll(".payment-method").forEach((pm) => {
            pm.classList.remove("selected");
        });

        const radioBtn = document.getElementById(`payment-${method}`);
        const selectedMethod = radioBtn.closest(".payment-method");
        selectedMethod.classList.add("selected");
        radioBtn.checked = true;
    }

    function confirmOrder() {
        const agreeTerms = document.getElementById("agreeTerms").checked;
        if (!agreeTerms) {
            alert("Vui lòng đồng ý với điều khoản dịch vụ!");
            return;
        }

        const selectedPayment = document.querySelector('input[name="payment"]:checked');
        if (!selectedPayment) {
            alert("Vui lòng chọn phương thức thanh toán!");
            return;
        }

        // Call payment API
        const btn = event.target;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

        // Thu thập danh sách người tiêm và lịch hẹn cho từng sản phẩm
        var danhSachNguoiTiem = [];
        document.querySelectorAll('.nguoi-tiem-select').forEach(function(select) {
            var maGH = select.getAttribute('data-magh');
            var index = select.getAttribute('data-index') || '0';
            
            // Lấy ngày giờ hẹn tương ứng
            var ngayHenInput = document.querySelector('.ngay-hen-input[data-magh="' + maGH + '"][data-index="' + index + '"]');
            var gioHenSelect = document.querySelector('.gio-hen-select[data-magh="' + maGH + '"][data-index="' + index + '"]');
            
            danhSachNguoiTiem.push({
                MaGH: parseInt(maGH),
                MaSanPham: select.getAttribute('data-masanpham'),
                LoaiSanPham: select.getAttribute('data-loaisanpham'),
                MaHSTC: select.value,
                Index: parseInt(index),
                NgayHenTiem: ngayHenInput ? ngayHenInput.value : '',
                GioHenTiem: gioHenSelect ? gioHenSelect.value : ''
            });
        });

        $.ajax({
            url: '@Url.Action("XacNhanThanhToan", "HoaDon")',
            type: 'POST',
            data: {
                MaKM: '@(Model?.MaKMApDung ?? "")',
                DanhSachNguoiTiem: JSON.stringify(danhSachNguoiTiem)
            },
            success: function (response) {
                if (response.success) {
                    // Show success message with SweetAlert
                    Swal.fire({
                        icon: 'success',
                        title: 'Thanh toán thành công!',
                        html: 'Mã hóa đơn: <strong>' + response.maHD + '</strong><br>Cảm ơn bạn đã sử dụng dịch vụ!',
                        confirmButtonColor: '#0077b6',
                        allowOutsideClick: false
                    }).then(() => {
                        // Redirect to invoice detail page
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                            window.location.href = '@Url.Action("Dashboard", "Account")';
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: response.message || 'Có lỗi xảy ra!',
                        confirmButtonColor: '#dc3545'
                    });
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Xác nhận thanh toán';
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra khi thanh toán!',
                    confirmButtonColor: '#dc3545'
                });
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Xác nhận thanh toán';
            }
        });
    }

    function applyCoupon() {
        const code = document.getElementById("couponInput").value;
        if (code) {
            alert("Chức năng đang phát triển!");
        }
    }

    // Initialize
    updateProgress();

    // Set ngày hẹn tiêm tối thiểu là ngày mai cho tất cả input date
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowStr = tomorrow.toISOString().split('T')[0];
    document.querySelectorAll('.ngay-hen-input').forEach(function(input) {
        input.setAttribute("min", tomorrowStr);
    });

    console.log("Checkout page loaded successfully");
</script>
}
