    <script src="Scripts/bootstrap.bundle.min.js"></script>
    <script>
      let currentStep = 1;
      const totalSteps = 4;

      function updateProgress() {
        // Update progress line
        const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
        document.getElementById("progressLine").style.width = progress + "%";

        // Update step indicators
        document.querySelectorAll(".step").forEach((step, index) => {
          const stepNum = index + 1;
          if (stepNum < currentStep) {
            step.classList.add("completed");
            step.classList.remove("active");
          } else if (stepNum === currentStep) {
            step.classList.add("active");
            step.classList.remove("completed");
          } else {
            step.classList.remove("active", "completed");
          }
        });

        // Show/hide step content
        document.querySelectorAll(".step-content").forEach((content, index) => {
          if (index + 1 === currentStep) {
            content.classList.add("active");
          } else {
            content.classList.remove("active");
          }
        });

        // Scroll to top
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function nextStep() {
        // Validation for each step
        if (currentStep === 1) {
          const date = document.getElementById("appointmentDate").value;
          const time = document.getElementById("appointmentTime").value;
          const center = document.getElementById("center").value;

          if (!date || !time || !center) {
            alert("⚠️ Vui lòng chọn đầy đủ thông tin lịch hẹn!");
            return;
          }

          // Store values for confirmation
          document.getElementById("confirmDate").textContent = new Date(
            date
          ).toLocaleDateString("vi-VN");
          document.getElementById("confirmTime").textContent = time;
          document.getElementById("confirmCenter").textContent = center;
        }

        if (currentStep === 2) {
          const selectedPayment = document.querySelector(
            'input[name="payment"]:checked'
          );
          if (!selectedPayment) {
            alert("⚠️ Vui lòng chọn phương thức thanh toán!");
            return;
          }

          const paymentMethod = selectedPayment.closest(".payment-method");
          const paymentText = paymentMethod.querySelector("h6").textContent;
          document.getElementById("confirmPayment").textContent = paymentText;
        }

        if (currentStep < totalSteps) {
          currentStep++;
          updateProgress();
        }
      }

      function prevStep() {
        if (currentStep > 1) {
          currentStep--;
          updateProgress();
        }
      }

      function selectPayment(method) {
        document.querySelectorAll(".payment-method").forEach((pm) => {
          pm.classList.remove("selected");
        });

        const radioBtn = document.getElementById(`payment-${method}`);
        const selectedMethod = radioBtn.closest(".payment-method");
        selectedMethod.classList.add("selected");
        radioBtn.checked = true;
      }

      function confirmOrder() {
        const agreeTerms = document.getElementById("agreeTerms").checked;
        if (!agreeTerms) {
          alert("⚠️ Vui lòng đồng ý với điều khoản dịch vụ!");
          return;
        }

        // Simulate API call
        const btn = event.target;
        btn.disabled = true;
        btn.innerHTML =
          '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

        setTimeout(() => {
          nextStep();
          btn.disabled = false;
          btn.innerHTML =
            '<i class="fas fa-check-circle me-2"></i>Xác nhận đặt hẹn';
        }, 2000);
      }
