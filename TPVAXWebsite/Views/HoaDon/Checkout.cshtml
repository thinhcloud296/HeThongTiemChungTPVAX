                                <div class="col-md-6 mb-2">
                                    <strong>Ho ten:</strong> Tran Tan Tai
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>SDT:</strong> 0975088626
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Email:</strong> tantai@example.com
                                </div>
                                <div class="col-md-6 mb-2">
