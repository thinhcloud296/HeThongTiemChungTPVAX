                        <!-- MoMo -->
                        <div class="payment-method" onclick="selectPayment('momo')">
                            <div class="d-flex align-items-center">
                                <input type="radio" name="payment" id="payment-momo" class="me-3" />
                                <div class="flex-grow-1">
