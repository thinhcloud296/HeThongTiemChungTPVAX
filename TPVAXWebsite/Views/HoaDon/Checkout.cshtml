@model TPVAXWebsite.Models.ViewModels.GioHangViewModel
@{
    ViewBag.Title = "Thanh toan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
<style>
    /* Checkout Page - Professional Payment Flow */
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
    }

    .checkout-container {
        background: transparent;
        min-height: 100vh;
        padding: 30px 0;
    }

    .progress-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        position: relative;
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .progress-steps::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 60px;
        right: 60px;
        height: 4px;
        background: #e1e8ed;
        transform: translateY(-50%);
        z-index: 0;
    }

    .progress-line {
        position: absolute;
        top: 50%;
        left: 60px;
        height: 3px;
        background: #0077b6;
        transform: translateY(-50%);
        transition: width 0.5s ease;
        z-index: 1;
    }

    .step {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: white;
        padding: 10px;
        border-radius: 10px;
    }

    .step-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #e1e8ed;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 24px;
        margin-bottom: 12px;
        transition: all 0.4s;
        border: 4px solid transparent;
    }

    .step.active .step-circle {
        background: linear-gradient(135deg, #0077b6, #00b4d8);
        color: white;
        box-shadow: 0 0 0 8px rgba(0, 119, 182, 0.15);
        border-color: white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 8px rgba(0, 119, 182, 0.15);
        }
        50% {
            box-shadow: 0 0 0 12px rgba(0, 119, 182, 0.25);
        }
    }

    .step.completed .step-circle {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border-color: white;
    }

    .step-label {
        font-size: 14px;
        font-weight: 600;
        color: #6c757d;
        text-align: center;
    }

    .step.active .step-label {
        color: #0077b6;
    }

    .checkout-content {
        background: white;
        border-radius: 15px;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        padding: 40px;
        border: 1px solid #e9ecef;
    }

    .checkout-content h4 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 3px solid #0077b6;
    }

    .step-content {
        display: none;
    }

    .step-content.active {
        display: block;
        animation: fadeIn 0.5s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .info-card {
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .info-card.selected {
        border-color: #0077b6;
        background: #e7f3ff;
    }

    .payment-method {
        border: 2px solid #e1e8ed;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 15px;
        cursor: pointer;
        transition: all 0.3s;
        background: #fafbfc;
        position: relative;
    }

    .payment-method:hover {
        border-color: #0077b6;
        background: white;
        transform: translateX(5px);
        box-shadow: 0 4px 15px rgba(0, 119, 182, 0.15);
    }

    .payment-method.selected {
        border-color: #0077b6;
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        box-shadow: 0 4px 20px rgba(0, 119, 182, 0.2);
    }

    .payment-method.selected::after {
        content: "✓";
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        background: #0077b6;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
    }

    .payment-method input[type="radio"] {
        width: 20px;
        height: 20px;
    }

    .order-summary {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 15px;
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
        padding: 30px;
        position: sticky;
        top: 20px;
        border: 2px solid #e9ecef;
    }

    .order-summary h5 {
        color: #0077b6;
        font-weight: 700;
        border-bottom: 3px solid #0077b6;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e1e8ed;
    }

    .summary-item:last-child {
        border-bottom: none;
    }

    .summary-total {
        font-size: 24px;
        font-weight: 700;
        color: #0077b6;
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
        padding: 15px;
        border-radius: 10px;
        margin-top: 10px;
    }

    .success-icon {
        font-size: 80px;
        color: #28a745;
        animation: scaleIn 0.5s;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
        }
        to {
            transform: scale(1);
        }
    }
</style>
}

<!-- Back Button -->
<div class="container mt-3">
    <a href="@Url.Action("Index", "GioHang")" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-2"></i>Quay lai gio hang
