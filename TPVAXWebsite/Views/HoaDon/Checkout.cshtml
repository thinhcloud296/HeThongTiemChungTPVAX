            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="order-summary">
                    <h5 class="mb-4">
                        <i class="fas fa-receipt me-2"></i>Tom tat don hang
                    </h5>

                    @if (Model != null && Model.Items != null)
                    {
                        foreach (var item in Model.Items)
