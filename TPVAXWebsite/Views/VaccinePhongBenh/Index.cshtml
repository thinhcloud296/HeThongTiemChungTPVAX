@model IEnumerable<TPVAXWebsite.Models.Domain.Vaccine>
@{
    ViewBag.Title = "Danh Sách Vắc Xin Phòng Bệnh";
}

<section
  class="page-hero-banner"
  style="
    background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
    padding: 80px 0 60px;
  "
>
  <div class="container text-center text-white">
    <h1 style="font-size: 2.5rem; font-weight: 700; letter-spacing: 1px;">
      <i class="fas fa-syringe me-3"></i>Vắc Xin Phòng Bệnh
    </h1>
    <p style="font-size: 1.1rem; font-weight: 500;">
      Hệ thống vắc xin đầy đủ - Chất lượng cao - Giá cả hợp lý
    </p>
  </div>
</section>

<section class="stats-section py-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-syringe"></i>
          </div>
          <div class="stat-number" style="font-size: 2.2rem; font-weight: 700; color: #0077b6;">@(ViewBag.TotalCount ?? 0)+</div>
          <div class="stat-label" style="font-size: 0.9rem; color: #495057;">Loại Vắc Xin</div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-shield-alt"></i>
          </div>
          <div class="stat-number" style="font-size: 2.2rem; font-weight: 700; color: #0077b6;">100%</div>
          <div class="stat-label" style="font-size: 0.9rem; color: #495057;">Chất Lượng Đảm Bảo</div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-users"></i>
          </div>
          <div class="stat-number" style="font-size: 2.2rem; font-weight: 700; color: #0077b6;">50K+</div>
          <div class="stat-label" style="font-size: 0.9rem; color: #495057;">Khách Hàng Tin Dùng</div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-award"></i>
          </div>
          <div class="stat-number" style="font-size: 2.2rem; font-weight: 700; color: #0077b6;">15+</div>
          <div class="stat-label" style="font-size: 0.9rem; color: #495057;">Năm Kinh Nghiệm</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container my-5" id="vaccine-catalog" aria-labelledby="vaccine-catalog-heading">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-primary border-5">
    <h2 id="vaccine-catalog-heading" class="mb-0" style="font-size: 1.8rem; font-weight: 700; color: #0077b6;">
      <strong>DANH MỤC VẮC XIN PHÒNG BỆNH</strong>
    </h2>
  </div>

  <div class="filter-bar mb-5 p-4 rounded-3" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9f0f7 100%); border: 2px solid #dee2e6;">
    <div class="row g-3 align-items-end">
      <div class="col-lg-4 col-md-6">
        <label style="font-size: 0.95rem; font-weight: 600; color: #0077b6; margin-bottom: 8px; display: block;">
          <i class="fas fa-search me-2"></i>Tìm Kiếm Vắc Xin
        </label>
        <form method="get" action="@Url.Action("Index", "VaccinePhongBenh")">
          <div class="input-group" style="height: 44px;">
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="Nhập tên vắc xin..."
              value="@(ViewBag.Search ?? "")"
              style="border-radius: 8px 0 0 8px; font-size: 1rem; border: 2px solid #dee2e6;"
            />
            <button class="btn btn-primary" type="submit" style="border-radius: 0 8px 8px 0; padding: 0 24px; font-size: 1rem; font-weight: 600;">
              <i class="fas fa-search"></i> Tìm
            </button>
          </div>
        </form>
      </div>

      <div class="col-lg-4 col-md-6">
        <label style="font-size: 0.95rem; font-weight: 600; color: #0077b6; margin-bottom: 8px; display: block;">
          <i class="fas fa-shield-virus me-2"></i>Phòng Ngừa Bệnh
        </label>
        <form method="get" action="@Url.Action("Index", "VaccinePhongBenh")">
          <select name="loaiBenh" class="form-select" style="border-radius: 8px; padding: 10px 16px; border: 2px solid #dee2e6; font-size: 1rem; height: 44px;" onchange="this.form.submit()">
            <option value="">-- Tất cả loại bệnh --</option>
            @if (ViewBag.LoaiBenhs != null)
            {
                foreach (var loaiBenh in ViewBag.LoaiBenhs as IEnumerable<TPVAXWebsite.Models.Domain.LoaiBenh>)
                {
                    <option value="@loaiBenh.MaLoaiBenh" @(ViewBag.LoaiBenh == loaiBenh.MaLoaiBenh ? "selected" : "")>@loaiBenh.TenBenh</option>
                }
            }
          </select>
        </form>
      </div>

      <div class="col-lg-4 col-md-12">
        <a href="@Url.Action("Index", "VaccinePhongBenh")" class="btn btn-outline-primary w-100" style="border-radius: 8px; padding: 10px 24px; font-weight: 600; border-width: 2px; font-size: 1rem; height: 44px; display: flex; align-items: center; justify-content: center;">
          <i class="fas fa-redo me-2"></i>Đặt Lại Bộ Lọc
        </a>
      </div>
    </div>
  </div>

  <div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var vaccine in Model)
        {
            <div class="col-lg-4 col-md-6">
              <article class="product-card h-100">
                <a href="@Url.Action("Index", "Vaccine", new { id = vaccine.MaVC })" class="text-decoration-none">
                  <div class="position-relative">
                    <img
                      src="@Url.Content(string.IsNullOrEmpty(vaccine.HinhAnh) ? "~/Content/Assets/Images/default.png" : "~/Content/Images/Vaccines/" + vaccine.HinhAnh)"
                      alt="@vaccine.TenVC"
                      class="img-fluid mb-3 rounded"
                      style="width: 100%; height: 250px; object-fit: cover;"
                      loading="lazy"
                      onerror="this.src='@Url.Content("~/Content/Assets/Images/default.png")'"
                    />
                    <div
                      class="position-absolute top-0 start-0 m-2 px-2 py-1 bg-white bg-opacity-75 rounded d-flex align-items-center gap-1"
                    >
                      <img
                        src="@Url.Content("~/Content/Assets/Icons/flag/vietnam.png")"
                        alt="Cờ Việt Nam"
                        style="width: 20px"
                        loading="lazy"
                      />
                      <small class="text-muted fw-bold">@(vaccine.LoaiVaccine?.TenLoai ?? "Vắc xin")</small>
                    </div>
                  </div>
                  <div class="card-body px-0">
                    <h6 class="card-subtitle text-muted small mb-2">
                      @(vaccine.LoaiVaccine?.TenLoai ?? "Vaccine")
                    </h6>
                    <h3 class="card-title h5 mb-3">@vaccine.TenVC</h3>
                    <p class="text-warning fw-bold fs-4 mb-0 text-center">
                      @string.Format("{0:N0}₫", vaccine.GiaBan)
                      <small class="text-muted fs-6">/ liều</small>
                    </p>
                  </div>
                </a>
                <div class="d-flex gap-2 mt-3">
                  <a
                    href="@Url.Action("Index", "Vaccine", new { id = vaccine.MaVC })"
                    class="btn btn-primary flex-fill rounded-pill btn-addcart-custom-card"
                    aria-label="Chi tiết @vaccine.TenVC"
                    style="font-weight: 600;"
                  >
                    <i class="fas fa-info-circle me-1"></i> Chi tiết
                  </a>
                  <a
                    href="@Url.Action("DatLich", "LichTiem", new { maVC = vaccine.MaVC })"
                    class="btn btn-success flex-fill rounded-pill btn-price-custom-card"
                    aria-label="Đặt lịch tiêm @vaccine.TenVC"
                    style="font-weight: 600;"
                  >
                    <i class="fas fa-calendar-check me-1"></i> Đặt lịch
                  </a>
                </div>
              </article>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted">@(ViewBag.Error ?? "Chưa có dữ liệu vaccine")</p>
        </div>
    }
  </div>

    @* Pagination - Updated to match the "Mẹ và Bé" style and logic (only page numbers, max 5) *@
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        int currentPage = ViewBag.CurrentPage;
        int totalPages = ViewBag.TotalPages;
        // Bắt đầu từ 1, hoặc current - 2 (nhưng không nhỏ hơn 1)
        int startPage = Math.Max(1, currentPage - 2); 
        // Kết thúc ở totalPages, hoặc start + 4 (để có tối đa 5 số trang)
        int endPage = Math.Min(totalPages, startPage + 4); 

        // Điều chỉnh startPage nếu endPage bị cắt
        if (endPage - startPage < 4) {
            startPage = Math.Max(1, endPage - 4);
        }
        
        <div class="row mt-5">
            <div class="col-12 d-flex justify-content-center">
                <nav aria-label="Vaccine pagination">
                    <ul class="pagination">
                        
                        @* Hiển thị số trang *@
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                @if (i == currentPage)
                                {
                                    <span class="page-link">@i</span>
                                }
                                else
                                {
                                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, loaiBenh = ViewBag.LoaiBenh, page = i })#vaccine-catalog">@i</a>
                                }
                            </li>
                        }

                    </ul>
                </nav>
            </div>
            <div class="col-12 text-center mt-3">
                <p class="text-muted mb-0">
                    Trang <strong class="text-primary fs-5">@currentPage</strong> / <strong>@totalPages</strong>
                    <span class="mx-2">|</span>
                    Tổng cộng <strong class="text-success">@ViewBag.TotalCount</strong> vắc xin
                </p>
            </div>
        </div>
    }
  </div>
</section>

<section
  class="cta-section py-5"
  style="background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%)"
>
  <div class="container text-center text-white">
    <h2 class="fw-bold mb-3">Bạn chưa biết nên tiêm gì?</h2>
    <p class="lead mb-4">
      Liên hệ ngay với chúng tôi để được tư vấn miễn phí vắc xin phù hợp
      nhất cho bạn và gia đình
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="tel:0975088626" class="btn btn-warning btn-lg">
        <i class="fas fa-phone-alt me-2"></i>Gọi ngay: 0975 088 626
      </a>
      <a href="@Url.Action("Index", "ToiNenTiemGi")" class="btn btn-light btn-lg">
        <i class="fas fa-question-circle me-2"></i>Tôi nên tiêm gì?
      </a>
    </div>
  </div>
</section>

@section scripts {
<script>
    function addToCart(productId) {
        $.ajax({
            url: '@Url.Action("ThemVaoGio", "GioHang")',
            type: 'POST',
            data: { 
                MaSanPham: productId, 
                LoaiSanPham: 'VACCINE', 
                SoLuong: 1 
            },
            success: function (data) {
                if (data.success) {
                    $('.cart-count').text(data.cartCount);
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire('Lỗi', data.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi', 'Vui lòng đăng nhập để thêm vào giỏ hàng', 'error');
            }
        });
    }
</script>
}