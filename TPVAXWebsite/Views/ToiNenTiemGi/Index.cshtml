@model IEnumerable<TPVAXWebsite.Models.ViewModels.VaccineRecommendationViewModel>
@{
    ViewBag.Title = "Tôi Nên Tiêm Gì?";
}

<main>
    <!-- Hero -->
    <section class="advice-consult-hero text-start">
        <div class="container position-relative">
            <img src="@Url.Content("~/Content/Assets/Images/tntg.jpg")"
                 alt="Bác sĩ tư vấn"
                 class="hero-image d-none d-lg-block" />
            <div class="row">
                <div class="col-lg-6 py-5">
                    <nav aria-label="breadcrumb" class="mb-1">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index","Home")" class="text-secondary">Trang chủ</a>
                            </li>
                            <li class="breadcrumb-item active text-primary" aria-current="page">
                                Tôi nên tiêm gì?
                            </li>
                        </ol>
                    </nav>
                    <h1 class="fw-bold hero-title">Tôi nên tiêm gì?</h1>
                    <p class="lead hero-subtitle">
                        Chọn thông tin và nhận đề xuất các vắc xin cần tiêm
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Filter Form -->
    <section class="container filter-block mt-4">
        <form method="get" action="@Url.Action("Index", "ToiNenTiemGi")" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="searchInput" class="form-label fw-bold">Tìm kiếm vaccine</label>
                <input type="text" class="form-control form-control-lg" id="searchInput" name="search" 
                       placeholder="Nhập tên vaccine..." value="@(ViewBag.Search ?? "")" />
            </div>

            <div class="col-md-4">
                <label for="loaiVaccineSelect" class="form-label fw-bold">Loại vaccine (Đối tượng)</label>
                <select class="form-select form-select-lg" id="loaiVaccineSelect" name="loaiVaccine">
                    <option value="">-- Tất cả loại --</option>
                    @if (ViewBag.LoaiVaccines != null)
                    {
                        foreach (var lv in ViewBag.LoaiVaccines as IEnumerable<TPVAXWebsite.Models.Domain.LoaiVaccine>)
                        {
                            <option value="@lv.MaLoai" @(ViewBag.LoaiVaccine == lv.MaLoai ? "selected" : "")>@lv.TenLoai</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label for="loaiBenhSelect" class="form-label fw-bold">Phòng ngừa bệnh</label>
                <select class="form-select form-select-lg" id="loaiBenhSelect" name="loaiBenh">
                    <option value="">-- Tất cả bệnh --</option>
                    @if (ViewBag.LoaiBenhs != null)
                    {
                        foreach (var lb in ViewBag.LoaiBenhs as IEnumerable<TPVAXWebsite.Models.Domain.LoaiBenh>)
                        {
                            <option value="@lb.MaLoaiBenh" @(ViewBag.LoaiBenh == lb.MaLoaiBenh ? "selected" : "")>@lb.TenBenh</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="fas fa-search me-2"></i>Tìm kiếm
                </button>
            </div>
            
            <div class="col-md-6">
                <a href="@Url.Action("Index", "ToiNenTiemGi")" class="btn btn-outline-secondary btn-lg w-100">
                    <i class="fas fa-redo me-2"></i>Đặt lại
                </a>
            </div>
        </form>
    </section>

    <!-- Results -->
    @if (Model != null && Model.Any())
    {
        <section class="advice-section row g-4 mt-5">
            <div class="col-12">
                <h2 class="section-title fw-bold">
                    <i class="fas fa-syringe section-title-icon me-2"></i>
                    Kết quả tìm kiếm (@Model.Count() vaccine)
                </h2>
            </div>

            @foreach (var vaccine in Model)
            {
                <div class="col-lg-4">
                    <div class="card h-100">
                        <img src="@Url.Content("~/Content/Images/Vaccines/" + vaccine.HinhAnh)"
                             class="card-img-top" alt="@vaccine.TenVC"
                             style="height: 250px; object-fit: cover;"
                             onerror="this.src='@Url.Content("~/Content/Assets/Images/default.png")'"
                             loading="lazy" />
                        <div class="card-body">
                            <h5 class="card-title">@vaccine.TenVC</h5>
                            <p class="card-text">@vaccine.MoTa</p>
                            <p class="fw-bold text-warning fs-4 mb-3">@vaccine.GiaBan.ToString("N0")₫ <small class="text-muted fs-6">/ liều</small></p>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Detail", "ToiNenTiemGi", new { id = vaccine.MaVC })"
                                   class="btn btn-primary flex-fill rounded-pill btn-addcart-custom-card"
                                   style="font-weight: 600;">
                                    <i class="fas fa-info-circle me-1"></i> Chi tiết
                                </a>
                                <a href="@Url.Action("DatLich", "LichTiem", new { maVC = vaccine.MaVC })"
                                   class="btn btn-success flex-fill rounded-pill btn-price-custom-card"
                                   style="font-weight: 600;">
                                    <i class="fas fa-calendar-check me-1"></i> Đặt lịch
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </section>
    }
    else if (!string.IsNullOrEmpty(ViewBag.LoaiVaccine as string) || !string.IsNullOrEmpty(ViewBag.LoaiBenh as string) || !string.IsNullOrEmpty(ViewBag.Search as string))
    {
        <div class="alert alert-info mt-4" role="alert">
            <i class="fas fa-info-circle me-2"></i>Không tìm thấy vaccine phù hợp với lựa chọn của bạn. Vui lòng thử lại với bộ lọc khác.
        </div>
    }
    else
    {
        <div class="alert alert-primary mt-4" role="alert">
            <i class="fas fa-hand-point-up me-2"></i>Vui lòng chọn bộ lọc phía trên để tìm vaccine phù hợp với bạn.
        </div>
    }
</main>
