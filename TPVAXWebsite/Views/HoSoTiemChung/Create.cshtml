@model TPVAXWebsite.Models.ViewModels.CreateHoSoViewModel

@{
    ViewBag.Title = "Thêm người thân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i>Thêm Hồ Sơ Người Thân</h4>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-light border-start border-5 border-primary mb-4">
                        <strong>Mẹo:</strong> Nếu người thân đã từng tiêm chủng tại hệ thống, hãy nhập chính xác <strong>CCCD/Mã định danh</strong> để hệ thống tự động tìm và liên kết hồ sơ cũ.
                    </div>

                    @using (Html.BeginForm("Create", "HoSoTiemChung", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.HoTen, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "VD: Nguyễn Văn B" })
                                @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.QuanHe, new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.QuanHe,
                                    new SelectList(new[] { "Con", "Vợ", "Chồng", "Bố", "Mẹ", "Ông", "Bà", "Khác" }),
                                    "-- Chọn quan hệ --",
                                    new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.QuanHe, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.NgaySinh, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.GioiTinh, new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.GioiTinh,
                                    new SelectList(new[] { "Nam", "Nữ" }),
                                    "Chọn giới tính",
                                    new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CCCD, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CCCD, new { @class = "form-control", placeholder = "Nhập CCCD để liên kết (Bỏ trống nếu là trẻ nhỏ chưa có)" })
                            @Html.ValidationMessageFor(m => m.CCCD, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.GhiChu, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = "2", placeholder = "Tiền sử bệnh, dị ứng..." })
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a href="@Url.Action("DatLich", "LichTiem")" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Lưu hồ sơ
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}