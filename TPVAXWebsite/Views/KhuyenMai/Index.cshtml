                <img src="@Url.Content("~/Content/Assets/Images/hexaxim.png")" alt="Khuyến mãi 5">
                <span class="badge-hot-new">HOT</span>
                <span class="badge-discount-new">2TR</span>
              </div>
              <div class="card-body-new">
                <span class="card-tag card-tag-red"><i class="fas fa-gift me-2"></i>Ưu đãi lớn</span>
