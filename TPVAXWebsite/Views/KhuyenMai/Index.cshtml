    <!-- CTA Section -->
    <section class="cta-section-modern">
      <div class="container">
        <div class="cta-box-modern">
          <div class="row align-items-center">
            <div class="col-lg-8">
              <div class="cta-icon-large"><i class="fas fa-bell"></i></div>
              <h2 class="cta-title-large">Đăng ký nhận thông báo khuyến mãi</h2>
              <p class="cta-desc-large">Đừng bỏ lỡ các chương trình ưu đãi hấp dẫn! Đăng ký ngay để nhận thông báo sớm nhất về các khuyến mãi HOT từ TPVAX.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
              <a href="@Url.Action("Register", "Account")" class="btn-cta-large-new"><i class="fas fa-user-plus me-2"></i>Đăng ký ngay</a>
