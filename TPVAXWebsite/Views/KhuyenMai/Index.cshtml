@model IEnumerable<TPVAXWebsite.Models.Domain.KhuyenMai>
@{
    ViewBag.Title = "Khuyến Mãi HOT - Ưu Đãi Đặc Biệt";
    int totalPromotions = ViewBag.TotalCount ?? 0;
    int activePromotions = ViewBag.ActivePromotions ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var activeList = ViewBag.ActiveList as IEnumerable<TPVAXWebsite.Models.Domain.KhuyenMai>;
    var upcomingList = ViewBag.UpcomingList as IEnumerable<TPVAXWebsite.Models.Domain.KhuyenMai>;
}

<!-- Hero Section -->
    <section class="promo-hero-modern">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <nav aria-label="breadcrumb" class="mb-3">
              <ol class="breadcrumb breadcrumb-modern">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item active">Khuyến mãi HOT</li>
              </ol>
            </nav>
            <h1 class="hero-title"><i class="fas fa-gift me-3"></i>Khuyến Mãi HOT</h1>
            <p class="hero-subtitle">Nhận ngay các ưu đãi hấp dẫn khi tiêm chủng tại TPVAX. Tiết kiệm chi phí, bảo vệ sức khỏe toàn diện!</p>
            <div class="stats-row">
              <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-tags"></i></div>
                <div><div class="stat-num">@totalPromotions+</div><div class="stat-label">Chương trình</div></div>
              </div>
              <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                <div><div class="stat-num">@activePromotions</div><div class="stat-label">Đang diễn ra</div></div>
              </div>
              <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div><div class="stat-num">Hàng tuần</div><div class="stat-label">Cập nhật</div></div>
              </div>
            </div>
          </div>
          <div class="col-lg-6 d-none d-lg-block">
            <img src="@Url.Content("~/Content/Assets/Images/hexaxim.png")" alt="Khuyến mãi" class="img-fluid hero-img-float">
          </div>
        </div>
      </div>
    </section>

    <!-- Filter Section -->
    <section class="container my-4">
        <div class="filter-bar mb-4 p-4 rounded-3" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9f0f7 100%); border: 2px solid #dee2e6;">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label style="font-size: 0.95rem; font-weight: 600; color: #0077b6; margin-bottom: 8px; display: block;">
                        <i class="fas fa-search me-2"></i>Tìm Kiếm Khuyến Mãi
                    </label>
                    <form method="get" action="@Url.Action("Index", "KhuyenMai")">
                        <div class="input-group" style="height: 44px;">
                            <input type="text" name="search" class="form-control" placeholder="Nhập tên khuyến mãi..." value="@(ViewBag.Search ?? "")" style="border-radius: 8px 0 0 8px; font-size: 1rem; border: 2px solid #dee2e6;" />
                            <button class="btn btn-primary" type="submit" style="border-radius: 0 8px 8px 0; padding: 0 24px; font-size: 1rem; font-weight: 600;">
                                <i class="fas fa-search"></i> Tìm
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label style="font-size: 0.95rem; font-weight: 600; color: #0077b6; margin-bottom: 8px; display: block;">
                        <i class="fas fa-tag me-2"></i>Loại Khuyến Mãi
                    </label>
                    <form method="get" action="@Url.Action("Index", "KhuyenMai")">
                        <select name="loaiKM" class="form-select" style="border-radius: 8px; padding: 10px 16px; border: 2px solid #dee2e6; font-size: 1rem; height: 44px;" onchange="this.form.submit()">
                            <option value="">-- Tất cả loại --</option>
                            <option value="Sự kiện" @(ViewBag.LoaiKM == "Sự kiện" ? "selected" : "")>Sự kiện</option>
                            <option value="Quà tặng" @(ViewBag.LoaiKM == "Quà tặng" ? "selected" : "")>Quà tặng</option>
                            <option value="Voucher" @(ViewBag.LoaiKM == "Voucher" ? "selected" : "")>Voucher</option>
                            <option value="Giảm giá" @(ViewBag.LoaiKM == "Giảm giá" ? "selected" : "")>Giảm giá</option>
                        </select>
                    </form>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label style="font-size: 0.95rem; font-weight: 600; color: #0077b6; margin-bottom: 8px; display: block;">
                        <i class="fas fa-filter me-2"></i>Trạng Thái
                    </label>
                    <form method="get" action="@Url.Action("Index", "KhuyenMai")">
                        <select name="trangThai" class="form-select" style="border-radius: 8px; padding: 10px 16px; border: 2px solid #dee2e6; font-size: 1rem; height: 44px;" onchange="this.form.submit()">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="Đang diễn ra" @(ViewBag.TrangThai == "Đang diễn ra" ? "selected" : "")>Đang diễn ra</option>
                            <option value="Sắp diễn ra" @(ViewBag.TrangThai == "Sắp diễn ra" ? "selected" : "")>Sắp diễn ra</option>
                            <option value="Đã hết hạn" @(ViewBag.TrangThai == "Đã hết hạn" ? "selected" : "")>Đã hết hạn</option>
                        </select>
                    </form>
                </div>
                <div class="col-lg-2 col-md-6">
                    <a href="@Url.Action("Index", "KhuyenMai")" class="btn btn-outline-primary w-100" style="border-radius: 8px; padding: 10px 24px; font-weight: 600; border-width: 2px; font-size: 1rem; height: 44px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-redo me-2"></i>Đặt Lại
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Promo Cards Section -->
    <section class="promo-cards-section">
      <div class="container">
        <div class="text-center mb-5">
          <h2 class="section-title-modern">Chương Trình Ưu Đãi</h2>
          <p class="section-subtitle-modern">Khám phá các khuyến mãi đặc biệt dành cho bạn</p>
        </div>

        <div class="row g-4">
          @if (Model != null && Model.Any())
          {
              foreach (var km in Model)
              {
                  var today = DateTime.Now.Date;
                  bool isActive = km.TrangThai && km.NgayBatDau <= today && km.NgayKetThuc >= today;
                  bool isUpcoming = km.TrangThai && km.NgayBatDau > today;
                  bool isExpired = km.NgayKetThuc < today;
                  int daysLeft = (km.NgayKetThuc - today).Days;
                  
                  string badgeClass = "";
                  string tagClass = "card-tag";
                  string tagIcon = "fas fa-gift";
                  
                  if (!string.IsNullOrEmpty(km.LoaiKM))
                  {
                      switch (km.LoaiKM)
                      {
                          case "Sự kiện": tagClass = "card-tag"; tagIcon = "fas fa-calendar-alt"; break;
                          case "Quà tặng": tagClass = "card-tag card-tag-green"; tagIcon = "fas fa-gift"; break;
                          case "Voucher": tagClass = "card-tag card-tag-orange"; tagIcon = "fas fa-ticket-alt"; break;
                          case "Giảm giá": tagClass = "card-tag card-tag-red"; tagIcon = "fas fa-percent"; break;
                          default: tagClass = "card-tag"; tagIcon = "fas fa-tag"; break;
                      }
                  }
                  
                  <div class="col-lg-4 col-md-6">
                      <div class="promo-card-new">
                          <div class="card-img-wrapper">
                              @{
                                  var imagePath = !string.IsNullOrEmpty(km.HinhAnh) 
                                      ? Url.Content("~/Content/Images/KhuyenMai/" + km.HinhAnh)
                                      : Url.Content("~/Content/Assets/Images/hexaxim.png");
                              }
                              <img src="@imagePath" 
                                   alt="@km.TenKM"
                                   onerror="this.src='@Url.Content("~/Content/Assets/Images/hexaxim.png")'"
                                   style="width: 100%; height: 200px; object-fit: cover;">
                              @if (isActive && daysLeft <= 7)
                              {
                                  <span class="badge-hot-new">HOT</span>
                              }
                              @if (isUpcoming)
                              {
                                  <span class="badge-new-label">MỚI</span>
                              }
                              @if (km.GiaTriGiam > 0)
                              {
                                  <span class="badge-discount-new">
                                      @if (km.KieuGiam == "Phần trăm" || km.KieuGiam == "%")
                                      {
                                          @:-@km.GiaTriGiam%
                                      }
                                      else
                                      {
                                          @:@string.Format("{0:N0}₫", km.GiaTriGiam)
                                      }
                                  </span>
                              }
                          </div>
                          <div class="card-body-new">
                              <span class="@tagClass"><i class="@tagIcon me-2"></i>@(km.LoaiKM ?? "Khuyến mãi")</span>
                              <h3 class="card-title-new">@km.TenKM</h3>
                              <p class="card-desc-new">
                                  @if (!string.IsNullOrEmpty(km.MoTa))
                                  {
                                      @(km.MoTa.Length > 120 ? km.MoTa.Substring(0, 120) + "..." : km.MoTa)
                                  }
                                  else
                                  {
                                      @:Chương trình khuyến mãi đặc biệt từ TPVAX
                                  }
                              </p>
                              <div class="card-footer-new">
                                  <span class="card-date">
                                      <i class="far fa-calendar me-2"></i>
                                      @if (isExpired)
                                      {
                                          <span class="text-danger">Đã hết hạn</span>
                                      }
                                      else if (isActive)
                                      {
                                          @:Còn @daysLeft ngày
                                      }
                                      else if (isUpcoming)
                                      {
                                          @:Từ @km.NgayBatDau.ToString("dd/MM/yyyy")
                                      }
                                      else
                                      {
                                          @:Đến @km.NgayKetThuc.ToString("dd/MM/yyyy")
                                      }
                                  </span>
                                  <a href="@Url.Action("Detail", "KhuyenMai", new { id = km.MaKM })" class="btn-detail-new">
                                      Chi tiết <i class="fas fa-arrow-right ms-2"></i>
                                  </a>
                              </div>
                          </div>
                      </div>
                  </div>
              }
          }
          else
          {
              <div class="col-12 text-center py-5">
                  <i class="fas fa-tag fs-1 text-muted mb-3"></i>
                  <p class="text-muted">@(ViewBag.Error ?? "Chưa có chương trình khuyến mãi nào")</p>
              </div>
          }

        </div>

        @* Pagination *@
        @if (totalPages > 1)
        {
            <div class="row mt-5">
                <div class="col-12">
                    <nav aria-label="Pagination">
                        <ul class="pagination justify-content-center pagination-lg">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, loaiKM = ViewBag.LoaiKM, trangThai = ViewBag.TrangThai, page = 1 })">
                                        <i class="fas fa-angle-double-left"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, loaiKM = ViewBag.LoaiKM, trangThai = ViewBag.TrangThai, page = currentPage - 1 })">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, loaiKM = ViewBag.LoaiKM, trangThai = ViewBag.TrangThai, page = i })">@i</a>
                                </li>
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, loaiKM = ViewBag.LoaiKM, trangThai = ViewBag.TrangThai, page = currentPage + 1 })">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, loaiKM = ViewBag.LoaiKM, trangThai = ViewBag.TrangThai, page = totalPages })">
                                        <i class="fas fa-angle-double-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                    <div class="text-center mt-3">
                        <p class="text-muted">
                            Trang <strong class="text-primary fs-5">@currentPage</strong> / <strong>@totalPages</strong>
                            <span class="mx-2">|</span>
                            Tổng cộng <strong class="text-success">@totalPromotions</strong> chương trình
                        </p>
                    </div>
                </div>
            </div>
        }
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section-modern">
      <div class="container">
        <div class="cta-box-modern">
          <div class="row align-items-center">
            <div class="col-lg-8">
              <div class="cta-icon-large"><i class="fas fa-bell"></i></div>
              <h2 class="cta-title-large">Đăng ký nhận thông báo khuyến mãi</h2>
              <p class="cta-desc-large">Đừng bỏ lỡ các chương trình ưu đãi hấp dẫn! Đăng ký ngay để nhận thông báo sớm nhất về các khuyến mãi HOT từ TPVAX.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
              <a href="@Url.Action("Register", "Account")" class="btn-cta-large-new"><i class="fas fa-user-plus me-2"></i>Đăng ký ngay</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
