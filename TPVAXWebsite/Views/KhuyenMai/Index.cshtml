@model IEnumerable<TPVAXWebsite.Models.Domain.KhuyenMai>
@{
    ViewBag.Title = "Khuyến Mãi HOT - Ưu Đãi Đặc Biệt";
}

<!-- Hero Section -->
    <section class="promo-hero-modern">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <nav aria-label="breadcrumb" class="mb-3">
              <ol class="breadcrumb breadcrumb-modern">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item active">Khuyến mãi HOT</li>
              </ol>
            </nav>
            <h1 class="hero-title"><i class="fas fa-gift me-3"></i>Khuyến Mãi HOT</h1>
            <p class="hero-subtitle">Nhận ngay các ưu đãi hấp dẫn khi tiêm chủng tại TPVAX. Tiết kiệm chi phí, bảo vệ sức khỏe toàn diện!</p>
            <div class="stats-row">
              <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-tags"></i></div>
                <div><div class="stat-num">8+</div><div class="stat-label">Chương trình</div></div>
              </div>
              <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-percent"></i></div>
                <div><div class="stat-num">40%</div><div class="stat-label">Giảm tối đa</div></div>
              </div>
              <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div><div class="stat-num">Hàng tuần</div><div class="stat-label">Cập nhật</div></div>
              </div>
            </div>
          </div>
          <div class="col-lg-6 d-none d-lg-block">
            <img src="@Url.Content("~/Content/Assets/Images/hexaxim.png")" alt="Khuyến mãi" class="img-fluid hero-img-float">
          </div>
        </div>
      </div>
    </section>

    <!-- Promo Cards Section -->
    <section class="promo-cards-section">
      <div class="container">
        <div class="text-center mb-5">
          <h2 class="section-title-modern">Chương Trình Ưu Đãi</h2>
          <p class="section-subtitle-modern">Khám phá các khuyến mãi đặc biệt dành cho bạn</p>
        </div>

        <div class="row g-4">
          <!-- Card 1 -->
          <div class="col-lg-4 col-md-6">
            <div class="promo-card-new">
              <div class="card-img-wrapper">
                <img src="@Url.Content("~/Content/Assets/Images/hexaxim.png")" alt="Khuyến mãi 1">
                <span class="badge-hot-new">HOT</span>
                <span class="badge-discount-new">-30%</span>
              </div>
              <div class="card-body-new">
                <span class="card-tag"><i class="fas fa-gift me-2"></i>Sự kiện</span>
                <h3 class="card-title-new">Mừng khai trương chi nhánh Hải Phòng</h3>
                <p class="card-desc-new">Nhân dịp khai trương chi nhánh mới tại Hải Phòng, TPVAX triển khai chương trình ưu đãi đặc biệt với mức giảm giá lên đến 30%.</p>
                <div class="card-footer-new">
                  <span class="card-date"><i class="far fa-calendar me-2"></i>Đến 31/12/2025</span>
                  <a href="@Url.Action("Detail", "BaiViet", new { slug = "km-doi-qua-hai-phong" })" class="btn-detail-new">Chi tiết <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="col-lg-4 col-md-6">
            <div class="promo-card-new">
              <div class="card-img-wrapper">
                <img src="@Url.Content("~/Content/Assets/Images/hexaxim.png")" alt="Khuyến mãi 2">
                <span class="badge-new-label">MỚI</span>
              </div>
              <div class="card-body-new">
                <span class="card-tag card-tag-green"><i class="fas fa-gift me-2"></i>Quà tặng</span>
                <h3 class="card-title-new">Gối dưỡng da cao cấp khi tiêm vaccine</h3>
                <p class="card-desc-new">Tặng ngay gối dưỡng da cao cấp trị giá 500.000đ cho khách hàng tiêm từ 2 mũi vaccine trở lên. Số lượng có hạn!</p>
                <div class="card-footer-new">
                  <span class="card-date"><i class="far fa-calendar me-2"></i>Đến 30/11/2025</span>
                  <a href="@Url.Action("Detail", "BaiViet", new { slug = "km-goi-duong-da" })" class="btn-detail-new">Chi tiết <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
