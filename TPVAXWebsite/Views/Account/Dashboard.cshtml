@model TPVAXWebsite.Models.ViewModels.DashboardViewModel


@{
    ViewBag.Title = "Dashboard - Tài Khoản Của Tôi";
}

@section styles {
    <style>
        .dashboard-container {
            background: #f8f9fa;
            min-height: 100vh;
            padding: 30px 0;
        }

        .sidebar-menu {
            background: white;
            border-radius: 15px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
            padding: 0;
            overflow: hidden;
        }

            .sidebar-menu .user-profile {
                background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
                color: white;
                padding: 25px;
                text-align: center;
            }

        .user-profile .avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 4px solid white;
            margin: 0 auto 15px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: #0077b6;
        }

        .sidebar-menu .menu-item {
            padding: 15px 25px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #333;
            text-decoration: none;
        }

            .sidebar-menu .menu-item:hover {
                background: #f8f9fa;
                color: #0077b6;
            }

            .sidebar-menu .menu-item.active {
                background: #e7f3ff;
                color: #0077b6;
                font-weight: 600;
                border-left: 4px solid #0077b6;
            }

            .sidebar-menu .menu-item i {
                width: 25px;
                font-size: 18px;
            }

        .dashboard-content {
            background: white;
            border-radius: 15px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
            padding: 30px;
        }

        .stats-card {
            background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
            color: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,119,182,0.2);
        }

            .stats-card .icon {
                font-size: 40px;
                opacity: 0.9;
            }

            .stats-card .number {
                font-size: 32px;
                font-weight: 700;
                margin: 10px 0 5px;
            }

        .upcoming-appointment {
            border: 2px solid #e1e8ed;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }

            .upcoming-appointment:hover {
                border-color: #0077b6;
                box-shadow: 0 4px 12px rgba(0,119,182,0.1);
            }

        .profile-card {
            border: 2px solid #e1e8ed;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .profile-card .profile-avatar {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: #e7f3ff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                color: #0077b6;
            }

        .badge-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-pending {
            background: #fff3cd;
            color: #856404;
        }

        .badge-completed {
            background: #d4edda;
            color: #155724;
        }

        .badge-cancelled {
            background: #f8d7da;
            color: #721c24;
        }

        .timeline-item {
            position: relative;
            padding-left: 40px;
            padding-bottom: 30px;
        }

            .timeline-item::before {
                content: "";
                position: absolute;
                left: 10px;
                top: 10px;
                bottom: -10px;
                width: 2px;
                background: #e1e8ed;
            }

            .timeline-item:last-child::before {
                display: none;
            }

            .timeline-item .timeline-icon {
                position: absolute;
                left: 0;
                top: 5px;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: #0077b6;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
            }

        .quick-action-btn {
            background: white;
            border: 2px solid #0077b6;
            color: #0077b6;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

            .quick-action-btn:hover {
                background: #0077b6;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0,119,182,0.3);
            }
    </style>
}

<!-- Back to Home -->
<div class="container mt-3">
    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
        <i class="fas fa-arrow-left me-2"></i>Về trang chủ
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'success',
                title: 'Thành công!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                confirmButtonColor: '#0077b6'
            });
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi!',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#dc3545'
            });
        });
    </script>
}

@if (TempData["ThongBao"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'info',
                title: 'Thông báo',
                text: '@TempData["ThongBao"]',
                confirmButtonColor: '#0077b6'
            });
        });
    </script>
}

<!-- Dashboard Container -->
<div class="dashboard-container">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                <div class="sidebar-menu">
                    <!-- User Profile -->
                    <div class="user-profile">
                        <div class="avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <h5 class="mb-1">@Model.KhachHang.HoTen</h5>
                        <p class="mb-0 small opacity-75">@Model.KhachHang.Email</p>
                    </div>


                    <!-- Menu Items -->
                    <a href="#overview"
                       class="menu-item active"
                       data-section="overview">
                        <i class="fas fa-th-large"></i>
                        <span>Tổng quan</span>
                    </a>
                    <a href="#profiles" class="menu-item" data-section="profiles">
                        <i class="fas fa-users"></i>
                        <span>Hồ sơ tiêm chủng</span>
                    </a>
                    <a href="#vaccination-book"
                       class="menu-item"
                       data-section="vaccination-book">
                        <i class="fas fa-book-medical"></i>
                        <span>Sổ tiêm chủng</span>
                    </a>
                    <a href="#appointments"
                       class="menu-item"
                       data-section="appointments">
                        <i class="fas fa-calendar-check"></i>
                        <span>Lịch hẹn của tôi</span>
                    </a>
                    <a href="#invoices" class="menu-item" data-section="invoices">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <span>Hóa đơn</span>
                    </a>
                    <a href="#vouchers" class="menu-item" data-section="vouchers">
                        <i class="fas fa-gift"></i>
                        <span>Voucher & Ưu đãi</span>
                    </a>
                    <a href="#account-settings"
                       class="menu-item"
                       data-section="account-settings">
                        <i class="fas fa-cog"></i>
                        <span>Cài đặt tài khoản</span>
                    </a>
                    <a href="@Url.Action("Logout", "Account")"
                       class="menu-item"
                       style="color: #dc3545">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Đăng xuất</span>
                    </a>

                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- Overview Section -->
                <div id="section-overview"
                     class="dashboard-content section-content">
                    <h3 class="mb-4">
                        <i class="fas fa-th-large me-2 text-primary"></i>Tổng quan
                    </h3>

                    <!-- Stats Cards -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="stats-card">
                                <div class="icon"><i class="fas fa-users"></i></div>
                                <div class="number">@Model.HoSoTiemChungs.Count</div>
                                <div class="label">Hồ sơ tiêm chủng</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-card"
                                 style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%)">
                                <div class="icon"><i class="fas fa-syringe"></i></div>
                                <div class="number">@Model.SoMuiHoanThanh</div>
                                <div class="label">Mũi tiêm hoàn thành</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-card"
                                 style="background: linear-gradient(135deg, #ffc107 0%, #ffab00 100%)">
                                <div class="icon"><i class="fas fa-calendar-alt"></i></div>
                                <div class="number">@Model.LichHenSapToi.Count</div>
                                <div class="label">Lịch hẹn sắp tới</div>
                            </div>
                        </div>
                    </div>

                    <!-- Upcoming Appointments -->
                    <div class="mt-4">
                        <h5 class="mb-3">
                            <i class="fas fa-calendar-check me-2 text-primary"></i>Lịch hẹn sắp tới
                        </h5>

                        @if (Model.LichHenSapToi.Any())
                        {
                            foreach (var lich in Model.LichHenSapToi)
                            {
                                <div class="upcoming-appointment mb-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-2 text-primary">
                                                Vaccine @lich.Vaccine.TenVC - Mũi @lich.SoMui
                                            </h6>
                                            <p class="mb-1">
                                                <i class="fas fa-user me-2"></i>Người tiêm:
                                                <strong>@lich.HoSoTiemChung.HoTen</strong>
                                            </p>
                                            <p class="mb-1">
                                                <i class="fas fa-calendar me-2"></i>Ngày:
                                                <strong>@lich.NgayHenTiem.ToString("dd/MM/yyyy - HH:mm")</strong>
                                            </p>
                                        </div>
                                        <span class="badge-status badge-pending">Chưa tiêm</span>
                                        @* nút đổi lịch và hủy lịch *@
                                    </div>
                                    <div class="mt-3">
                                        <!-- Nút đổi lịch: khi bấm sẽ hiện date picker -->
                                        <button type="button" class="btn btn-primary btn-sm me-2"
                                                onclick="showDatePicker('@lich.MaLT')">
                                            <i class="fas fa-edit me-1"></i>Đổi lịch
                                        </button>

                                        <!-- Date picker: ẩn mặc định, hiện khi bấm nút -->
                                        <input type="datetime-local" id="picker-@lich.MaLT" style="display:none;"
                                               min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm")"
                                               onchange="updateSchedule('@lich.MaLT')" />

                                        <!-- Nút hủy: gọi action đổi trạng thái -->
                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                onclick="cancelSchedule('@lich.MaLT')">
                                            <i class="fas fa-times me-1"></i>Hủy
                                        </button>
                                    </div>
                                </div>

                            }
                        }
                        else
                        {
                            <p class="text-muted">Không có lịch hẹn nào sắp tới.</p>
                        }
                    </div>

                    <!-- Quick Actions -->
                    <div class="mt-4">
                        <h5 class="mb-3">
                            <i class="fas fa-bolt me-2 text-primary"></i>Thao tác nhanh
                        </h5>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="@Url.Action("Index", "VaccinePhongBenh")" class="quick-action-btn">
                                <i class="fas fa-plus-circle me-2"></i>Đặt lịch mới
                            </a>
                            <a href="#profiles"
                               class="quick-action-btn"
                               onclick="switchSection('profiles')">
                                <i class="fas fa-user-plus me-2"></i>Thêm hồ sơ
                            </a>
                            <a href="#vaccination-book"
                               class="quick-action-btn"
                               onclick="switchSection('vaccination-book')">
                                <i class="fas fa-download me-2"></i>Tải sổ tiêm
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Profiles Section -->
                <div id="section-profiles"
                     class="dashboard-content section-content"
                     style="display: none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3>
                            <i class="fas fa-users me-2 text-primary"></i>Hồ sơ tiêm chủng
                        </h3>
                        <button class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#addProfileModal">
                            <i class="fas fa-plus me-2"></i>Thêm hồ sơ mới
                        </button>
                    </div>

                    <!-- Vai trò của chủ tài khoản -->
                    <div class="mb-3">
                        <strong>Vai trò của bạn:</strong>
                        <span class="badge bg-info">@ViewBag.VaiTroChinh</span>
                    </div>

                    <!-- Profile Cards động -->
                    @foreach (var hoSo in Model.HoSoTiemChungs)
                    {
                        var soMuiDaTiem = Model.LichHenSapToi.Count(l => l.MaHSTC == hoSo.MaHSTC && l.TrangThai == "Đã tiêm");

                        <div class="profile-card">
                            <div class="profile-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1">@hoSo.HoTen</h6>
                                <p class="mb-0 text-muted small">
                                    <i class="fas fa-birthday-cake me-1"></i>@hoSo.NgaySinh.ToString("dd/MM/yyyy") |
                                    <i class="fas fa-venus-mars ms-2 me-1"></i>@hoSo.GioiTinh |
                                    <i class="fas fa-syringe ms-2 me-1"></i>@soMuiDaTiem mũi đã tiêm
                                </p>
                            </div>
                            <div>
                                <a class="btn btn-sm btn-outline-primary me-1"
                                   href="@Url.Action("SoTiemChung", "HoSo", new { maHSTC = hoSo.MaHSTC })">
                                    <i class="fas fa-book-medical"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editProfileModal"
                                        onclick="loadHoSoVaoModal('@hoSo.MaHSTC', '@hoSo.HoTen', '@hoSo.GioiTinh', '@hoSo.NgaySinh.ToString("yyyy-MM-dd")', '@hoSo.CCCD', '@hoSo.GhiChu')">
                                    <i class="fas fa-edit"></i>
                                </button>

                            </div>
                        </div>
                    }
                </div>




                <!-- Vaccination Book Section -->
                <div id="section-vaccination-book"
                     class="dashboard-content section-content"
                     style="display: none">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3>
                            <i class="fas fa-book-medical me-2 text-primary"></i>Sổ tiêm chủng điện tử
                        </h3>
                        <button class="btn btn-primary">
                            <i class="fas fa-download me-2"></i>Tải PDF
                        </button>
                    </div>

                    <!-- Select Profile -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Chọn hồ sơ:</label>
                        <select class="form-select" style="max-width: 300px" id="selectHoSo">
                            @foreach (var hoSo in Model.HoSoTiemChungs)
                            {
                                <option value="@hoSo.MaHSTC">@hoSo.HoTen (@hoSo.GioiTinh)</option>
                            }
                        </select>
                    </div>

                    <!-- Vaccination Timeline -->
                    <h5 class="mb-3">Lịch sử tiêm chủng</h5>

                    @foreach (var lt in Model.LichTiems)
                    {
                        <div class="timeline-item" data-hoso="@lt.MaHSTC">
                            <div class="timeline-icon">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0 text-primary">
                                            @(lt.Vaccine?.TenVC ?? "Không rõ vaccine") - Mũi @(lt.SoMui ?? 0)
                                        </h6>
                                        <span class="badge-status badge-completed">Đã tiêm</span>
                                    </div>
                                    <p class="mb-1 text-muted small">
                                        Ngày tiêm: @(lt.NgayTiemThucTe.HasValue
                                         ? lt.NgayTiemThucTe.Value.ToString("dd/MM/yyyy")
                                         : "Chưa tiêm")
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Recommended Vaccines -->
                    <div class="mt-4">
                        <h5 class="mb-3">
                            <i class="fas fa-lightbulb me-2 text-warning"></i>Vaccine đề xuất tiếp theo
                        </h5>
                        @foreach (var hen in Model.LichHenSapToi.Take(3))
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>@(hen.Vaccine?.TenVC ?? "Không rõ vaccine"):</strong>
                                Đề xuất tiêm vào @(hen.NgayHenTiem.ToString("MM/yyyy"))
                            </div>
                        }
                    </div>
                </div> <!-- 🔴 thêm dòng này để đóng Vaccination Book -->
                <!-- Appointments Section -->
                <div id="section-appointments" class="dashboard-content section-content" style="display: none">
                    <h3 class="mb-4">
                        <i class="fas fa-calendar-check me-2 text-primary"></i>Lịch hẹn của tôi
                    </h3>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs mb-4" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#upcoming-tab" type="button" role="tab">
                                Sắp tới (@Model.LichHenSapToi.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#completed-tab" type="button" role="tab">
                                Đã tiêm (@Model.LichTiems.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#cancelled-tab" type="button" role="tab">
                                Đã hủy (@Model.LichDaHuy.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <!-- Sắp tới -->
                        <div class="tab-pane fade show active" id="upcoming-tab" role="tabpanel">
                            @if (Model.LichHenSapToi.Any())
                            {
                                foreach (var hen in Model.LichHenSapToi)
                                {
                                    <div class="upcoming-appointment mb-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="mb-2 text-primary">
                                                    @(hen.Vaccine?.TenVC ?? "Không rõ vaccine") - Mũi @(hen.SoMui ?? 0)
                                                </h6>
                                                <p class="mb-1">
                                                    <i class="fas fa-user me-2"></i>Người tiêm:
                                                    <strong>@(hen.HoSoTiemChung?.HoTen ?? "Không rõ")</strong>

                                                </p>
                                                <p class="mb-1">
                                                    <i class="fas fa-calendar me-2"></i>Ngày:
                                                    <strong>@hen.NgayHenTiem.ToString("dd/MM/yyyy - HH:mm")</strong>
                                                </p>
                                                <p class="mb-0">
                                                    <i class="fas fa-map-marker-alt me-2"></i>Trung tâm TPVAX Tân Phú
                                                </p>
                                            </div>
                                            <span class="badge-status badge-pending">Chưa tiêm</span>
                                        </div>
                                        <div class="mt-3">
                                            <!-- Nút đổi lịch: khi bấm sẽ hiện date picker -->
                                            <button type="button"
                                                    class="btn btn-primary btn-sm me-2"
                                                    onclick="showDatePicker('@hen.MaLT')">
                                                <i class="fas fa-edit me-1"></i>Đổi lịch
                                            </button>

                                            <!-- Date picker: ẩn mặc định, hiện khi bấm nút -->
                                            <input type="datetime-local"
                                                   id="picker-@hen.MaLT"
                                                   style="display:none;"
                                                   min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm")"
                                                   onchange="updateSchedule('@hen.MaLT')" />


                                            <!-- Nút hủy: gọi action đổi trạng thái -->
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="cancelSchedule('@hen.MaLT')">
                                                <i class="fas fa-times me-1"></i>Hủy
                                            </button>

                                        </div>

                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Không có lịch hẹn sắp tới.</p>
                            }
                        </div>

                        <!-- Đã tiêm -->
                        <div class="tab-pane fade" id="completed-tab" role="tabpanel">
                            @if (Model.LichTiems.Any())
                            {
                                foreach (var lt in Model.LichTiems)
                                {
                                    <div class="card mb-2">
                                        <div class="card-body">
                                            <strong>@(lt.Vaccine?.TenVC ?? "Không rõ vaccine") - Mũi @(lt.SoMui ?? 0)</strong><br />
                                            Người tiêm: @(lt.HoSoTiemChung?.HoTen ?? "Không rõ")<br />

                                            Ngày tiêm: @(lt.NgayTiemThucTe?.ToString("dd/MM/yyyy"))<br />
                                            <span class="badge bg-success">Đã tiêm</span>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Không có lịch hẹn đã tiêm.</p>
                            }
                        </div>

                        <!-- Đã hủy -->
                        <div class="tab-pane fade" id="cancelled-tab" role="tabpanel">
                            @if (Model.LichDaHuy.Any())
                            {
                                foreach (var huy in Model.LichDaHuy)
                                {
                                    <div class="card mb-2">
                                        <div class="card-body">
                                            <strong>@(huy.Vaccine?.TenVC ?? "Không rõ vaccine") - Mũi @(huy.SoMui ?? 0)</strong><br />
                                            Người tiêm: @(huy.HoSoTiemChung?.HoTen ?? "Không rõ")<br />

