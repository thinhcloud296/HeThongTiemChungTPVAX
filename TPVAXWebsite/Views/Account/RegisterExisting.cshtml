@model TPVAXWebsite.Models.ViewModels.RegisterExistingCustomerViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản - Khách hàng đã có thông tin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản - TPVAX</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, #0077b6 0%, #00457a 100%);
            position: relative;
            overflow: hidden;
        }

            .auth-page::before {
                content: '';
                position: absolute;
                width: 500px;
                height: 500px;
                background: rgba(255,255,255,0.1);
                border-radius: 50%;
                top: -250px;
                left: -250px;
                animation: float 6s ease-in-out infinite;
            }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        .auth-left, .auth-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .auth-left {
            background: linear-gradient(135deg, #0077b6 0%, #023e8a 50%, #001d3d 100%);
            color: white;
            border-right: 1px solid rgba(255,255,255,0.1);
            max-width: 40%;
            position: relative;
            overflow: hidden;
        }

        .auth-left::before {
            content: '';
            position: absolute;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
            border-radius: 50%;
            top: -80px;
            right: -80px;
            animation: pulse 4s ease-in-out infinite;
        }

        .auth-left::after {
            content: '';
            position: absolute;
            width: 250px;
            height: 250px;
            background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
            border-radius: 50%;
            bottom: -40px;
            left: -40px;
            animation: pulse 5s ease-in-out infinite reverse;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }

        .brand-content {
            max-width: 400px;
            animation: slideInLeft 0.8s ease;
            position: relative;
            z-index: 2;
            text-align: center;
        }

        @@keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-50px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .hero-illustration {
            width: 160px;
            height: 160px;
            margin: 0 auto 1.5rem;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-circle {
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.05) 100%);
            border: 2px solid rgba(255,255,255,0.3);
            animation: rotate 20s linear infinite;
        }

        .hero-circle::before {
            content: '';
            position: absolute;
            width: 10px;
            height: 10px;
            background: #fbbf24;
            border-radius: 50%;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: 0 0 15px #fbbf24;
        }

        @@keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .hero-icon {
            font-size: 4rem;
            color: white;
            text-shadow: 0 0 25px rgba(255,255,255,0.5);
            animation: float-icon 3s ease-in-out infinite;
            position: relative;
            z-index: 1;
        }

        @@keyframes float-icon {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .brand-logo { display: none; }

        .brand-content h1 {
            font-size: 2.4rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            background: linear-gradient(90deg, #fff 0%, #a5d8ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 2px;
        }

        .brand-tagline {
            font-size: 0.9rem;
            opacity: 0.9;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            color: rgba(255,255,255,0.85);
        }

        .benefit-list {
            list-style: none;
            padding: 0;
            margin-top: 1.5rem;
            text-align: left;
        }

        .benefit-list li {
            padding: 0.8rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background: rgba(255,255,255,0.08);
            border-radius: 10px;
            margin-bottom: 0.6rem;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .benefit-list li:hover {
            transform: translateX(6px);
            background: rgba(255,255,255,0.15);
        }

        .benefit-list li .icon-wrapper {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .benefit-list li:nth-child(1) .icon-wrapper {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            box-shadow: 0 4px 12px rgba(251, 191, 36, 0.4);
        }

        .benefit-list li:nth-child(2) .icon-wrapper {
            background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
            box-shadow: 0 4px 12px rgba(74, 222, 128, 0.4);
        }

        .benefit-list li:nth-child(3) .icon-wrapper {
            background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
            box-shadow: 0 4px 12px rgba(96, 165, 250, 0.4);
        }

        .benefit-list li:nth-child(4) .icon-wrapper {
            background: linear-gradient(135deg, #f472b6 0%, #ec4899 100%);
            box-shadow: 0 4px 12px rgba(244, 114, 182, 0.4);
        }

        .benefit-list li span {
            font-weight: 500;
            color: rgba(255,255,255,0.95);
        }

        .auth-right {
            background: white;
        }

        .back-home {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 10;
        }

            .back-home a {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.5rem 1rem;
                background: linear-gradient(135deg, #0077b6 0%, #00457a 100%);
                color: white;
                text-decoration: none;
                border-radius: 50px;
                font-weight: 600;
                font-size: 0.85rem;
                transition: all 0.3s ease;
            }

                .back-home a:hover {
                    transform: translateY(-2px);
                }

        .auth-container {
            max-width: 480px;
            width: 100%;
        }

        .auth-header h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 0.5rem;
        }

        .auth-header p {
            color: #718096;
            margin-bottom: 1.5rem;
            font-size: 0.95rem;
        }

        .info-box {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-left: 4px solid #0077b6;
            padding: 1rem 1.2rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }

            .info-box i {
                color: #0077b6;
                margin-right: 0.5rem;
            }

            .info-box p {
                margin: 0;
                color: #1565c0;
                font-size: 0.9rem;
                line-height: 1.5;
            }

        .form-group {
            margin-bottom: 1.2rem;
        }

            .form-group label {
                font-weight: 600;
                color: #4a5568;
                margin-bottom: 0.4rem;
                display: block;
                font-size: 0.9rem;
            }

        .input-group {
            position: relative;
        }

        .form-control {
            width: 100%;
            padding: 0.85rem 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f7fafc;
        }

            .form-control:focus {
                outline: none;
                border-color: #0077b6;
                background: white;
                box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.1);
            }

        .input-group .form-control {
            padding-right: 3rem;
        }

        .input-icon {
            position: absolute;
            right: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            pointer-events: none;
        }

        .btn-search {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #0077b6 0%, #00457a 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 119, 182, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 1rem;
        }

            .btn-search:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0, 119, 182, 0.6);
            }

        .alert {
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
        }

        .alert-danger {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .alert-success {
            background: #d1fae5;
            border: 1px solid #a7f3d0;
            color: #065f46;
        }

        .text-danger {
            color: #e53e3e;
            font-size: 0.85rem;
            margin-top: 0.3rem;
            display: block;
        }

        .auth-switch {
            text-align: center;
            margin-top: 1.5rem;
            color: #718096;
            font-size: 0.95rem;
        }

            .auth-switch a {
                color: #0077b6;
                font-weight: 600;
                text-decoration: none;
            }

                .auth-switch a:hover {
                    color: #00457a;
                    text-decoration: underline;
                }

        .divider {
            text-align: center;
            margin: 1.5rem 0;
            position: relative;
        }

            .divider::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                width: 100%;
                height: 1px;
                background: #e2e8f0;
            }

            .divider span {
                background: white;
                padding: 0 1rem;
                position: relative;
                z-index: 1;
                color: #a0aec0;
                font-size: 0.9rem;
            }

        @@media (max-width: 968px) {
            .auth-left {
                display: none;
            }

            .auth-right {
                flex: 1;
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="auth-left">
            <div class="brand-content">
                <div class="hero-illustration">
                    <div class="hero-circle"></div>
                    <i class="fas fa-user-check hero-icon"></i>
                </div>
                <h1>TPVAX</h1>
                <p class="brand-tagline">Dành cho khách hàng đã có thông tin trong hệ thống<br/>nhưng chưa có tài khoản đăng nhập</p>
                <ul class="benefit-list">
                    <li>
                        <div class="icon-wrapper"><i class="fas fa-search"></i></div>
                        <span>Tìm kiếm thông tin bằng CCCD & SĐT</span>
                    </li>
                    <li>
                        <div class="icon-wrapper"><i class="fas fa-link"></i></div>
                        <span>Liên kết tài khoản với thông tin có sẵn</span>
                    </li>
                    <li>
                        <div class="icon-wrapper"><i class="fas fa-shield-alt"></i></div>
                        <span>Bảo mật thông tin cá nhân</span>
                    </li>
                    <li>
                        <div class="icon-wrapper"><i class="fas fa-clock"></i></div>
                        <span>Chỉ mất 1 phút để hoàn tất</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="auth-right">
            <div class="back-home">
                <a href="@Url.Action("Index","Home")">
                    <i class="fas fa-home"></i><span>Trang chủ</span>
                </a>
            </div>

            <div class="auth-container">
                <div class="auth-header">
                    <h2><i class="fas fa-user-plus me-2"></i>Đăng ký tài khoản</h2>
                    <p>Dành cho khách hàng đã có thông tin trong hệ thống</p>
                </div>

                <div class="info-box">
                    <p><i class="fas fa-info-circle"></i>Nếu bạn đã từng đăng ký tiêm chủng tại TPVAX (qua nhân viên hoặc người thân), hãy nhập CCCD và Số điện thoại để tìm và tạo tài khoản.</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                @using (Html.BeginForm("RegisterExisting", "Account", FormMethod.Post, new { @class = "auth-form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        @Html.LabelFor(m => m.CCCD, "Số CCCD/CMND")
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.CCCD, new { @class = "form-control", placeholder = "Nhập số CCCD (9-12 số)", maxlength = "12" })
                            <i class="fas fa-id-card input-icon"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.CCCD, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.SoDT, "Số điện thoại")
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.SoDT, new { @class = "form-control", placeholder = "Nhập số điện thoại (VD: 0901234567)", maxlength = "10" })
                            <i class="fas fa-phone input-icon"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.SoDT, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn-search">
                        <i class="fas fa-search"></i> Tìm kiếm thông tin
                    </button>
                }

                <div class="divider"><span>Hoặc</span></div>

                <p class="auth-switch">
                    Chưa có thông tin trong hệ thống? <a href="@Url.Action("Register","Account")">Đăng ký mới</a>
                </p>
                <p class="auth-switch">
                    Đã có tài khoản? <a href="@Url.Action("Login","Account")">Đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>
