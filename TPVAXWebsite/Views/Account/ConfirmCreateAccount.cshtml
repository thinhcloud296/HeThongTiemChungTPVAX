@model TPVAXWebsite.Models.ViewModels.ConfirmAndCreateAccountViewModel

@{
    ViewBag.Title = "Xác nhận và tạo tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xác nhận tạo tài khoản - TPVAX</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, #0077b6 0%, #00457a 100%);
            position: relative;
            overflow: hidden;
        }

            .auth-page::before {
                content: '';
                position: absolute;
                width: 500px;
                height: 500px;
                background: rgba(255,255,255,0.1);
                border-radius: 50%;
                top: -250px;
                left: -250px;
            }

        .auth-left, .auth-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .auth-left {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(20px);
            color: white;
            border-right: 1px solid rgba(255,255,255,0.1);
            max-width: 40%;
        }

        .brand-content {
            max-width: 400px;
        }

        .brand-logo {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            background: linear-gradient(45deg, #fff, #f0f0f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-content h1 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 0.8rem;
        }

        .brand-content > p {
            font-size: 0.95rem;
            opacity: 0.9;
            line-height: 1.6;
        }

        .step-indicator {
            margin-top: 2rem;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 0;
            opacity: 0.6;
        }

            .step-item.active {
                opacity: 1;
            }

            .step-item.completed {
                opacity: 0.8;
            }

        .step-number {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .step-item.active .step-number {
            background: #fff;
            color: #0077b6;
        }

        .step-item.completed .step-number {
            background: #4ade80;
            color: white;
        }

        .auth-right {
            background: white;
            overflow-y: auto;
            max-height: 100vh;
        }

        .back-home {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 10;
        }

            .back-home a {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.5rem 1rem;
                background: linear-gradient(135deg, #0077b6 0%, #00457a 100%);
                color: white;
                text-decoration: none;
                border-radius: 50px;
                font-weight: 600;
                font-size: 0.85rem;
            }

        .auth-container {
            max-width: 520px;
            width: 100%;
            padding: 1rem 0;
        }

        .auth-header h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 0.5rem;
        }

        .auth-header p {
            color: #718096;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .customer-info-card {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            border: 2px solid #86efac;
            border-radius: 12px;
            padding: 1.2rem;
            margin-bottom: 1.5rem;
        }

            .customer-info-card h4 {
                color: #166534;
                font-size: 1rem;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.8rem;
        }

        .info-item {
        }

            .info-item label {
                font-size: 0.75rem;
                color: #6b7280;
                display: block;
                margin-bottom: 0.2rem;
            }

            .info-item span {
                font-size: 0.9rem;
                color: #1f2937;
                font-weight: 500;
            }

            .info-item.full-width {
                grid-column: 1 / -1;
            }

        .form-section {
            background: #f8fafc;
            border-radius: 12px;
            padding: 1.2rem;
            margin-bottom: 1rem;
        }

            .form-section h4 {
                color: #334155;
                font-size: 1rem;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                font-weight: 600;
                color: #4a5568;
                margin-bottom: 0.3rem;
                display: block;
                font-size: 0.85rem;
            }

        .input-group {
            position: relative;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: white;
        }

            .form-control:focus {
                outline: none;
                border-color: #0077b6;
                box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.1);
            }

        .input-group .form-control {
            padding-right: 3rem;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #a0aec0;
            z-index: 2;
        }

            .password-toggle:hover {
                color: #0077b6;
            }

        .btn-group-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .btn-back {
            flex: 1;
            padding: 0.9rem;
            background: #f1f5f9;
            color: #475569;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            text-align: center;
        }

            .btn-back:hover {
                background: #e2e8f0;
                color: #334155;
            }

        .btn-create {
            flex: 2;
            padding: 0.9rem;
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(34, 197, 94, 0.6);
            }

        .alert {
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
        }

        .alert-danger {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .text-danger {
            color: #e53e3e;
            font-size: 0.8rem;
            margin-top: 0.2rem;
            display: block;
        }

        .terms-group {
            margin: 1rem 0;
            padding: 0.8rem;
            background: #f7fafc;
            border-radius: 10px;
        }

        .terms-checkbox {
            display: flex;
            gap: 0.6rem;
            font-size: 0.8rem;
            color: #4a5568;
            align-items: flex-start;
        }

            .terms-checkbox input[type="checkbox"] {
                width: 16px;
                height: 16px;
                cursor: pointer;
                margin-top: 2px;
            }

        @@media (max-width: 968px) {
            .auth-left {
                display: none;
            }

            .auth-right {
                flex: 1;
                padding: 1.5rem;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="auth-left">
            <div class="brand-content">
                <div class="brand-logo"><i class="fas fa-check-circle"></i></div>
                <h1>TPVAX</h1>
                <p>Chúng tôi đã tìm thấy thông tin của bạn trong hệ thống. Vui lòng xác nhận và tạo mật khẩu để hoàn tất.</p>

                <div class="step-indicator">
                    <div class="step-item completed">
                        <div class="step-number"><i class="fas fa-check"></i></div>
                        <span>Nhập CCCD & SĐT</span>
                    </div>
                    <div class="step-item active">
                        <div class="step-number">2</div>
                        <span>Xác nhận & Tạo mật khẩu</span>
                    </div>
                    <div class="step-item">
                        <div class="step-number">3</div>
                        <span>Hoàn tất</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-right">
            <div class="back-home">
                <a href="@Url.Action("Index","Home")">
                    <i class="fas fa-home"></i><span>Trang chủ</span>
                </a>
            </div>

            <div class="auth-container">
                <div class="auth-header">
                    <h2><i class="fas fa-user-check me-2" style="color: #22c55e;"></i>Xác nhận thông tin</h2>
                    <p>Vui lòng kiểm tra thông tin và tạo mật khẩu để hoàn tất đăng ký</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="customer-info-card">
                    <h4><i class="fas fa-user"></i> Thông tin khách hàng</h4>
                    <div class="info-grid">
                        <div class="info-item full-width">
                            <label>Họ và tên</label>
                            <span>@Model.HoTen</span>
                        </div>
                        <div class="info-item">
                            <label>Mã khách hàng</label>
                            <span>@Model.MaKH</span>
                        </div>
                        <div class="info-item">
                            <label>Số CCCD</label>
                            <span>@Model.CCCD</span>
                        </div>
                        <div class="info-item full-width">
                            <label>Số điện thoại</label>
                            <span>@Model.SoDT</span>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm("CreateAccountForExisting", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaKH)
                    @Html.HiddenFor(m => m.HoTen)
                    @Html.HiddenFor(m => m.CCCD)
                    @Html.HiddenFor(m => m.SoDT)

                    <div class="form-section">
                        <h4><i class="fas fa-lock"></i> Tạo mật khẩu đăng nhập</h4>

                        <div class="form-group">
                            @Html.LabelFor(m => m.MatKhau, "Mật khẩu")
                            <div class="input-group">
                                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự", id = "password" })
                                <button type="button" class="password-toggle" onclick="togglePassword('password', this)">
                                    <i class="far fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.XacNhanMatKhau, "Xác nhận mật khẩu")
                            <div class="input-group">
                                @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu", id = "confirmPassword" })
                                <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword', this)">
                                    <i class="far fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="terms-group">
                        <div class="terms-checkbox">
                            <input type="checkbox" id="agreeTerms" name="agreeTerms" required />
                            <label for="agreeTerms">
                                Tôi xác nhận thông tin trên là chính xác và đồng ý với Điều khoản dịch vụ của TPVAX
                            </label>
                        </div>
                    </div>

                    <div class="btn-group-actions">
                        <a href="@Url.Action("RegisterExisting", "Account")" class="btn-back">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn-create">
                            <i class="fas fa-check"></i> Tạo tài khoản
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
