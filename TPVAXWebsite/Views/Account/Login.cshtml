@model TPVAXWebsite.Models.ViewModels.LoginViewModel

@{
    ViewBag.Title = "Dang nhap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        /* Auth page specific styles */
        .main { padding: 0 !important; margin: 0 !important; }
        .auth-page { min-height: 100vh; display: flex; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .auth-left, .auth-right { flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem; }
        .auth-left { background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); color: white; }
        .brand-content { max-width: 500px; }
        .brand-logo { font-size: 4rem; margin-bottom: 1rem; }
        .feature-list { list-style: none; padding: 0; margin-top: 2rem; }
        .feature-list li { padding: 0.8rem 0; display: flex; align-items: center; gap: 1rem; }
        .auth-right { background: white; position: relative; }
        .back-home { position: absolute; top: 2rem; right: 2rem; }
        .auth-container { max-width: 450px; width: 100%; }
        .form-group { margin-bottom: 1.5rem; }
        .input-group { position: relative; }
        .input-group .form-control { padding-right: 3rem; }
        .password-toggle { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; }
        .btn-login { width: 100%; padding: 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 0.5rem; font-weight: 600; }
        .social-login { display: flex; gap: 1rem; margin-top: 1rem; }
        .social-btn { flex: 1; padding: 0.8rem; border: 1px solid #ddd; background: white; border-radius: 0.5rem; }
    </style>
}

<div style="margin: 0; padding: 0;">
    <div class="auth-page">
        <div class="auth-left">
            <div class="brand-content">
                <div class="brand-logo"><i class="fas fa-syringe"></i></div>
                <h1>TPVAX</h1>
                <p>He thong tiem chung vaccine hang dau Viet Nam. An toan - Chuyen nghiep - Tien loi.</p>
                <ul class="feature-list">
                    <li><i class="fas fa-shield-alt"></i><span>Vaccine chinh hang, nguon goc ro rang</span></li>
                    <li><i class="fas fa-user-md"></i><span>Doi ngu bac si chuyen mon cao</span></li>
                    <li><i class="fas fa-calendar-check"></i><span>Dat lich online nhanh chong</span></li>
                    <li><i class="fas fa-chart-line"></i><span>Theo doi lich su tiem chung</span></li>
                </ul>
            </div>
        </div>

        <div class="auth-right">
            <div class="back-home">
                <a href="@Url.Action("Index", "Home")">
                    <i class="fas fa-home"></i><span>Trang chu</span>
                </a>
            </div>

            <div class="auth-container">
                <div class="auth-header">
                    <h2>Chao mung tro lai!</h2>
                    <p>Dang nhap de tiep tuc quan ly suc khoe cua ban</p>
                </div>

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                @if (TempData["SuccessMessage"] != null)
                {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "auth-form", id = "loginForm" }))
                {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    @Html.LabelFor(m => m.TenDangNhap, "Email hoac So dien thoai")
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "VD: example@email.com hoac 0912345678", autocomplete = "username", id = "login-email" })
                        <i class="fas fa-envelope input-icon"></i>
                    </div>
                    @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.MatKhau, "Mat khau")
                    <div class="input-group">
                        @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Nhap mat khau cua ban", autocomplete = "current-password", id = "login-password" })
                        <button type="button" class="password-toggle" id="togglePassword"><i class="far fa-eye"></i></button>
                    </div>
                    @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        @Html.CheckBoxFor(m => m.RememberMe, new { id = "rememberMe" })
                        <span>Ghi nho dang nhap</span>
                    </label>
                    <a href="#" class="forgot-password" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">Quen mat khau?</a>
                </div>

                <button type="submit" class="btn-login" id="loginBtn">
                    <i class="fas fa-sign-in-alt"></i> Dang Nhap Ngay
                </button>
                }

                <div class="divider"><span>Hoac tiep tuc voi</span></div>
                <div class="social-login">
                    <button class="social-btn google"><i class="fab fa-google"></i><span>Google</span></button>
                    <button class="social-btn facebook"><i class="fab fa-facebook-f"></i><span>Facebook</span></button>
                </div>

                <p class="auth-switch">Chua co tai khoan? <a href="@Url.Action("Register","Account")">Dang ky mien phi</a></p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('login-password');
        if (togglePassword) {
            togglePassword.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                const icon = this.querySelector('i');
                icon.classList.toggle('fa-eye');
                icon.classList.toggle('fa-eye-slash');
            });
        }
    </script>
}
