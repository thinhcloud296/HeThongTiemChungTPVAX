@model TPVAXWebsite.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng Ký - TPVAX";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Đăng ký tài khoản TPVAX miễn phí để quản lý lịch tiêm chủng, đặt lịch vaccine online và nhận ưu đãi đặc biệt." />
    <meta name="keywords" content="đăng ký, TPVAX, tài khoản miễn phí, tiêm chủng, vaccine" />

    <link rel="icon" type="image/png" href="@Url.Content("~/Content/Assets/logo.png")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/main_style.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/layout_page_style.css")" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <title>@ViewBag.Title</title>
</head>
<body>
    <div class="auth-page">
        <div class="auth-left">
            <div class="brand-content">
                <div class="brand-logo"><i class="fas fa-user-plus"></i></div>
                <h1>TPVAX</h1>
                <p>Tham gia cùng hàng nghìn khách hàng đã tin tưởng và sử dụng dịch vụ tiêm chủng của chúng tôi.</p>
                <ul class="benefit-list">
                    <li><i class="fas fa-gift"></i><span>Miễn phí đăng ký tài khoản</span></li>
                    <li><i class="fas fa-percent"></i><span>Ưu đãi độc quyền cho thành viên</span></li>
                    <li><i class="fas fa-bell"></i><span>Nhận thông báo lịch tiêm nhắc nhở</span></li>
                    <li><i class="fas fa-mobile-alt"></i><span>Quản lý sức khỏe mọi lúc mọi nơi</span></li>
                </ul>
            </div>
        </div>

        <div class="auth-right">
            <div class="back-home">
                <a href="@Url.Action("Index","Home")">
                    <i class="fas fa-home"></i><span>Trang chủ</span>
                </a>
            </div>

            <div class="auth-container">
                <div class="auth-header">
                    <h2>Tạo tài khoản mới 🎉</h2>
                    <p>Chỉ mất 2 phút để bắt đầu hành trình chăm sóc sức khỏe</p>
                </div>

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form", id = "registerForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        @Html.LabelFor(m => m.TenDangNhap)
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Tên đăng nhập (tối đa 10 ký tự)", id = "register-username" })
                            <i class="fas fa-id-card input-icon"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.HoTen)
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "VD: Nguyễn Văn A", autocomplete = "name", id = "register-name" })
                            <i class="fas fa-user input-icon"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.SoDT)
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.SoDT, new { @class = "form-control", placeholder = "VD: 0912345678", autocomplete = "tel", id = "register-phone" })
                            <i class="fas fa-phone input-icon"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.SoDT, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "VD: example@email.com (không bắt buộc)", autocomplete = "email", id = "register-email" })
                            <i class="fas fa-envelope input-icon"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.MatKhau)
                        <div class="input-group">
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự", autocomplete = "new-password", id = "register-password" })
                            <button type="button" class="password-toggle" id="togglePassword"><i class="far fa-eye"></i></button>
                        </div>
                        @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.XacNhanMatKhau)
                        <div class="input-group">
                            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control", placeholder = "Nhập lại mật khẩu", autocomplete = "new-password", id = "register-confirm-password" })
                            <button type="button" class="password-toggle" id="toggleConfirmPassword"><i class="far fa-eye"></i></button>
                        </div>
                        @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger" })
                    </div>

                    <div class="terms-group">
                        <div class="terms-checkbox">
                            <input type="checkbox" id="agreeTerms" name="agreeTerms" required />
                            <label for="agreeTerms">
                                Tôi đồng ý với <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">Điều khoản dịch vụ</a> và
                                <a href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">Chính sách bảo mật</a> của TPVAX
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn-register" id="registerBtn">
                        <i class="fas fa-user-plus"></i> Đăng Ký Miễn Phí
                    </button>
                }

                <div class="divider"><span>Hoặc đăng ký với</span></div>
                <div class="social-login">
                    <button class="social-btn google"><i class="fab fa-google"></i><span>Google</span></button>
                    <button class="social-btn facebook"><i class="fab fa-facebook-f"></i><span>Facebook</span></button>
                </div>

                <p class="auth-switch">Đã có tài khoản? <a href="@Url.Action("Login","Account")">Đăng nhập ngay</a></p>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Content/bootstrap.bundle.min.js")"></script>
    <script>
        const togglePassword = document.getElementById('togglePassword');
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        const passwordInput = document.getElementById('register-password');
        const confirmPasswordInput = document.getElementById('register-confirm-password');

        if (togglePassword) {
            togglePassword.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                this.querySelector('i').classList.toggle('fa-eye');
                this.querySelector('i').classList.toggle('fa-eye-slash');
            });
        }

        if (toggleConfirmPassword) {
            toggleConfirmPassword.addEventListener('click', function () {
