@model TPVAXWebsite.Models.ViewModels.TimHoSoTiemChungViewModel

@{
    ViewBag.Title = "Đăng ký từ hồ sơ tiêm chủng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>Đăng ký tài khoản
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Đã có thông tin trong hệ thống?</strong>
                        <p class="mb-0 mt-2 small">
                            Nhập số CCCD để tìm hồ sơ tiêm chủng của bạn và tạo tài khoản.
                        </p>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        </div>
                    }

                    @using (Html.BeginForm("DangKyTuHoSo", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CCCD, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.CCCD, new { @class = "form-control", placeholder = "Nhập số CCCD (9-12 số)", maxlength = "12" })
                            @Html.ValidationMessageFor(m => m.CCCD, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-2"></i>Tìm hồ sơ tiêm chủng
                            </button>
                        </div>
                    }

                    <hr class="my-4" />

                    <p class="text-center text-muted small mb-2">
                        Chưa có thông tin trong hệ thống?
                    </p>
                    <div class="d-grid">
                        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-secondary">
                            <i class="bi bi-person-plus me-2"></i>Đăng ký mới
                        </a>
                    </div>

                    <p class="text-center text-muted small mt-3">
                        Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
