@model TPVAXWebsite.Models.ViewModels.VaccineDetailViewModel

@{
    ViewBag.Title = Model.Vaccine.TenVaccine;
}

<nav aria-label="breadcrumb" class="bg-light py-3">
    <div class="container">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Vaccine")">Vắc xin</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Vaccine.TenVaccine</li>
        </ol>
    </div>
</nav>

<section class="container my-5">
    <div class="row">

        <div class="col-lg-5 mb-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="card shadow-sm">
                    <img src="@Url.Content("~/Content/Images/Vaccines/" + (Model.Vaccine.HinhAnh ?? "hexaxim.png"))"
                         alt="@Model.Vaccine.TenVaccine"
                         class="card-img-top"
                         style="width: 100%; height: 400px; object-fit: cover;" />
                </div>
            </div>
        </div>

        <div class="col-lg-7">

            <h1 class="h2 fw-bold text-primary mb-3">@Model.Vaccine.TenVaccine</h1>

            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="badge bg-primary fs-6">@(Model.Vaccine.TenLoaiVaccine ?? "Vắc xin")</span>
                @if (!string.IsNullOrEmpty(Model.Vaccine.NuocSanXuat))
                {
                    <span class="text-muted">
                        <i class="fas fa-globe me-1"></i>Xuất xứ: <strong>@Model.Vaccine.NuocSanXuat</strong>
                    </span>
                }
            </div>

            <div class="card border-warning shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="h4 text-warning fw-bold mb-0">
                        @string.Format("{0:N0}₫", Model.Vaccine.GiaBan)
                        <small class="text-muted fs-6">/ liều</small>
                    </h3>
                </div>
            </div>

            <div class="mb-4">
                <h4 class="h5 fw-bold mb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Mô tả</h4>
                <p class="text-secondary">@Html.Raw(Model.Vaccine.MoTa)</p>
            </div>

            @if (Model.CacBenhPhong != null && Model.CacBenhPhong.Any())
            {
                <div class="mb-4">
                    <h4 class="h5 fw-bold mb-3"><i class="fas fa-shield-virus me-2 text-primary"></i>Phòng chống các bệnh</h4>
                    <div class="row g-2">
                        @foreach (var benh in Model.CacBenhPhong)
                        {
                            <div class="col-md-6">
                                <div class="alert alert-light border mb-0">
                                    <i class="fas fa-check text-success me-2"></i>@benh
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card border-0 bg-light mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="fas fa-clipboard-list me-2"></i>Thông tin chi tiết</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Hãng sản xuất:</strong></p>
                            <p class="text-muted">@(Model.Vaccine.TenNCC ?? "Đang cập nhật")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Nước sản xuất:</strong></p>
                            <p class="text-muted">@(Model.Vaccine.NuocSanXuat ?? "Đang cập nhật")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <hr class="my-3" />
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("DatLich", "LichTiem", new { vaccineId = Model.Vaccine.MaVC })"
                           class="btn btn-primary btn-lg">
                            <i class="fas fa-calendar-check me-2"></i>Đặt lịch tiêm ngay
                        </a>
                        <a href="tel:0975088626" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-phone me-2"></i>Gọi tư vấn: 0975 088 626
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.VaccinesLienQuan != null && Model.VaccinesLienQuan.Any())
{
    <section class="bg-light py-5">
        <div class="container">
            <h3 class="h4 fw-bold mb-4">
                <i class="fas fa-syringe me-2 text-primary"></i>Vắc xin liên quan
            </h3>
            <div class="row g-4">
                @foreach (var vaccine in Model.VaccinesLienQuan.Take(3))
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm">
                            <img src="@Url.Content("~/Content/Images/Vaccines/" + (vaccine.HinhAnh ?? "hexaxim.png"))"
                                 class="card-img-top"
                                 style="height: 200px; object-fit: cover;"
                                 alt="@vaccine.TenVC" />
                            <div class="card-body">
                                <h5 class="card-title">@vaccine.TenVC</h5>
                                <p class="text-warning fw-bold">@string.Format("{0:N0}₫", vaccine.GiaBan)</p>
                                <a href="@Url.Action("Index", "Vaccine", new { id = vaccine.MaVC })"
                                   class="btn btn-outline-primary w-100">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@section scripts {
    <script>
        $(document).ready(function () {
            const vaccineId = '@Model.Vaccine.MaVC';
            const vaccineName = '@Model.Vaccine.TenVaccine';
            const vaccinePrice = @Model.Vaccine.GiaBan;

            // Quantity controls
            $('#btnIncrease').click(function () {
                const input = $('#quantity');
                const currentVal = parseInt(input.val());
                if (currentVal < 10) {
                    input.val(currentVal + 1);
                }
            });

            $('#btnDecrease').click(function () {
                const input = $('#quantity');
                const currentVal = parseInt(input.val());
                if (currentVal > 1) {
                    input.val(currentVal - 1);
                }
            });

            // Add to cart
            $('#btnAddToCart').click(function () {
                const quantity = parseInt($('#quantity').val());
                const button = $(this);

                button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Đang thêm...');

                $.ajax({
                    url: '@Url.Action("ThemVaoGio", "GioHang")',
                    type: 'POST',
                    data: { 
                        MaSanPham: vaccineId, 
                        LoaiSanPham: 'VACCINE', 
                        SoLuong: quantity 
                    },
                    success: function (data) {
                        if (data.success) {
                            // Cập nhật số lượng giỏ hàng trên header
                            $('.cart-count').text(data.cartCount);
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: 'Đã thêm ' + quantity + ' liều "' + vaccineName + '" vào giỏ hàng!',
                                timer: 2000,
                                showConfirmButton: false
                            });

                            button.html('<i class="fas fa-check me-2"></i>Đã thêm vào giỏ');
                            setTimeout(() => {
                                button.prop('disabled', false).html('<i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng');
                            }, 2000);
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                            button.prop('disabled', false).html('<i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi', 'Vui lòng đăng nhập để thêm vào giỏ hàng', 'error');
                        button.prop('disabled', false).html('<i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng');
                    }
                });
            });
        });
    </script>
}