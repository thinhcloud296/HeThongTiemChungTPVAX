@model IEnumerable<TPVAXWebsite.Models.ViewModels.LichSuTiemChungViewModel>

@{
    ViewBag.Title = "Lịch sử tiêm chủng";
}

<!-- Page Header -->
<section class="page-header bg-primary bg-gradient text-white py-4">
    <div class="container">
        <h1 class="h3 mb-0">
            <i class="fas fa-history me-2"></i>Lịch Sử Tiêm Chủng
        </h1>
    </div>
</section>

<!-- History List -->
<section class="container my-5">
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var lich in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold">
                                <i class="fas fa-calendar me-2"></i>@lich.NgayTiem.ToString("dd/MM/yyyy")
                            </h6>
                            @if (lich.TrangThai == "Đã tiêm")
                            {
                                <span class="badge bg-success">@lich.TrangThai</span>
                            }
                            else if (lich.TrangThai == "Đã đặt")
                            {
                                <span class="badge bg-info">@lich.TrangThai</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@lich.TrangThai</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-primary">@lich.TenVaccine</h5>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Giờ tiêm:</small>
                                    <p class="mb-0 fw-semibold">@lich.GioTiem</p>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Mã lịch:</small>
                                    <p class="mb-0 fw-semibold">#@lich.MaLichTiem</p>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(lich.GhiChu))
                            {
                                <p class="text-secondary small mb-0">
                                    <i class="fas fa-comment me-1"></i>@lich.GhiChu
                                </p>
                            }
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Detail", "LichTiem", new { id = lich.MaLichTiem })" class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="fas fa-eye me-1"></i>Chi tiết
                                </a>
                                @if (lich.TrangThai == "Đã đặt")
                                {
                                    <button class="btn btn-sm btn-outline-danger" onclick="cancelAppointment(@lich.MaLichTiem)">
                                        <i class="fas fa-times me-1"></i>Hủy lịch
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-calendar-times fa-5x text-muted mb-4"></i>
            <h4>Chưa có lịch tiêm nào</h4>
            <p class="text-muted mb-4">Bạn chưa đặt lịch tiêm chủng</p>
            <a href="@Url.Action("DatLich", "LichTiem")" class="btn btn-primary btn-lg">
                <i class="fas fa-calendar-plus me-2"></i>Đặt lịch ngay
            </a>
        </div>
    }
</section>

@section scripts {
    <script>
        // Chức năng hủy lịch đã tạm dừng - chỉ hiển thị thông báo
        function cancelAppointment(id) {
            alert('Chức năng hủy lịch trực tuyến hiện đang tạm dừng.\n\nVui lòng liên hệ trung tâm TPVAX qua hotline 1900-xxxx để được hỗ trợ hủy lịch.');
        }
    </script>
}
