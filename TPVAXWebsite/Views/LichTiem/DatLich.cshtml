@model TPVAXWebsite.Models.ViewModels.DatLichTiemViewModel

@{
    ViewBag.Title = "Đặt lịch tiêm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-header bg-primary bg-gradient text-white py-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="h3 mb-0">
                <i class="fas fa-calendar-plus me-2"></i>Đặt Lịch Tiêm Chủng
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-white-50" aria-current="page">Đặt lịch</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<section class="container my-5">
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold">
                    <i class="fas fa-info-circle me-2 text-primary"></i>Thông tin Vắc xin
                </div>
                <img src="@Url.Content(string.IsNullOrEmpty(Model.HinhAnh) ? "~/Content/Assets/Images/default.png" : "~/Content/Images/Vaccines/" + Model.HinhAnh)"
                     class="card-img-top" alt="@Model.TenVaccine"
                     style="height: 250px; object-fit: cover;"
                     onerror="this.src='@Url.Content("~/Content/Assets/Images/default.png")'"/>
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold">@Model.TenVaccine</h5>
                    <p class="card-text text-warning fw-bold fs-4 mb-2">
                        @string.Format("{0:N0}₫", Model.GiaBan)
                    </p>
                    <div class="alert alert-info small mb-0">
                        <i class="fas fa-shield-alt me-1"></i>
                        Thêm vào giỏ hàng để tiến hành thanh toán và đặt lịch.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4 border-bottom pb-2">
                        <i class="fas fa-clipboard-list me-2 text-primary"></i>Phiếu đăng ký
                    </h4>

                    @using (Html.BeginForm("DatLich", "LichTiem", FormMethod.Post, new { @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.MaVC) @* Giữ mã Vaccine *@
                        @Html.HiddenFor(m => m.TenVaccine) @* Giữ tên để nếu lỗi reload lại vẫn hiện *@
                        @Html.HiddenFor(m => m.HinhAnh)
                        @Html.HiddenFor(m => m.GiaBan)

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-user-injured me-1"></i>Chọn người tiêm (Hồ sơ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                @Html.DropDownListFor(m => m.MaHSTC,
                                    Model.DanhSachHoSo,
                                    "-- Vui lòng chọn người thân --",
                                    new { @class = "form-select form-select-lg" })
                                <a href="@Url.Action("Create", "HoSoTiemChung")" class="btn btn-outline-primary" title="Thêm hồ sơ mới">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                            @Html.ValidationMessageFor(m => m.MaHSTC, "", new { @class = "text-danger small mt-1" })
                            <div class="form-text">
                                Nếu chưa có tên trong danh sách, hãy nhấn dấu (+) để tạo hồ sơ mới.
                            </div>
                        </div>

                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="fas fa-info-circle me-2 fs-4"></i>
                            <div>
                                <small>Sau khi thêm vào giỏ hàng, bạn sẽ chọn <strong>thời gian tiêm</strong> và <strong>thanh toán</strong> tại bước tiếp theo.</small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a href="@Url.Action("Index", "Vaccine", new { id = Model.MaVC })" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
        });
    </script>
}