@model TPVAXWebsite.Models.ViewModels.DatLichTiemViewModel

@{
    ViewBag.Title = "Đặt lịch tiêm";
}

<!-- Page Header -->
<section class="page-header bg-primary bg-gradient text-white py-4">
    <div class="container">
        <h1 class="h3 mb-0">
            <i class="fas fa-calendar-plus me-2"></i>Đặt Lịch Tiêm Chủng
        </h1>
    </div>
</section>

<!-- Booking Form -->
<section class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@ViewBag.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">
                        <i class="fas fa-clipboard-list me-2 text-primary"></i>Thông tin đặt lịch
                    </h4>

                    @using (Html.BeginForm("DatLich", "LichTiem", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.MaVaccine)

                        <!-- Personal Info -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-user me-1"></i>Họ và tên <span class="text-danger">*</span>
                                </label>
                                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nguyễn Văn A", required = "required" })
                                @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-phone me-1"></i>Số điện thoại <span class="text-danger">*</span>
                                </label>
                                @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "0912345678", required = "required" })
                                @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-1"></i>Email
                                </label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "example@email.com" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-birthday-cake me-1"></i>Ngày sinh
                                </label>
                                @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <!-- Appointment Info -->
                        <hr class="my-4" />
                        <h5 class="mb-3"><i class="fas fa-calendar-check me-2"></i>Thông tin lịch hẹn</h5>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-calendar-day me-1"></i>Ngày tiêm <span class="text-danger">*</span>
                                </label>
                                @Html.TextBoxFor(m => m.NgayTiem, new { @class = "form-control", type = "date", required = "required", min = DateTime.Now.ToString("yyyy-MM-dd") })
                                @Html.ValidationMessageFor(m => m.NgayTiem, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-clock me-1"></i>Giờ tiêm <span class="text-danger">*</span>
                                </label>
                                @Html.DropDownListFor(m => m.GioTiem, 
                                    new SelectList(new[] { "08:00", "09:00", "10:00", "11:00", "14:00", "15:00", "16:00", "17:00" }), 
                                    "-- Chọn giờ --", 
                                    new { @class = "form-select", required = "required" })
                                @Html.ValidationMessageFor(m => m.GioTiem, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-syringe me-1"></i>Vắc xin cần tiêm
                            </label>
                            @Html.DropDownListFor(m => m.MaVaccine, 
                                (SelectList)ViewBag.DanhSachVaccine, 
                                "-- Chọn vắc xin --", 
                                new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.MaVaccine, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-comment me-1"></i>Ghi chú
                            </label>
                            @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = "3", placeholder = "Ghi chú thêm (nếu có)..." })
                        </div>

                        <!-- Submit -->
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <small>Sau khi đặt lịch thành công, chúng tôi sẽ liên hệ xác nhận trong vòng 24h</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-fill">
                                <i class="fas fa-check me-2"></i>Xác nhận đặt lịch
                            </button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                                Hủy
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
