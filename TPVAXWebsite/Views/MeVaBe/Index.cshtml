@{
    ViewBag.Title = "Mẹ Và Bé - Kiến Thức Tiêm Chủng";
}

@section Styles {
<style>
.mvb-hero {
    /* Đã đồng bộ với trang Vắc xin */
    background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
    padding: 60px 0;
    color: white;
    text-align: center;
    margin-bottom: 40px;
}

.category-filter-btn {
    background: white;
    border: 2px solid #dee2e6;
    padding: 12px 25px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    margin: 5px;
}

.category-filter-btn:hover {
    border-color: #0077b6;
    transform: translateY(-2px);
    /* Đã sửa: Đổi đổ bóng từ Hồng sang Xanh dương đậm */
    box-shadow: 0 5px 15px rgba(0, 119, 182, 0.2); 
}

.category-filter-btn.active {
    /* Đã đồng bộ với trang Vắc xin */
    background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%); /* Thay #0077b6 100% bằng #00b4d8 để đồng bộ với hero */
    color: white;
    border-color: #0077b6;
}

.search-box-modern input {
    width: 100%;
    padding: 15px 20px;
    border: 2px solid #dee2e6;
    border-radius: 50px;
    font-size: 1rem;
}

.search-box-modern input:focus {
    outline: none;
    border-color: #0077b6;
    /* Đã sửa: Đổi đổ bóng từ Hồng sang Xanh dương đậm */
    box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.1);
}

.article-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.article-card:hover {
    transform: translateY(-10px);
    /* Đã sửa: Đổi đổ bóng từ Hồng sang Xanh dương sáng */
    box-shadow: 0 15px 40px rgba(0, 180, 216, 0.25); 
}

.article-image-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
}

.article-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.article-category-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    /* Đã sửa: Đổi màu nền từ Hồng sang Xanh dương đậm */
    background: rgba(0, 119, 182, 0.9); 
    color: white;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.article-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.article-title-medium {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 10px;
    line-height: 1.4;
}

.article-description {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 15px;
    flex: 1;
}

.article-link {
    color: #0077b6;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: auto;
}

.article-link:hover {
    /* Đã sửa: Đồng bộ hover với màu xanh dương sáng */
    color: #00b4d8; 
}

.article-meta-small {
    font-size: 0.85rem;
    color: #999;
}

.d-none {
    display: none !important;
}

/* Kiểu dáng cho Pagination */
.pagination .page-item .page-link {
    color: #0077b6;
    border-color: #0077b6;
}

.pagination .page-item.active .page-link {
    background-color: #0077b6;
    border-color: #0077b6;
    color: white;
}
</style>
}

<div class="mvb-hero">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">👶 MẸ VÀ BÉ</h1>
        <p class="lead">Cùng TPVAX tìm hiểu các thông tin hữu ích về sức khỏe, chăm sóc và tiêm chủng cho mẹ và bé</p>
    </div>
</div>

<main class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">🏠 Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#">📚 Kiến thức tiêm chủng</a></li>
            <li class="breadcrumb-item active" aria-current="page">👶 Mẹ và Bé</li>
        </ol>
    </nav>

    <div class="mb-5">
