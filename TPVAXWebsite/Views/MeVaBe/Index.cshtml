@model IEnumerable<TPVAXWebsite.Models.ViewModels.BaiVietViewModel>

@{
    ViewBag.Title = "Mẹ Và Bé - Kiến Thức Tiêm Chủng";
}

@functions {
    // Hàm nhóm tag (phân loại để lọc)
    public string GetTagGroup(string tag)
    {
        if (string.IsNullOrEmpty(tag)) return "article";

        var lower = tag.ToLower();
        if (lower.Contains("mang thai")) return "pregnancy";
        if (lower.Contains("sau sinh") || lower.Contains("nuôi con")) return "postpartum";
        return "article";
    }

    // Hàm ánh xạ tag -> hình ảnh
    public string GetTagImage(string tag)
    {
        if (string.IsNullOrEmpty(tag)) return "mvb9.png";

        var lower = tag.ToLower();
        if (lower.Contains("mang thai")) return "mvb1.png";
        if (lower.Contains("sau sinh") || lower.Contains("nuôi con")) return "mvb2.png";
        if (lower.Contains("thông tin")) return "mvb3.png";
        if (lower.Contains("me va be")) return "mvb4.png";
        if (lower.Contains("lịch tiêm")) return "mvb5.png";
        if (lower.Contains("phòng bệnh")) return "mvb7.png";
        if (lower.Contains("vaccine")) return "mvb3.png";
        return "mvb6.png";
    }
}

<!-- Hero banner -->
<div class="mvb-hero bg-light py-5 border-bottom">
    <div class="container text-center">
        <h1 class="display-5 fw-bold text-primary mb-3">👶 MẸ VÀ BÉ</h1>
        <p class="lead text-dark">Cùng TPVAX tìm hiểu các thông tin hữu ích về sức khỏe, chăm sóc và tiêm chủng cho mẹ và bé</p>
    </div>
</div>

<main class="container my-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">🏠 Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#">📚 Kiến thức tiêm chủng</a></li>
            <li class="breadcrumb-item active" aria-current="page">👶 Mẹ và Bé</li>
        </ol>
    </nav>

    <!-- Bộ lọc danh mục -->
    <div class="mb-5 text-center">
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <button class="category-filter-btn active" data-filter="all"><span>📚 Tất cả</span></button>
            <button class="category-filter-btn" data-filter="pregnancy"><span>🤰 Chuẩn bị mang thai</span></button>
            <button class="category-filter-btn" data-filter="postpartum"><span>👶 Sau sinh & Nuôi con</span></button>
            <button class="category-filter-btn" data-filter="article"><span>📝 Bài viết thông tin</span></button>
        </div>
    </div>

    <!-- Ô tìm kiếm -->
    <div class="mb-5">
        <div class="search-box-modern">
            <input type="text" id="articleSearchInput" class="form-control form-control-lg rounded-pill"
                   placeholder="🔍 Tìm kiếm bài viết về mẹ và bé..." />
        </div>
    </div>

    <!-- Thông báo không tìm thấy -->
    <div id="noResultsMessage" class="alert alert-info text-center d-none">
        <h5>🔍 Không tìm thấy bài viết phù hợp</h5>
        <p class="mb-0">Vui lòng thử lại với từ khóa khác hoặc chọn danh mục khác.</p>
    </div>

    <!-- Danh sách bài viết -->
    <div class="row g-4 article-container">
        @foreach (var article in Model)
        {
            var tagGroup = GetTagGroup(article.Tag);
            var tagImage = GetTagImage(article.Tag);

            <div class="col-lg-4 col-md-6 article-item" data-tags="@tagGroup" data-keywords="@article.Tag.ToLower()">
                <article class="article-card">
                    <div class="article-image-wrapper">
                            <!-- Ảnh chọn theo tag -->
                            <img src="@Url.Content("~/Content/Images/MeVaBe/" + tagImage)"
                                 class="img-fluid" alt="@article.TieuDe" />
                        <div class="article-category-badge">@article.DanhMuc</div>
                    </div>
                    <div class="article-body">
                        <div class="article-meta-small mb-2">
                            <span>📅 @article.NgayDang.ToString("dd/MM/yyyy")</span>
                        </div>
                        <h3 class="article-title-medium">@article.TieuDe</h3>
                        <p class="article-description">@article.TomTat</p>

                        @if (!string.IsNullOrEmpty(article.Tag))
                        {
                            var tags = article.Tag.Split(',').Select(t => t.Trim()).ToList();
                            <div class="article-tags mt-2">
                                @foreach (var tag in tags)
                                {
                                    <span class="tag-badge">@tag</span>
                                }
                            </div>
                        }

                        <a href="@Url.Action("ChiTiet", "MeVaBe", new { id = article.Id })" class="article-link">Xem chi tiết →</a>
                    </div>
                </article>
            </div>
        }
    </div>

    <!-- Phân trang -->
    <div class="d-flex justify-content-center mt-4">
        <nav><ul id="pagination" class="pagination"></ul></nav>
    </div>
</main>

@section Styles {
    <style>
        .article-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .tag-badge {
            background-color: #e0f7fa;
            color: #0077b6;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterBtns = document.querySelectorAll('.category-filter-btn');
            const articleItems = document.querySelectorAll('.article-item');
            const searchInput = document.getElementById('articleSearchInput');
            const noResultsMsg = document.getElementById('noResultsMessage');
            const pagination = document.getElementById('pagination');
            const itemsPerPage = 6;
            let currentPage = 1;

            function getVisibleArticles() {
                const activeFilter = document.querySelector('.category-filter-btn.active').dataset.filter;
                const searchTerm = searchInput.value.toLowerCase();

                return [...articleItems].filter(item => {
                    const tags = item.dataset.tags?.toLowerCase() || "";
                    const keywords = item.dataset.keywords?.toLowerCase() || "";
                    const text = item.textContent.toLowerCase();

                    const matchCategory = activeFilter === 'all' || tags.includes(activeFilter);
                    const matchSearch = searchTerm === '' || keywords.includes(searchTerm) || text.includes(searchTerm);

                    return matchCategory && matchSearch;
                });
            }

            function showPage() {
                const visibleItems = getVisibleArticles();
                const totalItems = visibleItems.length;
                const start = (currentPage - 1) * itemsPerPage;
                const end = start + itemsPerPage;

                articleItems.forEach(item => item.style.display = 'none');
                visibleItems.forEach((item, index) => {
                    if (index >= start && index < end) {
                        item.style.display = 'block';
                    }
                });

                renderPagination(totalItems);
                noResultsMsg.classList.toggle('d-none', visibleItems.length > 0);
            }

            function renderPagination(totalItems) {
                pagination.innerHTML = '';
                const totalPages = Math.ceil(totalItems / itemsPerPage);
                if (totalPages <= 1) return;

                for (let i = 1; i <= totalPages; i++) {
                    const li = document.createElement('li');
                    li.classList.add('page-item');
                    if (i === currentPage) li.classList.add('active');

                    const a = document.createElement('a');
                    a.classList.add('page-link');
                    a.href = '#';
                    a.innerText = i;
                    a.addEventListener('click', function (e) {
                        e.preventDefault();
                        currentPage = i;
                        showPage();
                    });

                    li.appendChild(a);
                    pagination.appendChild(li);
                }
            }

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    searchInput.value = '';
                    currentPage = 1;
                    showPage();
                });
            });

            searchInput.addEventListener('input', function () {
                currentPage = 1;
                showPage();
            });

            showPage(); // Khởi động lần đầu
        });
    </script>
}
