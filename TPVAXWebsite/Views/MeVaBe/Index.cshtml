@section Scripts {
<script>
// --- LOGIC PHÂN TRANG VÀ LỌC/TÌM KIẾM ---

document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.category-filter-btn');
    const articleItems = document.querySelectorAll('.article-item');
    const searchInput = document.getElementById('articleSearchInput');
    const noResultsMsg = document.getElementById('noResultsMessage');

    // Cài đặt Phân trang
    const itemsPerPage = 6; // số bài viết mỗi trang
    const pagination = document.getElementById('pagination');
    let currentPage = 1;

    // Lấy tất cả bài viết đang hiển thị (sau khi lọc/tìm kiếm)
    function getVisibleArticles() {
        // Lấy tất cả bài viết và lọc ra những bài không có style display="none"
        // Dựa vào logic lọc của filterArticles() bên dưới
        return [...document.querySelectorAll('.article-item')].filter(item => {
            const currentCategory = document.querySelector('.category-filter-btn.active').dataset.filter;
            const currentSearchTerm = searchInput.value.toLowerCase();

            const tags = item.dataset.tags;
            const keywords = item.dataset.keywords.toLowerCase();
            const text = item.textContent.toLowerCase();

            const matchCategory = currentCategory === 'all' || tags.includes(currentCategory);
            const matchSearch = currentSearchTerm === '' || keywords.includes(currentSearchTerm) || text.includes(currentSearchTerm);

            return matchCategory && matchSearch;
        });
    }

    // Hiển thị bài theo trang hiện tại
    function showPage() {
        const visibleItems = getVisibleArticles();
        const totalItems = visibleItems.length;

        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        // Chỉ hiển thị các bài viết trên trang hiện tại
        articleItems.forEach(item => {
            // Ẩn tất cả bài viết trước
            item.style.display = "none";
        });
        
        visibleItems.forEach((item, index) => {
            if (index >= start && index < end) {
                item.style.display = "block";
            }
        });

        renderPagination(totalItems);
    }

    // Tạo thanh pagination
    function renderPagination(totalItems) {
        pagination.innerHTML = "";
        const totalPages = Math.ceil(totalItems / itemsPerPage);

        if (totalPages <= 1) return;

        // Tạo nút trang
        for (let i = 1; i <= totalPages; i++) {
            let li = document.createElement("li");
            li.classList.add("page-item");
            if (i === currentPage) li.classList.add("active");

            let a = document.createElement("a");
            a.classList.add("page-link");
            a.href = "#";
            a.innerText = i;

            a.addEventListener("click", function (e) {
                e.preventDefault();
                currentPage = i;
                showPage(); // Cập nhật bài viết trên trang
            });

            li.appendChild(a);
            pagination.appendChild(li);
        }
    }
    // ---------------------------
    // LOGIC LỌC/TÌM KIẾM
    // ---------------------------
    
    // Gắn sự kiện cho nút lọc
    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.dataset.filter;
            searchInput.value = '';
            
            // Gọi hàm lọc mới để xử lý phân trang
            filterArticles(filter, '');
        });
    });

    // Gắn sự kiện cho ô tìm kiếm
    searchInput.addEventListener('input', function() {
        const activeFilter = document.querySelector('.category-filter-btn.active').dataset.filter;
        
        // Gọi hàm lọc mới để xử lý phân trang
        filterArticles(activeFilter, this.value.toLowerCase());
    });

    // Hàm lọc chính, được CẬP NHẬT để tích hợp Phân trang
    window.filterArticles = function (category, searchTerm) {
        let visibleCount = 0;

        articleItems.forEach(item => {
            const tags = item.dataset.tags;
            const keywords = item.dataset.keywords.toLowerCase();
            const text = item.textContent.toLowerCase();

            const matchCategory = category === 'all' || tags.includes(category);
            const matchSearch = searchTerm === '' || keywords.includes(searchTerm) || text.includes(searchTerm);

            // Ghi đè style.display để ẩn những bài KHÔNG khớp với tiêu chí lọc/tìm kiếm
            // Sau đó showPage() sẽ chịu trách nhiệm ẩn/hiện các bài viết theo trang.
            if (matchCategory && matchSearch) {
                // Đặt style.display về 'initial' hoặc 'block' trước khi showPage() chạy
                // Tuy nhiên, việc tính toán `getVisibleArticles` sẽ dựa trên logic này.
                // Để đơn giản, ta sẽ chỉ ẩn những cái không khớp.
                item.style.display = 'block'; // Tạm thời để nó tính là "có thể nhìn thấy"
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        if (visibleCount === 0) {
            noResultsMsg.classList.remove('d-none');
        } else {
            noResultsMsg.classList.add('d-none');
        }

        // --- BƯỚC TÍCH HỢP PHÂN TRANG ---
        currentPage = 1; // reset về trang 1 khi lọc/tìm
        showPage(); // áp dụng phân trang cho các bài viết đã được lọc
    }
    
    // Lần đầu load trang
    // Vì hàm filterArticles đã bị ghi đè, ta cần đảm bảo nó chạy để hiển thị trang 1
    const initialFilter = document.querySelector('.category-filter-btn.active').dataset.filter;
    window.filterArticles(initialFilter, '');

});
</script>
}