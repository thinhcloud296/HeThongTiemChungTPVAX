@{
    ViewBag.Title = "Kết quả thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            @if (ViewBag.IsSuccess == true)
            {
                <!-- THANH TOÁN THÀNH CÔNG -->
                <div class="card border-success shadow">
                    <div class="card-header bg-success text-white text-center py-4">
                        <i class="fas fa-check-circle fa-4x mb-3"></i>
                        <h2 class="mb-0">@ViewBag.Message</h2>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <td class="text-muted">Mã giao dịch VNPAY:</td>
                                        <td class="text-end fw-bold">@ViewBag.TransactionId</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Mã đơn hàng:</td>
                                        <td class="text-end fw-bold">@ViewBag.OrderId</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Số tiền:</td>
                                        <td class="text-end fw-bold text-success">@ViewBag.Amount</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Nội dung:</td>
                                        <td class="text-end">@ViewBag.OrderInfo</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Ngân hàng:</td>
                                        <td class="text-end">@ViewBag.BankCode</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Thời gian:</td>
                                        <td class="text-end">@ViewBag.PayDate</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <hr />
                        <div class="text-center">
                            <p class="text-muted mb-3">Cảm ơn bạn đã sử dụng dịch vụ của TPVAX!</p>
                            <a href="@Url.Action("Index", "HoaDon")" class="btn btn-success me-2">
                                <i class="fas fa-file-invoice me-1"></i> Xem hóa đơn
                            </a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="fas fa-home me-1"></i> Về trang chủ
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- THANH TOÁN THẤT BẠI -->
                <div class="card border-danger shadow">
                    <div class="card-header bg-danger text-white text-center py-4">
                        <i class="fas fa-times-circle fa-4x mb-3"></i>
                        <h2 class="mb-0">@ViewBag.Message</h2>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(ViewBag.ErrorCode))
                        {
                            <div class="alert alert-danger">
                                <strong>Mã lỗi:</strong> @ViewBag.ErrorCode<br />
                                <strong>Chi tiết:</strong> @ViewBag.ErrorMessage
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                        {
                            <div class="alert alert-danger">
                                @ViewBag.ErrorMessage
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ViewBag.OrderId))
                        {
                            <p class="text-muted">
                                <strong>Mã đơn hàng:</strong> @ViewBag.OrderId
                            </p>
                        }

                        <hr />
                        <div class="text-center">
                            <p class="text-muted mb-3">Vui lòng thử lại hoặc liên hệ hỗ trợ nếu cần.</p>
                            <a href="@Url.Action("Checkout", "HoaDon")" class="btn btn-danger me-2">
                                <i class="fas fa-redo me-1"></i> Thử lại
                            </a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="fas fa-home me-1"></i> Về trang chủ
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }
    .card-header i {
        display: block;
    }
    .table td {
        padding: 0.75rem 0;
    }
</style>
