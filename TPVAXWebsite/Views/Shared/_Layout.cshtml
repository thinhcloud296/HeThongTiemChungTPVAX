<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TPVAX - Hệ thống tiêm chủng vaccine chất lượng hàng đầu Việt Nam" />
    <meta name="keywords" content="tiêm chủng, vaccine, vắc xin, tiêm phòng, TPVAX" />
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/Assets/Images/logo.png")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/main_style.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/layout_page_style.css")" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <title>@ViewBag.Title - TPVAX</title>
</head>
<body>
    <a href="#main-content" class="visually-hidden-focusable">Chuyển đến nội dung chính</a>
    
    <!-- Scroll to Top Button -->
    <button id="scrollToTopBtn" class="scroll-to-top-btn" aria-label="Cuộn lên đầu trang">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5z" />
        </svg>
    </button>
    
    <!-- Floating Contact Buttons -->
    <div class="floating-contact">
        <a href="https://zalo.me/0975088626" target="_blank" class="floating-btn floating-btn-zalo" aria-label="Chat Zalo">
            <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 48 48" fill="white">
                <path d="M24 4C13.52 4 5 11.37 5 20.5c0 5.42 3.17 10.23 8 13.33v9.17l8.54-4.55c.78.11 1.59.16 2.42.16 10.48 0 19-7.37 19-16.5S34.48 4 24 4zm-4.5 22.5l-5.5-5.88 10.76-5.74-5 6.26 5.5 5.88L14.5 21.28l5-6.26z" />
            </svg>
        </a>
        <a href="tel:0975088626" class="floating-btn floating-btn-phone" aria-label="Gọi điện">
            <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 16 16" fill="white">
                <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z" />
            </svg>
        </a>
    </div>
    
    @Html.Partial("_Header")
    
    <main class="main" id="main-content" role="main">
        @RenderBody()
    </main>
    
    @Html.Partial("_Footer")
    
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    <script>
        const scrollToTopBtn = document.getElementById("scrollToTopBtn");
        window.addEventListener("scroll", function () {
            scrollToTopBtn.classList.toggle("show", window.pageYOffset > 300);
        });
        scrollToTopBtn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
