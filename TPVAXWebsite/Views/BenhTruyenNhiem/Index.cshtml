@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.disease-filter-btn');
    const articleItems = document.querySelectorAll('.article-item');
    const searchInput = document.getElementById('diseaseSearchInput');
    const noResultsMsg = document.getElementById('noResultsMessage');

    // Cài đặt Phân trang
    const itemsPerPage = 6; // số bài viết mỗi trang
    const pagination = document.getElementById('pagination');
    let currentPage = 1;

    // Lấy tất cả bài viết đang hiển thị (sau khi lọc/tìm kiếm)
    function getVisibleArticles() {
        // Lọc các bài viết dựa trên tiêu chí lọc và tìm kiếm hiện tại
        return [...document.querySelectorAll('.article-item')].filter(item => {
            const activeFilterButton = document.querySelector('.disease-filter-btn.active');
            const currentCategory = activeFilterButton ? activeFilterButton.dataset.filter : 'all';
            const currentSearchTerm = searchInput.value.toLowerCase();

            const tags = item.dataset.tags;
            const keywords = item.dataset.keywords.toLowerCase();
            const text = item.textContent.toLowerCase();

            const matchCategory = currentCategory === 'all' || tags.includes(currentCategory);
            const matchSearch = currentSearchTerm === '' || keywords.includes(currentSearchTerm) || text.includes(currentSearchTerm);

            return matchCategory && matchSearch;
        });
    }

    // Hiển thị bài theo trang hiện tại
    function showPage() {
        const visibleItems = getVisibleArticles();
        const totalItems = visibleItems.length;

        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        // Ẩn tất cả bài viết
        articleItems.forEach(item => {
            item.style.display = "none";
        });
        
        // Chỉ hiển thị các bài viết trên trang hiện tại
        visibleItems.forEach((item, index) => {
            if (index >= start && index < end) {
                item.style.display = "block";
            }
        });

        renderPagination(totalItems);
        
        // Cập nhật thông báo kết quả (nếu visibleItems là 0)
        if (totalItems === 0) {
            noResultsMsg.classList.remove('d-none');
        } else {
            noResultsMsg.classList.add('d-none');
        }
    }

    // Tạo thanh pagination
    function renderPagination(totalItems) {
        pagination.innerHTML = "";
        const totalPages = Math.ceil(totalItems / itemsPerPage);

        if (totalPages <= 1) return;

        // Tạo nút trang
        for (let i = 1; i <= totalPages; i++) {
            let li = document.createElement("li");
            li.classList.add("page-item");
            if (i === currentPage) li.classList.add("active");

            let a = document.createElement("a");
            a.classList.add("page-link");
            a.href = "#";
            a.innerText = i;

            a.addEventListener("click", function (e) {
                e.preventDefault();
                currentPage = i;
                window.scrollTo(0, 0); // Cuộn lên đầu trang (tùy chọn)
                showPage(); // Cập nhật bài viết trên trang
            });

            li.appendChild(a);
            pagination.appendChild(li);
        }
    }

    // ---------------------------
    // LOGIC LỌC/TÌM KIẾM (Đã tích hợp Phân trang)
    // ---------------------------

    // Hàm lọc/tìm kiếm được sử dụng trong sự kiện và được gọi lần đầu
    function filterArticles(category, searchTerm) {
        currentPage = 1; 
        showPage();
    }
    
    // Gắn sự kiện cho nút lọc
    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.dataset.filter;
            searchInput.value = '';
            
            filterArticles(filter, '');
        });
    });

    // Gắn sự kiện cho ô tìm kiếm
    searchInput.addEventListener('input', function() {
        const activeFilter = document.querySelector('.disease-filter-btn.active').dataset.filter;
        filterArticles(activeFilter, this.value.toLowerCase());
    });

    // Lần đầu load trang
    const initialFilter = document.querySelector('.disease-filter-btn.active').dataset.filter;
    filterArticles(initialFilter, ''); 
});
</script>
}