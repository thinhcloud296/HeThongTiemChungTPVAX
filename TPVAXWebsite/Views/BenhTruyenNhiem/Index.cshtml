@model IEnumerable<TPVAXWebsite.Models.Domain.LoaiBenh>
@{
    ViewBag.Title = "Bệnh Truyền Nhiễm";
}

<!-- Page Header -->
      <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-primary mb-3">
          🦠 BỆNH TRUYỀN NHIỄM
        </h2>
        <p class="lead text-muted">
          Tìm hiểu thông tin chi tiết về các bệnh truyền nhiễm phổ biến, triệu
          chứng nhận biết, cách phòng ngừa và vaccine bảo vệ. Thông tin khoa học
          từ chuyên gia TPVAX.
        </p>
      </div>

      <!-- Filter Bar -->
      <section class="mb-5">
        <div class="disease-filter-bar">
          <button class="disease-filter-btn active" data-filter="all">
            <i class="fas fa-th-large me-2"></i>
            <span>Tất cả</span>
          </button>
          <button class="disease-filter-btn" data-filter="article">
            <i class="fas fa-file-alt me-2"></i>
            <span>Bài viết</span>
          </button>
          <button class="disease-filter-btn" data-filter="az">
            <i class="fas fa-book-medical me-2"></i>
            <span>Bệnh A-Z</span>
          </button>
          <button class="disease-filter-btn" data-filter="virus">
            <i class="fas fa-viruses me-2"></i>
            <span>Do Virus</span>
          </button>
          <button class="disease-filter-btn" data-filter="bacteria">
            <i class="fas fa-bacterium me-2"></i>
            <span>Do Vi khuẩn</span>
          </button>
          <button class="disease-filter-btn" data-filter="quiz">
            <i class="fas fa-question-circle me-2"></i>
            <span>Quiz</span>
          </button>
        </div>
      </section>

      <!-- Search Box -->
      <section class="mb-5">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="search-box-modern position-relative">
              <input
                type="text"
                class="form-control form-control-lg rounded-pill"
                placeholder="🔍 Tìm kiếm bệnh truyền nhiễm (VD: Sốt xuất huyết, Thủy đậu, Viêm gan...)"
                id="diseaseSearchInput"
                autocomplete="off"
              />
            </div>
            <div
              id="searchResultCount"
              class="text-center mt-3"
              style="font-size: 14px; color: #6c757d"
            ></div>
          </div>
        </div>
      </section>

      <!-- No Results Message -->
      <section id="noResultsMessage" style="display: none">
        <div
          class="alert alert-warning text-center py-5 mx-auto"
          style="max-width: 600px"
        >
          <h3 class="mb-3">🔍 Không tìm thấy bài viết nào</h3>
          <p class="mb-3">
            Vui lòng thử tìm kiếm với từ khóa khác hoặc chọn danh mục khác.
          </p>
          <button
            class="btn btn-primary"
            onclick="document.getElementById('diseaseSearchInput').value=''; document.getElementById('diseaseSearchInput').focus();"
          >
            Xóa tìm kiếm
          </button>
        </div>
      </section>

      <!-- Article Grid -->
      <section class="article-grid">
        <div class="row g-4 article-container">
          <!-- Article 1 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="article virus"
            data-keywords="thủy đậu nốt trắng điều trị"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Nốt thủy đậu trắng"
                  loading="lazy"
                />
                <div class="article-category-badge">📝 Bài viết</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 28/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 1.8K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Nốt thủy đậu màu trắng đục là hiện tượng gì? Cách điều trị
                  đúng
                </h3>
                <p class="article-description">
                  Tìm hiểu về hiện tượng nốt thủy đậu chuyển màu trắng đục,
                  nguyên nhân và cách xử lý phù hợp...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=not-thuy-dau-trang"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>

          <!-- Article 2 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="article virus"
            data-keywords="sữa rửa mặt thủy đậu chăm sóc da"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Sữa rửa mặt thủy đậu"
                  loading="lazy"
                />
                <div class="article-category-badge">💧 Chăm sóc</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 27/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 1.5K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Những người bị thủy đậu có dùng sữa rửa mặt được không?
                </h3>
                <p class="article-description">
                  Hướng dẫn cách chăm sóc da mặt khi bị thủy đậu, sản phẩm nên
                  và không nên sử dụng...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=sua-rua-mat-thuy-dau"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>

          <!-- Article 3 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="az virus"
            data-keywords="sốt zika virus muỗi"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Sốt Zika"
                  loading="lazy"
                />
                <div class="article-category-badge az-badge">📖 Bệnh A-Z</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 26/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 2.3K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Sốt Zika là gì? Những vấn đề cần biết về sốt Zika
                </h3>
                <p class="article-description">
                  Thông tin đầy đủ về bệnh sốt Zika, cách lây truyền, triệu
                  chứng và biện pháp phòng ngừa...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=sot-zika-can-biet"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>

          <!-- Article 4 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="az virus"
            data-keywords="chikungunya virus muỗi sốt khớp"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Chikungunya"
                  loading="lazy"
                />
                <div class="article-category-badge az-badge">📖 Bệnh A-Z</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 25/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 1.9K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Bệnh Chikungunya là gì? Những vấn đề cần biết về bệnh
                  Chikungunya
                </h3>
                <p class="article-description">
                  Tìm hiểu về bệnh Chikungunya do virus, triệu chứng đau khớp
                  đặc trưng và cách điều trị...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=benh-chikungunya"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>

          <!-- Article 5 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="article virus"
            data-keywords="rubella phát ban giai đoạn"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Bệnh Rubella"
                  loading="lazy"
                />
                <div class="article-category-badge">🔬 Nghiên cứu</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 24/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 2.1K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Tìm hiểu về 3 giai đoạn phát triển của bệnh Rubella
                </h3>
                <p class="article-description">
                  Phân tích chi tiết 3 giai đoạn của bệnh Rubella (Rubivirus),
                  triệu chứng từng giai đoạn...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=3-giai-doan-rubella"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>

          <!-- Article 6 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="az bacteria"
            data-keywords="bệnh than vi khuẩn anthrax"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Bệnh than"
                  loading="lazy"
                />
                <div class="article-category-badge az-badge">📖 Bệnh A-Z</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 23/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 1.7K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Bệnh than là gì? Những vấn đề cần biết về bệnh than
                </h3>
                <p class="article-description">
                  Thông tin về bệnh than (Anthrax) do vi khuẩn, đường lây nhiễm
                  và biện pháp phòng ngừa...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=benh-than"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>

          <!-- Quiz 1 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="quiz bacteria"
            data-keywords="quiz lao kiểm tra kiến thức"
          >
            <article class="article-card quiz-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Quiz Lao"
                  loading="lazy"
                />
                <div class="article-category-badge quiz-badge">❓ Quiz</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="badge bg-warning text-dark">7 câu hỏi</span>
                  <span class="text-muted ms-2"
                    ><i class="bi bi-trophy"></i> Trung bình</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Bạn có chắc mình đã biết hết về các thể loại của bệnh lao?
                </h3>
                <p class="article-description">
                  Kiểm tra kiến thức của bạn về bệnh lao qua 7 câu hỏi thú vị.
                  Thử thách ngay!
                </p>
                <a href="quiz.html?id=lao" class="article-link"> Làm Quiz → </a>
              </div>
            </article>
          </div>

          <!-- Quiz 2 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="quiz virus"
            data-keywords="quiz sốt xuất huyết muỗi dengue"
          >
            <article class="article-card quiz-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Quiz SXH"
                  loading="lazy"
                />
                <div class="article-category-badge quiz-badge">❓ Quiz</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="badge bg-warning text-dark">7 câu hỏi</span>
                  <span class="text-muted ms-2"
                    ><i class="bi bi-trophy"></i> Dễ</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Bạn có nhầm lẫn muỗi thường với muỗi truyền bệnh Sốt xuất
                  huyết?
                </h3>
                <p class="article-description">
                  Phân biệt muỗi Aedes aegypti gây sốt xuất huyết với muỗi
                  thường. Kiểm tra ngay!
                </p>
                <a href="quiz.html?id=sxh" class="article-link"> Làm Quiz → </a>
              </div>
            </article>
          </div>

          <!-- Article 7 -->
          <div
            class="col-lg-4 col-md-6 article-item"
            data-tags="article virus"
            data-keywords="cúm phòng ngừa vaccine"
          >
            <article class="article-card">
              <div class="article-image-wrapper">
                <img
                  src="@Url.Content("~/Content/Assets/Images/hexaxim.png")"
                  class="img-fluid"
                  alt="Cúm mùa"
                  loading="lazy"
                />
                <div class="article-category-badge">💉 Phòng ngừa</div>
              </div>
              <div class="article-body">
                <div class="article-meta-small mb-2">
                  <span class="text-muted"
                    ><i class="bi bi-calendar"></i> 22/10/2025</span
                  >
                  <span class="text-muted ms-3"
                    ><i class="bi bi-eye"></i> 3.2K lượt xem</span
                  >
                </div>
                <h3 class="article-title-medium mb-2">
                  Vaccine cúm: Tại sao cần tiêm mỗi năm và thời điểm phù hợp?
                </h3>
                <p class="article-description">
                  Giải đáp về vaccine cúm mùa, lý do cần tiêm hàng năm và thời
                  điểm tốt nhất để tiêm...
                </p>
                <a
                  href="bai-viet-chi-tiet.html?slug=vaccine-cum"
                  class="article-link"
                >
                  Xem chi tiết →
                </a>
              </div>
            </article>
          </div>
        </div>

        <!-- Pagination -->
        <nav aria-label="Phân trang bài viết" class="mt-5">
          <ul class="pagination justify-content-center">
            <li class="page-item disabled">
              <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                <i class="fas fa-chevron-left"></i>
              </a>
            </li>
            <li class="page-item active" aria-current="page">
              <a class="page-link" href="#">1</a>
            </li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">4</a></li>
            <li class="page-item"><a class="page-link" href="#">5</a></li>
            <li class="page-item">
              <a class="page-link" href="#">
                <i class="fas fa-chevron-right"></i>
              </a>
            </li>
          </ul>
        </nav>
      </section>
    </main>
    <!-- END Main Content -->
