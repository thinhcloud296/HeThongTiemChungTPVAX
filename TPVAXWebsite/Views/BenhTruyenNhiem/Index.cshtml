@{
    ViewBag.Title = "Bệnh Truyền Nhiễm";
}

@section Styles {
<style>
.btn-hero {
    /* Đã sửa: Thay thế gradient đỏ/cam bằng gradient xanh dương */
    background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
    padding: 60px 0;
    color: white;
    text-align: center;
    margin-bottom: 40px;
}

.disease-filter-btn {
    background: white;
    border: 2px solid #dee2e6;
    padding: 12px 25px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    margin: 5px;
}

.disease-filter-btn:hover {
    /* Đã sửa: Đổi màu viền và đổ bóng sang xanh dương đậm */
    border-color: #0077b6; /* Xanh dương đậm */
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 119, 182, 0.2); /* Sử dụng #0077b6 với độ mờ */
}

.disease-filter-btn.active {
    /* Đã sửa: Đổi màu nền gradient và viền sang xanh dương */
    background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%);
    color: white;
    border-color: #0077b6; /* Xanh dương đậm */
}

.search-box-modern input {
    width: 100%;
    padding: 15px 20px;
    border: 2px solid #dee2e6;
    border-radius: 50px;
    font-size: 1rem;
}

.search-box-modern input:focus {
    outline: none;
    /* Đã sửa: Đổi màu viền và đổ bóng sang xanh dương đậm */
    border-color: #0077b6; /* Xanh dương đậm */
    box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.1); /* Sử dụng #0077b6 với độ mờ */
}

.article-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
    height: 100%;
}

.article-card:hover {
    transform: translateY(-10px);
    /* Đã sửa: Đổi màu đổ bóng sang xanh dương sáng */
    box-shadow: 0 15px 40px rgba(0, 180, 216, 0.25); /* Sử dụng #00b4d8 với độ mờ */
}

.article-image-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
}

.article-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.article-category-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    /* Đã sửa: Đổi màu nền sang xanh dương đậm */
    background: rgba(0, 119, 182, 0.9); /* Sử dụng #0077b6 với độ mờ */
    color: white;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.article-body {
    padding: 20px;
}

.article-title-medium {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 10px;
}

.article-description {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 15px;
}

.article-link {
    /* Đã sửa: Đổi màu chữ sang xanh dương đậm */
    color: #0077b6; /* Xanh dương đậm */
    text-decoration: none;
    font-weight: 600;
}

.article-link:hover {
    /* Đã sửa: Đổi màu chữ hover sang xanh dương sáng */
    color: #00b4d8; /* Xanh dương sáng */
}

.d-none {
    display: none !important;
}

/* Kiểu dáng cho Pagination */
.pagination .page-item .page-link {
    /* Đã sửa: Đổi màu chữ và viền sang xanh dương đậm */
    color: #0077b6; /* Xanh dương đậm */
    border-color: #0077b6; /* Xanh dương đậm */
}

.pagination .page-item.active .page-link {
    /* Đã sửa: Đổi màu nền và viền sang xanh dương đậm */
    background-color: #0077b6; /* Xanh dương đậm */
    border-color: #0077b6; /* Xanh dương đậm */
    color: white;
}
</style>
}

<div class="btn-hero">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">🦠 BỆNH TRUYỀN NHIỄM</h1>
        <p class="lead">Tìm hiểu thông tin chi tiết về các bệnh truyền nhiễm phổ biến và vaccine bảo vệ</p>
    </div>
</div>

<div class="container my-5">
    <div class="mb-5 text-center">
        <button class="disease-filter-btn active" data-filter="all">
            <i class="fas fa-th-large"></i> <span>Tất cả</span>
        </button>
        <button class="disease-filter-btn" data-filter="article">
            <i class="fas fa-file-alt"></i> <span>Bài viết</span>
        </button>
        <button class="disease-filter-btn" data-filter="virus">
            <i class="fas fa-viruses"></i> <span>Do Virus</span>
        </button>
        <button class="disease-filter-btn" data-filter="bacteria">
            <i class="fas fa-bacterium"></i> <span>Do Vi khuẩn</span>
        </button>
