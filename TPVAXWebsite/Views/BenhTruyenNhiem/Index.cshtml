@{
    ViewBag.Title = "Bệnh Truyền Nhiễm";
}

@section Styles {
<style>
.btn-hero {
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    padding: 60px 0;
    color: white;
    text-align: center;
    margin-bottom: 40px;
}

.disease-filter-btn {
    background: white;
    border: 2px solid #dee2e6;
    padding: 12px 25px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    margin: 5px;
}

.disease-filter-btn:hover {
    border-color: #e74c3c;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(231, 76, 60, 0.2);
}

.disease-filter-btn.active {
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    color: white;
    border-color: #e74c3c;
}

.search-box-modern input {
    width: 100%;
    padding: 15px 20px;
    border: 2px solid #dee2e6;
    border-radius: 50px;
    font-size: 1rem;
}

.search-box-modern input:focus {
    outline: none;
    border-color: #e74c3c;
    box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.1);
}

.article-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
    height: 100%;
}

.article-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(231, 76, 60, 0.25);
}

.article-image-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
}

.article-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.article-category-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: rgba(231, 76, 60, 0.9);
    color: white;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.article-body {
    padding: 20px;
}

.article-title-medium {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 10px;
}

.article-description {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 15px;
}

.article-link {
    color: #e74c3c;
    text-decoration: none;
    font-weight: 600;
}

.article-link:hover {
    color: #c0392b;
}

.d-none {
    display: none !important;
}
</style>
}

<div class="btn-hero">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">🦠 BỆNH TRUYỀN NHIỄM</h1>
        <p class="lead">Tìm hiểu thông tin chi tiết về các bệnh truyền nhiễm phổ biến và vaccine bảo vệ</p>
    </div>
</div>

<div class="container my-5">
    <div class="mb-5 text-center">
        <button class="disease-filter-btn active" data-filter="all">
            <i class="fas fa-th-large"></i> <span>Tất cả</span>
        </button>
        <button class="disease-filter-btn" data-filter="article">
            <i class="fas fa-file-alt"></i> <span>Bài viết</span>
        </button>
        <button class="disease-filter-btn" data-filter="virus">
            <i class="fas fa-viruses"></i> <span>Do Virus</span>
        </button>
        <button class="disease-filter-btn" data-filter="bacteria">
            <i class="fas fa-bacterium"></i> <span>Do Vi khuẩn</span>
        </button>
    </div>

    <div class="mb-5">
        <div class="search-box-modern">
            <input 
                type="text" 
                id="diseaseSearchInput"
                class="form-control form-control-lg rounded-pill" 
                placeholder="🔍 Tìm kiếm bệnh truyền nhiễm (VD: Sốt xuất huyết, Thủy đậu...)"
            />
        </div>
    </div>

    <div id="noResultsMessage" class="alert alert-warning text-center d-none">
        <h3>🔍 Không tìm thấy bài viết nào</h3>
        <p>Vui lòng thử tìm kiếm với từ khóa khác hoặc chọn danh mục khác.</p>
    </div>

    <div class="row g-4 article-container">
        <!-- 11 bài viết với ảnh btn1-btn11 -->
        <div class="col-lg-4 col-md-6 article-item" data-tags="article virus" data-keywords="thủy đậu nốt trắng điều trị vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn1.png")" alt="Thủy đậu" />
                    <div class="article-category-badge">🦠 Virus</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Bệnh thủy đậu - Triệu chứng và cách phòng ngừa</h3>
                    <p class="article-description">Thủy đậu là bệnh truyền nhiễm do virus varicella-zoster gây ra, dễ lây lan...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="virus" data-keywords="sốt xuất huyết dengue muỗi vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn2.png")" alt="Sốt xuất huyết" />
                    <div class="article-category-badge">🦟 Muỗi</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Sốt xuất huyết Dengue - Nguy hiểm và cách phòng tránh</h3>
                    <p class="article-description">Sốt xuất huyết do muỗi Aedes truyền, có thể gây biến chứng nguy hiểm...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="bacteria" data-keywords="viêm màng não não mô cầu vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn3.png")" alt="Viêm màng não" />
                    <div class="article-category-badge">⚠️ Vi khuẩn</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Viêm màng não do não mô cầu - Bệnh cấp cứu</h3>
                    <p class="article-description">Viêm màng não cực kỳ nguy hiểm, có thể tử vong trong 24-48 giờ nếu không điều trị...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="virus" data-keywords="cúm influenza vaccine phòng bệnh">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn4.png")" alt="Cúm mùa" />
                    <div class="article-category-badge">🤧 Cúm</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Cúm mùa (Influenza) - Không chỉ là cảm lạnh thông thường</h3>
                    <p class="article-description">Cúm có thể gây biến chứng nghiêm trọng ở trẻ nhỏ, người già...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="virus" data-keywords="HPV ung thư vaccine gardasil">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn5.png")" alt="Virus HPV" />
                    <div class="article-category-badge">🎗️ HPV</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Virus HPV - Nguyên nhân gây ung thư cổ tử cung</h3>
                    <p class="article-description">HPV là virus phổ biến, gây ung thư cổ tử cung, hầu họng...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="virus" data-keywords="viêm gan B virus vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn6.png")" alt="Viêm gan B" />
                    <div class="article-category-badge">🫀 Gan</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Viêm gan B - Bệnh lây truyền qua đường máu</h3>
                    <p class="article-description">Viêm gan B gây xơ gan, ung thư gan nếu không điều trị...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="bacteria" data-keywords="bạch hầu hô hấp vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn7.png")" alt="Bạch hầu" />
                    <div class="article-category-badge">🦠 Vi khuẩn</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Bạch hầu - Bệnh nguy hiểm đường hô hấp</h3>
                    <p class="article-description">Bạch hầu gây màng giả ở họng, có thể gây tắc nghẽn đường thở...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="bacteria" data-keywords="ho gà pertussis trẻ em vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn8.png")" alt="Ho gà" />
                    <div class="article-category-badge">😷 Ho gà</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Ho gà (Pertussis) - Nguy hiểm với trẻ nhỏ</h3>
                    <p class="article-description">Ho gà gây ho dữ dội, trẻ sơ sinh có thể tử vong do ngạt thở...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="virus" data-keywords="sởi rubella vaccine mmr">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn9.png")" alt="Sởi" />
                    <div class="article-category-badge">🔴 Sởi</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Bệnh sởi - Dễ lây lan và có biến chứng nặng</h3>
                    <p class="article-description">Sởi lây rất nhanh, gây viêm phổi, viêm não nguy hiểm...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="bacteria" data-keywords="phế cầu viêm phổi vaccine">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn10.png")" alt="Phế cầu khuẩn" />
                    <div class="article-category-badge">🫁 Phế cầu</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">Nhiễm khuẩn phế cầu - Nguyên nhân viêm phổi</h3>
                    <p class="article-description">Phế cầu gây viêm phổi, viêm màng não, nhiễm trùng huyết...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6 article-item" data-tags="virus" data-keywords="covid19 coronavirus vaccine pfizer">
            <article class="article-card">
                <div class="article-image-wrapper">
                    <img src="@Url.Content("~/Content/Images/BenhTruyenNhiem/btn11.png")" alt="COVID-19" />
                    <div class="article-category-badge">😷 COVID-19</div>
                </div>
                <div class="article-body">
                    <h3 class="article-title-medium">COVID-19 - Đại dịch thế kỷ và vaccine phòng bệnh</h3>
                    <p class="article-description">COVID-19 do SARS-CoV-2, lây qua đường hô hấp với nhiều biến chủng...</p>
                    <a href="#" class="article-link">Xem chi tiết →</a>
                </div>
            </article>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.disease-filter-btn');
    const articleItems = document.querySelectorAll('.article-item');
    const searchInput = document.getElementById('diseaseSearchInput');
    const noResultsMsg = document.getElementById('noResultsMessage');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.dataset.filter;
            searchInput.value = '';
            filterArticles(filter, '');
        });
    });

    searchInput.addEventListener('input', function() {
        const activeFilter = document.querySelector('.disease-filter-btn.active').dataset.filter;
        filterArticles(activeFilter, this.value.toLowerCase());
    });

    function filterArticles(category, searchTerm) {
        let visibleCount = 0;

        articleItems.forEach(item => {
            const tags = item.dataset.tags;
            const keywords = item.dataset.keywords.toLowerCase();
            const text = item.textContent.toLowerCase();

            const matchCategory = category === 'all' || tags.includes(category);
            const matchSearch = searchTerm === '' || keywords.includes(searchTerm) || text.includes(searchTerm);

            if (matchCategory && matchSearch) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        if (visibleCount === 0) {
            noResultsMsg.classList.remove('d-none');
        } else {
            noResultsMsg.classList.add('d-none');
        }
    }
});
</script>
}
