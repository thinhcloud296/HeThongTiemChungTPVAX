                'hexaxim': 'VC00000002',
                'infanrix': 'VC00000001',
                'rotateq': 'VC00000003',
                'rotarix': 'VC00000004',
                'prevenar': 'VC00000007',
                'bcg': 'VC00000008'
            };
            
            // Convert to proper format if needed
            var actualId = idMap[productId.toLowerCase()] || productId;
            
            $.ajax({
                url: '@Url.Action("ThemVaoGio", "GioHang")',
                type: 'POST',
                data: { 
                    MaSanPham: actualId, 
                    LoaiSanPham: 'VACCINE', 
                    SoLuong: 1 
                },
                success: function (data) {
                    if (data.success) {
                        // Cập nhật số lượng giỏ hàng trên header
                        $('.cart-count').text(data.cartCount);
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: data.message,
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire('Lỗi', data.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Lỗi', 'Vui lòng đăng nhập để thêm vào giỏ hàng', 'error');
                }
            });
        }

        $(document).ready(function() {
            // Seasonal tabs
            $('.seasonal-filter-item').click(function() {
                $('.seasonal-filter-item').removeClass('active');
                $(this).addClass('active');
                var diseaseId = $(this).data('disease');
                $('.disease-info-section').hide();
                $('#disease-' + diseaseId).fadeIn();
            });

            // Package filters
            $('.package-filter').change(function() {
                var target = $('input[name="target"]:checked').val();
                var priceRange = $('input[name="price"]:checked').val();
                
                $('.package-card').each(function() {
                    var cardTarget = $(this).data('target');
                    var cardPrice = parseFloat($(this).data('price'));
                    
                    var showTarget = (target === 'all' || cardTarget === target);
                    var showPrice = true;
                    
                    if (priceRange !== 'all') {
                        var parts = priceRange.split('-');
                        var min = parseFloat(parts[0]);
                        var max = parseFloat(parts[1]);
                        showPrice = (cardPrice >= min && cardPrice < max);
                    }
                    
                    if (showTarget && showPrice) {
                        $(this).fadeIn();
                    } else {
                        $(this).hide();
                    }
                });
            });
        });
    </script>
}